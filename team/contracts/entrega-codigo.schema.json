{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "entrega entrega-codigo (stuart)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "kind",
  "card",
  "role",
  "summary",
  "pr",
  "head",
  "branch",
  "acceptance",
  "tests",
  "files",
  "dod"
 ],
 "properties": {
  "kind": {
   "type": "string",
   "const": "entrega-codigo"
  },
  "card": {
   "type": "integer",
   "minimum": 1
  },
  "role": {
   "type": "string",
   "const": "stuart"
  },
  "summary": {
   "type": "string",
   "minLength": 10
  },
  "pr": {
   "type": "integer",
   "minimum": 1
  },
  "head": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$"
  },
  "branch": {
   "type": "string",
   "pattern": "^[a-z]+/"
  },
  "acceptance": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "item",
     "commit",
     "test",
     "result"
    ],
    "properties": {
     "item": {
      "type": "integer",
      "minimum": 1
     },
     "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
     },
     "test": {
      "type": "string",
      "minLength": 3
     },
     "result": {
      "type": "string",
      "const": "pass"
     }
    }
   }
  },
  "tests": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "command",
    "passed"
   ],
   "properties": {
    "command": {
     "type": "string",
     "minLength": 3
    },
    "passed": {
     "type": "boolean",
     "const": true
    }
   }
  },
  "files": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "dod": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "testes-passam",
    "aceite-coberto",
    "pr-no-formato",
    "sem-segredos",
    "verificado-apos-editar"
   ],
   "properties": {
    "testes-passam": {
     "type": "boolean"
    },
    "aceite-coberto": {
     "type": "boolean"
    },
    "pr-no-formato": {
     "type": "boolean"
    },
    "sem-segredos": {
     "type": "boolean"
    },
    "verificado-apos-editar": {
     "type": "boolean"
    }
   }
  }
 },
 "x-dod": [
  "testes-passam",
  "aceite-coberto",
  "pr-no-formato",
  "sem-segredos",
  "verificado-apos-editar"
 ],
 "x-trace": true
}
