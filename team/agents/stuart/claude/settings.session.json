{
  "_comment": "Time nativo (F4.2, T4.2.1): o que a sessão nova do stuart não faz, além do settings.json (que vale também para o time no tmux). Juntado pelo fsd-users no perfil do root. Base: o inventário X1 (estudos, T0.1.1); a tabela de casos em team/docs/deny-table.tsv.",
  "permissions": {
    "deny": [
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(*/var/lib/fsd-tokens*)",
      "Bash(*/var/lib/fsd-broker*)",
      "Bash(*claude-oauth-token*)",
      "Bash(*.credentials.json*)",
      "Read(//var/lib/fsd-tokens/**)",
      "Read(//var/lib/fsd-broker/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/claude-oauth-token)",
      "Bash(*ai-memory/auth-*)",
      "Read(~/.local/share/ai-memory/auth-*)",
      "Edit(~/.local/share/ai-memory/**)",
      "Write(~/.local/share/ai-memory/**)",
      "Bash(git config --global*)",
      "Bash(git config --system*)",
      "Bash(git config alias*)",
      "Bash(git config core.*)",
      "Bash(git config --unset*)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Bash(git push *origin develop*)",
      "Bash(git push *origin main*)",
      "Bash(git push *:develop*)",
      "Bash(git push *:main*)",
      "Bash(git push*HEAD:develop*)",
      "Bash(git push*HEAD:main*)",
      "Monitor",
      "ListAgents",
      "SendMessage",
      "Bash(fsd-merge*)",
      "Bash(fsd-restart*)",
      "Bash(fsd-wait*)",
      "Bash(tmux send-keys*)",
      "Bash(sudo*)",
      "Bash(fsd-review post*)",
      "Bash(fsd-qa*)",
      "Bash(fsd-issue decide*)",
      "Bash(fsd-arq*)",
      "Edit(//srv/fsd/repo/**)",
      "Write(//srv/fsd/repo/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$FSD_TEAM/bin/fsd-native-guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$FSD_TEAM/bin/fsd-verify-hook",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.claude/.credentials.json",
        "~/.local/share/ai-memory/auth-token",
        "~/.local/share/ai-memory/auth-header",
        "~/.local/share/ai-memory/auth-tokens"
      ],
      "allowWrite": [
        "~/repo",
        "~/wt",
        "~/qa",
        "~/.config/fsd-agents",
        "~/.fsd",
        "~/.npm",
        "~/.cache",
        "/tmp"
      ]
    },
    "network": {
      "allowedDomains": [
        "*"
      ]
    }
  }
}
