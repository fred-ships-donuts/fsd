# team.env — valores da SUA instalação. Copie para team.env, preencha e NÃO versione no repo público
# (o team.env real mora no cofre privado, ao lado do secrets.tar.age).
# Container:  docker run --env-file team.env …     Matriz: `set -a; . team.env; set +a`
FSD_AUTHOR=seu-login-no-github
FSD_MATRIZ=100.x.y.z                 # IP da matriz na tailnet
FSD_MATRIZ_USER=seu-usuario-linux    # usuário da matriz que recebe o túnel SSH
FSD_MATRIZ_SYNC_ID=XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX-XXXXXXX   # `fsd-sync-pair id` na matriz
FSD_AGENTS_URL=https://github.com/seu-login/fsd-agents.git   # cofre privado: secrets.tar.age + team.env
FSD_AGENTS_BRANCH=main
# Opcionais: FSD_REPO (caminho do clone do fsd), FSD_STATE (padrão ~/.config/fsd-agents),
#            FSD_TAILNET_CIDR (padrão 100.64.0.0/10), FSD_BACKUP_DIR
