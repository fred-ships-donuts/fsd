#!/usr/bin/env node
// supervisor-coverage — a cobertura do supervisor (fsd-dispatch e fsd-dispatch-*) pelo c8, só com os testes dele (npm run test:supervisor).
// Os testes rodam cópias do team/ numa pasta temporária, em processos filhos: uma cópia de conteúdo igual ao arquivo conta como ele; uma
// cópia que o teste mudou ou apagou não conta. Sai 1 se um teste falha ou se linhas, ramos, funções ou instruções ficam abaixo de MIN.
// Sem rede nem token. Arquivo de código novo com esse nome entra sozinho, mesmo que nenhum teste o carregue (--all).
import { readdirSync, readFileSync, writeFileSync, existsSync, mkdtempSync, mkdirSync, rmSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { tmpdir } from 'node:os';
import { join, dirname, basename } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
const MIN = 100;
const REPO = join(dirname(fileURLToPath(import.meta.url)), '..', '..'), BIN = join(REPO, 'team', 'bin');
const all = readdirSync(BIN).filter((f) => /^fsd-dispatch([.-]|$)/.test(f)), tests = all.filter((f) => f.endsWith('.test.mjs')), code = all.filter((f) => !f.endsWith('.test.mjs'));
const base = mkdtempSync(join(tmpdir(), 'sup-cov-')), v8 = join(base, 'v8'), tmp = join(base, 'tmp'); mkdirSync(v8); mkdirSync(tmp);
process.on('exit', () => rmSync(base, { recursive: true, force: true }));
const t = spawnSync(process.execPath, ['--test', ...tests.map((f) => join(BIN, f))], { cwd: REPO, stdio: 'inherit', env: { ...process.env, NODE_V8_COVERAGE: v8, TMPDIR: tmp } });
if (t.status !== 0) { console.error('supervisor-coverage: teste falhou'); process.exit(1); }
const same = new Map();   // cópia → o arquivo do repositório, se o conteúdo é igual
const original = (p) => {
  if (dirname(p) === BIN) return p;
  if (!same.has(p)) { const o = join(BIN, basename(p)); same.set(p, code.includes(basename(p)) && existsSync(p) && readFileSync(p, 'utf8') === readFileSync(o, 'utf8') ? o : null); }
  return same.get(p);
};
for (const f of readdirSync(v8)) {
  const j = JSON.parse(readFileSync(join(v8, f), 'utf8'));
  j.result = j.result.flatMap((s) => { if (!s.url.startsWith('file:')) return []; const o = original(fileURLToPath(s.url.split('?')[0])); return o && code.includes(basename(o)) ? [{ ...s, url: pathToFileURL(o).href }] : []; });
  writeFileSync(join(v8, f), JSON.stringify(j));
}
const r = spawnSync(join(REPO, 'node_modules', '.bin', 'c8'), ['report', '--all', '--temp-directory', v8, '--extension', '.mjs', '--extension', '', '--exclude', 'nada', ...code.flatMap((f) => ['--include', `team/bin/${f}`]),
  '--reporter', 'text', '--check-coverage', '--lines', MIN, '--branches', MIN, '--functions', MIN, '--statements', MIN].map(String), { cwd: REPO, stdio: 'inherit' });
if (r.error) console.error(`supervisor-coverage: c8 não rodou (${r.error.code}); rode npm ci`);
process.exit(r.status === 0 ? 0 : 1);
