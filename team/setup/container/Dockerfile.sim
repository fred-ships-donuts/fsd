# Imagem local de teste do isolamento (F2.0): os usuários do time nativo e as verificações K, sem rede nem segredo.
FROM ubuntu:24.04
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git ca-certificates >/dev/null && rm -rf /var/lib/apt/lists/*
COPY team/setup/container/fsd-users team/setup/container/k-checks /opt/fsd-sim/
COPY team/agents /opt/fsd-sim/agents
RUN chmod 0755 /opt/fsd-sim/fsd-users /opt/fsd-sim/k-checks && FSD_PROFILES_SRC=/opt/fsd-sim/agents /opt/fsd-sim/fsd-users
CMD ["/opt/fsd-sim/k-checks"]
