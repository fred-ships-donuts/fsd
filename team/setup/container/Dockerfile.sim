# Imagem local de teste do isolamento (F2.0): os usuários do time nativo e as verificações K, sem rede nem segredo.
FROM ubuntu:24.04
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends git ca-certificates curl xz-utils libatomic1 sudo jq acl >/dev/null && rm -rf /var/lib/apt/lists/*
# Validação R34: o mesmo Node da imagem de produção (o simulate-container passa o NODE_VERSION do Dockerfile), não o do apt (18).
# Tarball oficial conferido pelo SHASUMS256.txt.
ARG NODE_VERSION
RUN [ -n "$NODE_VERSION" ] || { echo "NODE_VERSION vazio (rode pelo simulate-container)"; exit 1; } \
 && arch=$(dpkg --print-architecture | sed 's/amd64/x64/') && f="node-v$NODE_VERSION-linux-$arch.tar.xz" && cd /tmp \
 && curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/$f" && curl -fsSLO "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt" \
 && grep " $f\$" SHASUMS256.txt | sha256sum -c - >/dev/null && mkdir -p /opt/node && tar -xJf "$f" -C /opt/node --strip-components=1 \
 && rm -rf /opt/node/include "$f" SHASUMS256.txt && ln -s /opt/node/bin/node /usr/local/bin/node && node --version
COPY team/setup/container/fsd-users team/setup/container/fsd-repo team/setup/container/fsd-run-exec team/setup/container/fsd-session-exec team/setup/container/k-checks /opt/fsd-sim/
COPY team/agents /opt/fsd-sim/agents
COPY team/common /opt/fsd-sim/common
COPY team/bin /opt/fsd-sim/team/bin
COPY team/agents.json team/claude-settings.json /opt/fsd-sim/team/
COPY team/contracts /opt/fsd-sim/team/contracts
COPY team/setup/stub-claude team/setup/fake-gh /opt/fsd-sim/team/setup/
RUN ln -s /opt/fsd-sim/team/setup/stub-claude /usr/local/bin/claude
RUN mkdir -p /opt/fsd-sim/aim-tokens && for r in kevin mel stuart bob; do echo "aim_fake_$r" > /opt/fsd-sim/aim-tokens/$r; done
RUN chmod 0755 /opt/fsd-sim/fsd-users /opt/fsd-sim/fsd-repo /opt/fsd-sim/fsd-run-exec /opt/fsd-sim/fsd-session-exec /opt/fsd-sim/k-checks && FSD_PROFILES_SRC=/opt/fsd-sim/agents FSD_REPO_DIR=/srv/repo FSD_TEAM_DIR=/opt/fsd-sim/team FSD_NATIVE_PREFLIGHT=0 FSD_AIM_TOKENS_SRC=/opt/fsd-sim/aim-tokens /opt/fsd-sim/fsd-users
# Um remoto bare local (o grupo grava, como o GitHub para quem tem token) e o clone do time preparado pelo fsd-repo (K7).
RUN git config --global user.email sim@sim && git config --global user.name sim \
 && git init -q --bare /srv/origin.git && git clone -q /srv/origin.git /tmp/seed && cd /tmp/seed && echo a > a && printf 'workspace = "default"\nproject = "sim"\n' > .ai-memory.toml && git add a .ai-memory.toml && git commit -qm init && git push -q origin HEAD:develop \
 && chgrp -R fsd /srv/origin.git && chmod -R g+rwX /srv/origin.git && find /srv/origin.git -type d -exec chmod g+s {} + && git -C /srv/origin.git config core.sharedRepository group \
 && git config --system --add safe.directory /srv/origin.git && git clone -q -b develop /srv/origin.git /srv/repo && /opt/fsd-sim/fsd-repo /srv/repo
# E6 (preparação): o fsd-native-setup de ponta a ponta numa raiz à parte, com um clone git que tem o team/ e ferramentas falsas.
COPY team /tmp/src/team
RUN git init -q /tmp/src && git -C /tmp/src add -A && git -C /tmp/src -c user.email=s@s -c user.name=s commit -qm team \
 && mkdir -p /opt/fake-aim && printf '#!/bin/sh\nexit 0\n' > /opt/fake-aim/ai-memory && chmod 755 /opt/fake-aim/ai-memory \
 && FSD_TEAM_SRC=/tmp/src FSD_TEAM_REF=HEAD FSD_REPO_URL=/srv/origin.git FSD_NATIVE_ROOT=/srv/native FSD_NODE_BIN=/opt/node/bin/node \
    FSD_CLAUDE_REAL=/opt/fsd-sim/team/setup/stub-claude FSD_AIM_DIR=/opt/fake-aim FSD_NATIVE_PREFLIGHT=0 \
    FSD_AIM_TOKENS_SRC=/opt/fsd-sim/aim-tokens bash /tmp/src/team/setup/container/fsd-native-setup
RUN echo '{"type":"module"}' > /opt/fsd-sim/package.json && chmod -R a+rX /opt/fsd-sim/team /opt/fsd-sim/package.json
ENV FSD_SIM_REPO=/srv/repo FSD_SIM_TEAM=/opt/fsd-sim/team
# A ACL das pastas de estado não sobrevive ao build (fsd-users): refeita no início, como o entrypoint faz em produção.
CMD ["bash", "-c", "/opt/fsd-sim/fsd-users --state >/dev/null && exec /opt/fsd-sim/k-checks"]
