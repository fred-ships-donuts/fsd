#!/usr/bin/env bash
# fsd-users — usuários do time nativo no container (F2.1, T2.1.1/T2.1.2; D3). Rode como root; idempotente.
#   papéis: fsd-kevin, fsd-mel, fsd-stuart, fsd-bob · fsd-run (roda o código do PR, sem repositório nem token) ·
#   fsd-dispatch (supervisor) · fsd-broker (chaves dos Apps). O humano (fsd, uid 1000) fica à parte. Nenhuma sessão roda como root.
#   Cada home é 0700 do dono. O grupo fsd é o do repositório (papéis e supervisor). O perfil de cada papel (settings.json,
#   CLAUDE.md, skills/) fica em /etc/fsd/profiles/<papel>, com dono root: o papel lê e não edita a própria config.
#   umask 077 para todos (arquivos novos, também no /tmp, só do dono).
# FSD_PROFILES_SRC=<pasta team/agents> copia os perfis de lá (padrão: sem cópia, só a estrutura).
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "fsd-users: rode como root"; exit 2; }
ROLES=(kevin mel stuart bob)
getent group fsd >/dev/null || groupadd fsd
mk() {   # mk <usuário> [grupos extras]
  local u=$1; shift
  id "$u" >/dev/null 2>&1 || useradd -m -s /bin/bash -U "$u"
  [ $# -gt 0 ] && usermod -aG "$(IFS=,; echo "$*")" "$u"
  chmod 0700 "/home/$u"; chown "$u:$u" "/home/$u"
}
for r in "${ROLES[@]}"; do mk "fsd-$r" fsd; done
mk fsd-dispatch fsd
mk fsd-run
mk fsd-broker
install -d -o root -g root -m 0755 /etc/fsd /etc/fsd/profiles
for r in "${ROLES[@]}"; do
  p=/etc/fsd/profiles/$r; install -d -o root -g root -m 0755 "$p" "$p/skills"
  src=${FSD_PROFILES_SRC:-}/$r/claude
  if [ -n "${FSD_PROFILES_SRC:-}" ] && [ -d "$src" ]; then
    [ -f "$src/settings.json" ] && install -o root -g root -m 0644 "$src/settings.json" "$p/settings.json"
    [ -f "$src/CLAUDE.md" ] && install -o root -g root -m 0644 "$src/CLAUDE.md" "$p/CLAUDE.md"
    [ -d "$src/skills" ] && cp -r "$src/skills/." "$p/skills/" && chown -R root:root "$p/skills" && chmod -R u=rwX,go=rX "$p/skills"
  fi
  [ -f "$p/settings.json" ] || install -o root -g root -m 0644 /dev/null "$p/settings.json"
done
# Tokens (F2.3): a pasta de cada papel é do fsd-broker, com o grupo do papel e setgid (o arquivo herda o grupo); 0750 + arquivo 0440
# = só o broker escreve e só o papel lê. O token de merge e release fica numa pasta do grupo do supervisor. As chaves: só o broker.
install -d -o root -g root -m 0755 /var/lib/fsd-tokens
for r in "${ROLES[@]}"; do install -d -o fsd-broker -g "fsd-$r" -m 2750 "/var/lib/fsd-tokens/$r"; done
install -d -o fsd-broker -g fsd-dispatch -m 2750 /var/lib/fsd-tokens/dispatch
install -d -o fsd-broker -g fsd-broker -m 0700 /var/lib/fsd-broker /var/lib/fsd-broker/keys
# QA (F2.4): o código do PR roda como fsd-run, numa área só dele; o Bob chama só o fsd-run-exec, por um sudoers estreito.
install -d -o fsd-run -g fsd-run -m 0700 /var/lib/fsd-run /var/lib/fsd-run/qa
src=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fsd-run-exec
[ -f "$src" ] && install -o root -g root -m 0755 "$src" /usr/local/sbin/fsd-run-exec
if [ -d /etc/sudoers.d ]; then
  printf 'Defaults:fsd-bob env_reset\nfsd-bob ALL=(fsd-run) NOPASSWD: /usr/local/sbin/fsd-run-exec\n' > /etc/sudoers.d/fsd-run.tmp
  chmod 0440 /etc/sudoers.d/fsd-run.tmp
  if command -v visudo >/dev/null && visudo -cf /etc/sudoers.d/fsd-run.tmp >/dev/null; then mv /etc/sudoers.d/fsd-run.tmp /etc/sudoers.d/fsd-run; else rm -f /etc/sudoers.d/fsd-run.tmp; echo "fsd-users: sudoers do fsd-run inválido" >&2; exit 1; fi
fi
echo 'umask 077' > /etc/profile.d/fsd-umask.sh; chmod 0644 /etc/profile.d/fsd-umask.sh
grep -q '^UMASK[[:space:]]\+077' /etc/login.defs 2>/dev/null || sed -i 's/^UMASK.*/UMASK\t\t077/' /etc/login.defs
echo "fsd-users: ${ROLES[*]/#/fsd-} fsd-run fsd-dispatch fsd-broker prontos"
