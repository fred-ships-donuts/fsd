#!/usr/bin/env bash
# fsd-users — usuários do time nativo no container (F2.1, T2.1.1/T2.1.2; D3). Rode como root; idempotente.
#   papéis: fsd-kevin, fsd-mel, fsd-stuart, fsd-bob · fsd-run (roda o código do PR, sem repositório nem token) ·
#   fsd-dispatch (supervisor) · fsd-broker (chaves dos Apps). O humano (fsd, uid 1000) fica à parte. Nenhuma sessão roda como root.
#   Cada home é 0700 do dono. O grupo fsd é o do repositório (papéis e supervisor). O perfil de cada papel (settings.json,
#   CLAUDE.md, skills/) fica em /etc/fsd/profiles/<papel>, com dono root: o papel lê e não edita a própria config.
#   umask 077 para os usuários fsd-* (arquivos novos, também no /tmp, só do dono); o humano não muda.
# FSD_PROFILES_SRC=<pasta team/agents> copia os perfis de lá (padrão: sem cópia, só a estrutura).
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "fsd-users: rode como root"; exit 2; }
ROLES=(kevin mel stuart bob)
# Estado do time nativo (validação R1): uma pasta por papel em $FSD_STATE_ROOT/<papel> (outbox, caixa, estado do hook, cartão,
# tarefa, leases, entregas). Dono o papel, grupo fsd-dispatch, 2770: só o papel e o supervisor entram; um papel não grava na pasta de
# outro, então o dono do arquivo no outbox segue sendo o remetente (A4). A ACL padrão dá rw aos dois em tudo o que for criado ali,
# apesar do umask 077 da sessão (R38). A raiz é do root, com o grupo do supervisor: o PAUSE único do time mora nela (R12).
# A ACL só vale criada com o container no ar: o docker build não guarda ACL nas camadas (provado). O fsd-native-setup roda no
# entrypoint, então vale; a imagem do sim chama `fsd-users --state` no início dos K.
SR=${FSD_STATE_ROOT:-/var/lib/fsd-state}
state_dirs() {
  command -v setfacl >/dev/null || { echo "fsd-users: precisa do setfacl (pacote acl) para o estado dos papéis" >&2; exit 1; }
  install -d -o root -g fsd-dispatch -m 0771 "$SR"
  local r d acl
  for r in "${ROLES[@]}"; do
    d=$SR/$r; acl="u:fsd-$r:rwX,g:fsd-dispatch:rwX,m::rwx"
    install -d -o "fsd-$r" -g fsd-dispatch -m 2770 "$d"
    { setfacl -R -m "$acl" "$d" && find "$d" -type d -exec setfacl -d -m "$acl" {} +; } || { echo "fsd-users: a ACL de $d não pegou (o sistema de arquivos tem ACL?)" >&2; exit 1; }
  done
}
# Validação R13: uid e gid fixos (2000+), para que as homes e o estado em volume continuem do mesmo dono num container novo.
declare -A UID_OF=([fsd-kevin]=2001 [fsd-mel]=2002 [fsd-stuart]=2003 [fsd-bob]=2004 [fsd-dispatch]=2005 [fsd-run]=2006 [fsd-broker]=2007)
getent group fsd >/dev/null || groupadd -g 2000 fsd
mk() {   # mk <usuário> [grupos extras]
  local u=$1; shift; local n=${UID_OF[$u]}
  getent group "$u" >/dev/null || groupadd -g "$n" "$u"
  id "$u" >/dev/null 2>&1 || useradd -m -s /bin/bash -u "$n" -g "$u" "$u"
  [ $# -gt 0 ] && usermod -aG "$(IFS=,; echo "$*")" "$u"
  chmod 0700 "/home/$u"; chown "$u:$u" "/home/$u"
}
for r in "${ROLES[@]}"; do mk "fsd-$r" fsd; done
mk fsd-dispatch fsd
mk fsd-run
mk fsd-broker
if [ "${1:-}" = --state ]; then state_dirs; echo "fsd-users: estado dos papéis em $SR pronto"; exit 0; fi   # só as pastas de estado (sim)
install -d -o root -g root -m 0755 /etc/fsd /etc/fsd/profiles
for r in "${ROLES[@]}"; do
  p=/etc/fsd/profiles/$r; install -d -o root -g root -m 0755 "$p" "$p/skills"
  src=${FSD_PROFILES_SRC:-}/$r/claude
  if [ -n "${FSD_PROFILES_SRC:-}" ] && [ -d "$src" ]; then
    [ -f "$src/settings.json" ] && install -o root -g root -m 0644 "$src/settings.json" "$p/settings.json"
    [ -f "$src/settings.session.json" ] && install -o root -g root -m 0644 "$src/settings.session.json" "$p/settings.session.json"
    [ -f "$src/CLAUDE.md" ] && install -o root -g root -m 0644 "$src/CLAUDE.md" "$p/CLAUDE.md"
    # Skills do papel (as comuns entram pelos links que o papel já tem, seguidos com -L); a versão da sessão nova
    # (SKILL.session.md) entra no lugar do SKILL.md (F4.3).
    if [ -d "$src/skills" ]; then cp -rL "$src/skills/." "$p/skills/"; fi
    find "$p/skills" -name SKILL.session.md -exec sh -c 'mv -f "$1" "$(dirname "$1")/SKILL.md"' _ {} \;
    chown -R root:root "$p/skills"; chmod -R u=rwX,go=rX "$p/skills"
    # Validação R8: as skills do perfil entram na sessão como plugin (--plugin-dir; com --setting-sources local, as do usuário não
    # carregam). Plugin à parte, só com o manifesto e as skills, para nada mais do perfil virar parte de plugin.
    rm -rf "$p/plugin.new"; install -d -o root -g root -m 0755 "$p/plugin.new" "$p/plugin.new/.claude-plugin"
    printf '{"name":"fsd-%s","version":"1.0.0","description":"Skills do papel %s no time nativo"}\n' "$r" "$r" > "$p/plugin.new/.claude-plugin/plugin.json"
    cp -r "$p/skills" "$p/plugin.new/skills"; chown -R root:root "$p/plugin.new"; chmod -R u=rwX,go=rX "$p/plugin.new"
    rm -rf "$p/plugin"; mv "$p/plugin.new" "$p/plugin"
    # Prompt fixo do papel (--append-system-prompt-file): o papel na sessão nova + as regras do time na sessão nova.
    team_rules=${FSD_PROFILES_SRC%/}/../common/team.session.md
    if [ -f "$src/CLAUDE.session.md" ] && [ -f "$team_rules" ]; then
      cat "$src/CLAUDE.session.md" <(echo) "$team_rules" > "$p/system.md.tmp" && install -o root -g root -m 0644 "$p/system.md.tmp" "$p/system.md"; rm -f "$p/system.md.tmp"
    fi
  fi
  [ -f "$p/settings.json" ] || install -o root -g root -m 0644 /dev/null "$p/settings.json"
  # F4.1: a sessão sobe só com este arquivo (--setting-sources local): os hooks do time (claude-settings.json) + o perfil do papel,
  # juntos aqui, do root. Arrays (hooks de cada evento, allow/deny) somados sem repetição; objetos mesclados.
  team=${FSD_TEAM_DIR:-}/claude-settings.json
  if [ -n "${FSD_TEAM_DIR:-}" ] && [ -f "$team" ] && command -v jq >/dev/null; then
    role=$p/settings.json; [ -s "$role" ] || role=/dev/null
    # Modelo do papel (F4.8; a medição D5 troca aqui): agents.json → agents.<papel>.claude.model, no perfil do root (o --resume com as
    # flags fixas não leva --model; o settings sim).
    model=$(jq -r --arg r "$r" '.agents[$r].claude.model // ""' "${FSD_TEAM_DIR}/agents.json" 2>/dev/null || true)
    sess=$p/settings.session.json; [ -s "$sess" ] || sess=/dev/null   # F4.2: o deny e o guard só da sessão nova
    jq -s 'def m($a; $b): if ($a|type) == "object" and ($b|type) == "object" then reduce (($a|keys) + ($b|keys) | unique)[] as $k ({}; .[$k] = m($a[$k]; $b[$k]))
           elif ($a|type) == "array" and ($b|type) == "array" then ($a + $b | unique) elif $b == null then $a else $b end;
           m(m(.[0]; (.[1] // {})); (.[2] // {}))
           | .hooks |= walk(if type == "string" then gsub(" --auth-token \"\\$AI_MEMORY_AUTH_TOKEN\""; "") | gsub("--data-dir \\$HOME/.local/share/ai-memory "; "--data-dir $HOME/.local/share/ai-memory --config " + $aimcfg + " ") else . end)
           | if $model != "" then .model = $model else . end' --arg model "$model" --arg aimcfg "$p/ai-memory.toml" "$team" "$role" "$sess" > "$p/settings.json.tmp" && install -o root -g root -m 0644 "$p/settings.json.tmp" "$p/settings.json"; rm -f "$p/settings.json.tmp"
  fi
done
# Validação R9: as pastas da home que o sandbox do Bash deixa gravar (allowWrite "~/…") existem antes da sessão. Um caminho que não
# existe fica só leitura dentro do sandbox, e o papel não consegue criá-lo (provado na sessão real: git worktree add em ~/wt falhava).
if command -v jq >/dev/null; then
  for r in "${ROLES[@]}"; do
    [ -s "/etc/fsd/profiles/$r/settings.json" ] || continue
    jq -r '.sandbox.filesystem.allowWrite // [] | .[] | select(startswith("~/")) | .[2:]' "/etc/fsd/profiles/$r/settings.json" | while IFS= read -r rel; do
      case "$rel" in ''|*..*) continue ;; esac
      runuser -u "fsd-$r" -- mkdir -p -m 0700 "/home/fsd-$r/$rel"
    done
  done
fi
# git do papel (validação R7): identidade do bot, o credential helper do time (token do arquivo do papel) e https no lugar de ssh, num
# arquivo do root que a sessão usa como GIT_CONFIG_GLOBAL (o papel não edita; o ~/.gitconfig dele não entra).
if [ -n "${FSD_TEAM_DIR:-}" ] && [ -f "$FSD_TEAM_DIR/agents.json" ] && command -v jq >/dev/null; then
  for r in "${ROLES[@]}"; do
    slug=$(jq -r --arg r "$r" '.agents[$r].slug // ("fsd-" + $r)' "$FSD_TEAM_DIR/agents.json"); bid=$(jq -r --arg r "$r" '.agents[$r].bot_user_id // 0' "$FSD_TEAM_DIR/agents.json")
    g=/etc/fsd/profiles/$r/gitconfig
    printf '[user]\n\tname = %s[bot]\n\temail = %s+%s[bot]@users.noreply.github.com\n[credential "https://github.com"]\n\thelper =\n\thelper = %s/bin/git-credential-fsd\n[url "https://github.com/"]\n\tinsteadOf = git@github.com:\n[commit]\n\tgpgsign = false\n[core]\n\thooksPath = /dev/null\n' \
      "$slug" "$bid" "$slug" "$FSD_TEAM_DIR" > "$g.tmp" && install -o root -g root -m 0644 "$g.tmp" "$g"; rm -f "$g.tmp"
  done
fi
# ai-memory (T2.5.2): o token do papel nunca vai no argv (todos os uids leem o argv; fase0.md). O hook sem --auth-token lê
# <data_dir>/auth-token e o mcp-bridge lê o [auth].bearer_token_file do config.toml (provado na 3.4.3 com um servidor falso).
# O data dir é do papel (spool, estado); o token é 0400 do papel, o config.toml é do root. FSD_AIM_TOKENS_SRC=<pasta com um
# arquivo aim_… por papel> instala os tokens; sem ela, só a estrutura (a sessão sobe sem credencial e o ai-memory recusa).
for r in "${ROLES[@]}"; do
  h=/home/fsd-$r; dd=$h/.local/share/ai-memory
  install -d -o "fsd-$r" -g "fsd-$r" -m 0700 "$h/.local" "$h/.local/share" "$dd"
  # Validação R40: o config fica no perfil do root (o papel apagava e recriava o config.toml da pasta de dados dele); hooks e MCP passam
  # --config (o explícito vence o <data_dir>/config.toml).
  printf '[auth]\nbearer_token_file = "%s/auth-token"\n' "$dd" > "/etc/fsd/profiles/$r/ai-memory.toml.tmp" && install -o root -g root -m 0644 "/etc/fsd/profiles/$r/ai-memory.toml.tmp" "/etc/fsd/profiles/$r/ai-memory.toml"; rm -f "/etc/fsd/profiles/$r/ai-memory.toml.tmp" "$dd/config.toml"
  if [ -n "${FSD_TEAM_DIR:-}" ] && [ -f "$FSD_TEAM_DIR/mcp.json" ] && command -v jq >/dev/null; then
    jq --arg c "/etc/fsd/profiles/$r/ai-memory.toml" '(.mcpServers["ai-memory"].args) |= (.[0:1] + ["--config", $c] + .[1:])' "$FSD_TEAM_DIR/mcp.json" > "/etc/fsd/profiles/$r/mcp.json.tmp" \
      && install -o root -g root -m 0644 "/etc/fsd/profiles/$r/mcp.json.tmp" "/etc/fsd/profiles/$r/mcp.json"; rm -f "/etc/fsd/profiles/$r/mcp.json.tmp"
  fi
  tok=${FSD_AIM_TOKENS_SRC:-}/$r
  # Validação R19: só arquivo de verdade (o install segue link; um link do uid 1000 apontaria para outro arquivo).
  if [ -n "${FSD_AIM_TOKENS_SRC:-}" ] && [ -f "$tok" ] && [ ! -L "$tok" ] && [ -s "$tok" ]; then install -o "fsd-$r" -g "fsd-$r" -m 0400 "$tok" "$dd/auth-token"; fi
done
# Login do Claude (E6): FSD_CLAUDE_TOKEN_SRC=<arquivo com o token do `claude setup-token`> grava o ~/.claude/.credentials.json de cada
# papel (0600 do papel), sem /login interativo. O arquivo de credencial é negado ao Bash e ao Read nos perfis da sessão. Um login de
# verdade (com refreshToken) não é trocado; um semeado (refreshToken null) é regravado, e assim um token novo no cofre chega a todos.
ctok=${FSD_CLAUDE_TOKEN_SRC:-}
if [ -n "$ctok" ] && [ -f "$ctok" ] && [ ! -L "$ctok" ] && [ -s "$ctok" ] && command -v jq >/dev/null; then
  for r in "${ROLES[@]}"; do
    h=/home/fsd-$r; c=$h/.claude/.credentials.json
    install -d -o "fsd-$r" -g "fsd-$r" -m 0700 "$h/.claude"
    if [ -L "$c" ] || { [ -s "$c" ] && jq -e '.claudeAiOauth.refreshToken // empty' "$c" >/dev/null 2>&1; }; then continue; fi
    ( umask 077; jq -n --rawfile t "$ctok" --argjson exp "$(( ($(date +%s) + 365*86400) * 1000 ))" \
        '{claudeAiOauth: {accessToken: ($t | rtrimstr("\n") | rtrimstr("\r")), refreshToken: null, expiresAt: $exp, scopes: ["user:inference"], subscriptionType: null}}' > "$c.tmp" ) \
      && install -o "fsd-$r" -g "fsd-$r" -m 0600 "$c.tmp" "$c"; rm -f "$c.tmp"
  done
fi
# Bypass em --bg (F0.2, T0.2.2): o claude exige o aceite do aviso (skipDangerousModePermissionPrompt) nas settings do usuário, que a
# sessão do papel não lê (--setting-sources local). As managed settings (/etc/claude-code, do root, sempre lidas) valem para isso
# (provado no container). Só essa chave; o que já houver no arquivo fica. A confiança da pasta da sessão é gravada pelo fsd-profile.mjs (R47).
install -d -o root -g root -m 0755 /etc/claude-code
mf=/etc/claude-code/managed-settings.json; [ -s "$mf" ] || echo '{}' > "$mf"
if command -v jq >/dev/null; then jq '.skipDangerousModePermissionPrompt = true' "$mf" > "$mf.tmp" && install -o root -g root -m 0644 "$mf.tmp" "$mf"; rm -f "$mf.tmp"; fi
# Tokens (F2.3): a pasta de cada papel é do fsd-broker, com o grupo do papel e setgid (o arquivo herda o grupo); 0750 + arquivo 0440
# = só o broker escreve e só o papel lê. O token de merge e release fica numa pasta do grupo do supervisor. As chaves: só o broker.
install -d -o root -g root -m 0755 /var/lib/fsd-tokens
for r in "${ROLES[@]}"; do install -d -o fsd-broker -g "fsd-$r" -m 2750 "/var/lib/fsd-tokens/$r"; done
install -d -o fsd-broker -g fsd-dispatch -m 2750 /var/lib/fsd-tokens/dispatch
install -d -o fsd-broker -g fsd-broker -m 0700 /var/lib/fsd-broker /var/lib/fsd-broker/keys
state_dirs
# cwd das sessões (validação R14): uma pasta do root por papel, 0755, só com o .ai-memory.toml do repositório (o projeto do ai-memory).
CR=${FSD_CWD_ROOT:-/srv/fsd/cwd}
install -d -o root -g root -m 0755 "$(dirname "$CR")" "$CR"
for r in "${ROLES[@]}"; do
  install -d -o root -g root -m 0755 "$CR/$r"
  aim=${FSD_REPO_DIR:-/srv/fsd/repo}/.ai-memory.toml
  if [ -f "$aim" ] && [ ! -L "$aim" ]; then install -o root -g root -m 0644 "$aim" "$CR/$r/.ai-memory.toml"; fi
done
# QA (F2.4): o código do PR roda como fsd-run, numa área só dele; o Bob chama só o fsd-run-exec, por um sudoers estreito.
install -d -o fsd-run -g fsd-run -m 0700 /var/lib/fsd-run /var/lib/fsd-run/qa
src=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fsd-run-exec
[ -f "$src" ] && install -o root -g root -m 0755 "$src" /usr/local/sbin/fsd-run-exec
if [ -d /etc/sudoers.d ]; then
  printf 'Defaults:fsd-bob env_reset\nfsd-bob ALL=(fsd-run) NOPASSWD: /usr/local/sbin/fsd-run-exec\n' > /etc/sudoers.d/fsd-run.tmp
  chmod 0440 /etc/sudoers.d/fsd-run.tmp
  if command -v visudo >/dev/null && visudo -cf /etc/sudoers.d/fsd-run.tmp >/dev/null; then mv /etc/sudoers.d/fsd-run.tmp /etc/sudoers.d/fsd-run; else rm -f /etc/sudoers.d/fsd-run.tmp; echo "fsd-users: sudoers do fsd-run inválido" >&2; exit 1; fi
fi
# Supervisor (F2.6): o fsd-dispatch controla as sessões dos papéis só pelo fsd-session-exec, como cada papel.
printf 'REPO=%q\nTEAM=%q\nCLAUDE=%q\nPREFLIGHT=%q\nSTATE_ROOT=%q\nCWD_ROOT=%q\n' "${FSD_REPO_DIR:-/srv/fsd/repo}" "${FSD_TEAM_DIR:-${FSD_REPO_DIR:-/srv/fsd/repo}/team}" "${FSD_CLAUDE_BIN:-/usr/local/bin/claude}" "${FSD_NATIVE_PREFLIGHT:-1}" "$SR" "$CR" > /etc/fsd/session.env
chown root:root /etc/fsd/session.env; chmod 0644 /etc/fsd/session.env
src=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/fsd-session-exec
[ -f "$src" ] && install -o root -g root -m 0755 "$src" /usr/local/sbin/fsd-session-exec
if [ -d /etc/sudoers.d ]; then
  printf 'Defaults:fsd-dispatch env_reset\nfsd-dispatch ALL=(fsd-kevin,fsd-mel,fsd-stuart,fsd-bob) NOPASSWD: /usr/local/sbin/fsd-session-exec\n' > /etc/sudoers.d/fsd-session.tmp
  chmod 0440 /etc/sudoers.d/fsd-session.tmp
  if command -v visudo >/dev/null && visudo -cf /etc/sudoers.d/fsd-session.tmp >/dev/null; then mv /etc/sudoers.d/fsd-session.tmp /etc/sudoers.d/fsd-session; else rm -f /etc/sudoers.d/fsd-session.tmp; echo "fsd-users: sudoers do fsd-session inválido" >&2; exit 1; fi
fi
# umask 077 só para os usuários do time nativo (fsd-*): o humano (fsd) e o time antigo no tmux não mudam.
printf '%s\n' 'case "$(id -un)" in fsd-*) umask 077 ;; esac' > /etc/profile.d/fsd-umask.sh; chmod 0644 /etc/profile.d/fsd-umask.sh
echo "fsd-users: ${ROLES[*]/#/fsd-} fsd-run fsd-dispatch fsd-broker prontos"
