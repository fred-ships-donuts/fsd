#!/usr/bin/env bash
# k-checks — verificações K do isolamento do time nativo (F2.0). Rode como root dentro do container; sai 0 só sem falha.
# Cada linha: ok/FALHA <id> <o que>. Cresce com a E2 (repositório, broker, fsd-run, token oculto).
set -uo pipefail
ROLES=(kevin mel stuart bob); fail=0
ok() { echo "ok    $1 $2"; }; bad() { echo "FALHA $1 $2"; fail=1; }
# shellcheck disable=SC2329  # as funções são chamadas por check "$@"
can() { su -s /bin/bash "$1" -c "$2" >/dev/null 2>&1; }   # can <usuário> <comando>: 0 se o usuário consegue
cannot() { ! can "$@"; }   # cannot <usuário> <comando>: 0 se o usuário NÃO consegue (no mesmo processo, nunca num bash -c)
check() { local id=$1 what=$2; shift 2; if "$@" >/dev/null; then ok "$id" "$what"; else bad "$id" "$what"; fi; }
no_edit() { cannot "$1" "echo x >> $2/settings.json" && cannot "$1" "touch $2/novo"; }
for u in "${ROLES[@]/#/fsd-}" fsd-run fsd-dispatch fsd-broker; do
  check K1 "$u existe e não é root" bash -c "id $u >/dev/null && [ \$(id -u $u) != 0 ]"
  check K2 "home de $u é 0700 e do dono" bash -c "[ \$(stat -c %a /home/$u) = 700 ] && [ \$(stat -c %U /home/$u) = $u ]"
done
echo s > /home/fsd-stuart/segredo; chown fsd-stuart: /home/fsd-stuart/segredo; chmod 600 /home/fsd-stuart/segredo
check K3 "fsd-stuart lê a própria home" can fsd-stuart "cat /home/fsd-stuart/segredo"
for u in fsd-mel fsd-bob fsd-kevin fsd-run fsd-dispatch; do check K3 "$u não lê a home do fsd-stuart" cannot "$u" 'ls /home/fsd-stuart'; done
check K3 "fsd-stuart não lê a home do broker" cannot fsd-stuart 'ls /home/fsd-broker'
for r in "${ROLES[@]}"; do
  p=/etc/fsd/profiles/$r
  check K4 "perfil do $r é do root" bash -c "[ \$(stat -c %U $p) = root ] && [ \$(stat -c %U $p/settings.json) = root ]"
  check K4 "fsd-$r lê o próprio perfil" can "fsd-$r" "cat $p/settings.json"
  check K4 "fsd-$r não edita o próprio perfil" no_edit "fsd-$r" "$p"
done
check K5 "fsd-run fora do grupo do repositório" bash -c "! id -nG fsd-run | tr ' ' '\n' | grep -qx fsd"
for r in "${ROLES[@]}"; do check K5 "fsd-$r no grupo fsd" bash -c "id -nG fsd-$r | tr ' ' '\n' | grep -qx fsd"; done
check K6 "o humano (root aqui) não ganha o umask do time" bash -c "[ \"\$(bash -lc umask)\" != 0077 ]"
check K6 "umask 077 numa sessão de login do papel" bash -c "[ \"\$(su -l -s /bin/bash fsd-mel -c umask)\" = 0077 ]"
su -l -s /bin/bash fsd-mel -c 'echo s > /tmp/k6-mel'
check K6 "arquivo novo da Mel no /tmp não é lido pelo Stuart" cannot fsd-stuart 'cat /tmp/k6-mel'
# K7 (F2.2, A6; validação R18): o repositório entre uids. FSD_SIM_REPO = o depósito compartilhado preparado pelo fsd-repo (o
# Dockerfile.sim monta um, com um remoto bare local que o grupo grava). Cada papel trabalha no clone dele, na home (0700).
if [ -n "${FSD_SIM_REPO:-}" ]; then
  R=$FSD_SIM_REPO
  inown() { su -s /bin/bash "$1" -c "umask 007; cd /home/$1/repo && $2" >/dev/null 2>&1; }
  check K7 "R18: o compartilhado é só leitura para os papéis (nem .git, nem config, nem hook, nem ref)" bash -c "! su -s /bin/bash fsd-stuart -c 'touch $R/.git/x' 2>/dev/null && ! su -s /bin/bash fsd-stuart -c 'git -C $R config alias.x !id' 2>/dev/null && ! su -s /bin/bash fsd-mel -c 'echo id > $R/.git/hooks/pre-commit' 2>/dev/null && ! su -s /bin/bash fsd-mel -c 'git -C $R update-ref refs/heads/develop HEAD~0' 2>/dev/null"
  for r in "${ROLES[@]}"; do
    check K7 "R18: o clone do $r é dele, na home, com os objetos do compartilhado" bash -c "[ \"\$(stat -c %U /home/fsd-$r/repo)\" = fsd-$r ] && grep -qx '$R/.git/objects' /home/fsd-$r/repo/.git/objects/info/alternates"
  done
  check K7 "R18: a Mel não lê nem troca o clone do Stuart (index, HEAD, refs)" cannot fsd-mel "ls /home/fsd-stuart/repo/.git"
  W=/home/fsd-stuart/wt/fix-1-x
  check K7 "papel busca no próprio clone" inown fsd-stuart "git fetch -q origin develop"
  check K7 "papel cria o worktree do próprio clone na home" inown fsd-stuart "mkdir -p /home/fsd-stuart/wt && git worktree add -q --no-track -b fix/1-x $W origin/develop"
  check K7 "commit no worktree funciona" inown fsd-stuart "cd $W && echo b > b && git add b && git -c user.email=s@s -c user.name=s commit -qm b"
  check K7 "push do branch funciona" inown fsd-stuart "cd $W && git push -q origin fix/1-x"
  check K7 "outro papel não lê o worktree do Stuart" cannot fsd-mel "ls $W"
  check K7 "o supervisor busca e compacta as refs no compartilhado" bash -c "su -s /bin/bash fsd-dispatch -c 'git -C $R fetch -q origin && git -C $R pack-refs --all' >/dev/null 2>&1"
  check K7 "o compartilhado não apaga objeto de que um clone dependa (sem gc)" bash -c "[ \"\$(git -C $R config gc.auto)\" = 0 ] && [ \"\$(git -C $R config gc.pruneExpire)\" = never ]"
fi
# K8 (F2.3, C1): o broker. FSD_SIM_TEAM = o team/bin e o agents.json dentro da imagem (tokens falsos, sem chave nem rede).
if [ -n "${FSD_SIM_TEAM:-}" ]; then
  T=$FSD_SIM_TEAM/bin; asu() { su -s /bin/bash "$1" -c "$2" 2>/dev/null; }
  su -s /bin/bash fsd-broker -c "FSD_BROKER_FAKE=1 node $T/fsd-broker once" >/dev/null 2>&1
  check K8 "o broker gravou o token de cada papel e o do supervisor" bash -c "for r in kevin mel stuart bob dispatch; do [ -s /var/lib/fsd-tokens/\$r/token ] || exit 1; done"
  perm_is() { [ "$(stat -c '%a %G' "$1")" = "$2" ]; }
  check K8 "token do papel é 0440 e do grupo do papel" perm_is /var/lib/fsd-tokens/stuart/token '440 fsd-stuart'
  check K8 "Stuart lê o próprio token pelo usuário Unix" bash -c "asu() { su -s /bin/bash \"\$1\" -c \"\$2\" 2>/dev/null; }; asu fsd-stuart '$T/fsd-token-file' | grep -q '^fake-stuart-repo-'"
  check K8 "C1: FSD_AGENT=mel não muda a identidade do Stuart" bash -c "su -s /bin/bash fsd-stuart -c 'FSD_AGENT=mel FSD_RUNNER=session $T/fsd-token-file' 2>/dev/null | grep -q '^fake-stuart-repo-'"
  check K8 "Stuart não lê o token da Mel" cannot fsd-stuart "cat /var/lib/fsd-tokens/mel/token"
  check K8 "Stuart não lê o token do supervisor" cannot fsd-stuart "cat /var/lib/fsd-tokens/dispatch/token"
  check K8 "Stuart não lê as chaves dos Apps" cannot fsd-stuart "ls /var/lib/fsd-broker/keys"
  check K8 "Stuart não reescreve o próprio token" cannot fsd-stuart "echo x > /var/lib/fsd-tokens/stuart/token"
  check K8 "o supervisor lê o token de merge e não o do Stuart" bash -c "su -s /bin/bash fsd-dispatch -c 'cat /var/lib/fsd-tokens/dispatch/token' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c 'cat /var/lib/fsd-tokens/stuart/token' >/dev/null 2>&1"
  check K8 "fsd-run não lê token nenhum" cannot fsd-run "cat /var/lib/fsd-tokens/bob/token"
  printf '#!/bin/sh\necho "$GH_TOKEN"\n' > /usr/local/bin/fake-gh; chmod 755 /usr/local/bin/fake-gh
  check K8 "gh (wrapper) na sessão nova usa o token do usuário, com FSD_AGENT de outro" bash -c "su -s /bin/bash fsd-stuart -c 'FSD_RUNNER=session FSD_AGENT=mel FSD_REAL_GH=/usr/local/bin/fake-gh $T/gh pr list' 2>/dev/null | grep -q '^fake-stuart-repo-'"
  check K8 "git-credential-fsd na sessão nova dá o token do usuário" bash -c "printf 'protocol=https\nhost=github.com\n\n' | su -s /bin/bash fsd-stuart -c 'FSD_RUNNER=session FSD_AGENT=mel $T/git-credential-fsd get' 2>/dev/null | grep -q '^password=fake-stuart-repo-'"
fi
# K9 (F2.4, A2): o código do PR roda como fsd-run, sem o ambiente de quem chamou, e o exit vem de arquivo do Bob, não da tela.
if [ -x /usr/local/sbin/fsd-run-exec ]; then
  RX="sudo -n -u fsd-run /usr/local/sbin/fsd-run-exec"
  install -d -o fsd-run -g fsd-run -m 0700 /var/lib/fsd-run/qa/k9 /var/lib/fsd-run/qa/k9/work /var/lib/fsd-run/qa/k9/home
  check K9 "o Bob roda um comando como fsd-run" bash -c "su -s /bin/bash fsd-bob -c '$RX run k9 -- id -un' 2>/dev/null | grep -qx fsd-run"
  check K9 "o Stuart não usa o fsd-run" cannot fsd-stuart "$RX run k9 -- id -un"
  check K9 "o Bob não vira fsd-run para outra coisa" cannot fsd-bob "sudo -n -u fsd-run id"
  check K9 "A2: postinstall/código do PR não vê o ambiente do Bob (token, FSD_*)" bash -c "out=\$(su -s /bin/bash fsd-bob -c 'GH_TOKEN=s3cr3t FSD_AGENT=bob FSD_TOKEN_DIR=/x $RX run k9 -- env' 2>/dev/null); [ -n \"\$out\" ] && ! grep -qE 's3cr3t|^FSD_|^GH_TOKEN' <<<\"\$out\""
  check K9 "o código do PR não lê o token do Bob" bash -c "! su -s /bin/bash fsd-bob -c '$RX run k9 -- cat /var/lib/fsd-tokens/bob/token' >/dev/null 2>&1"
  su -s /bin/bash fsd-bob -c "mkdir -p ~/qa && chmod 700 ~/qa; $RX run k9 -- 'echo __EXIT=0; exit 3'; echo \$? > ~/qa/exit.k9" >/dev/null 2>&1
  check K9 "o exit vem do arquivo do Bob: __EXIT=0 impresso não vira 0" bash -c "[ \"\$(cat /home/fsd-bob/qa/exit.k9)\" = 3 ]"
  check K9 "o fsd-run não escreve o arquivo de exit do Bob" cannot fsd-run "echo 0 > /home/fsd-bob/qa/exit.k9"
  check K9 "prep recusa url fora do GitHub e sha inválido" bash -c "! su -s /bin/bash fsd-bob -c '$RX prep k9 file:///srv/origin.git 0123' >/dev/null 2>&1"
fi
# K10 (F2.6): o supervisor controla só as sessões dos papéis, só pelo wrapper e como cada papel (stub-claude no lugar do claude).
if [ -x /usr/local/sbin/fsd-session-exec ]; then
  SX="sudo -n -u fsd-stuart /usr/local/sbin/fsd-session-exec"
  echo "tarefa" > /tmp/k10-prompt; chmod 644 /tmp/k10-prompt
  check K10 "o supervisor lista as sessões do Stuart como o Stuart" bash -c "su -s /bin/bash fsd-dispatch -c '$SX agents' 2>/dev/null | grep -q '^\['"
  # O --bg escolhe o id e o imprime (F0.2); a sessão sobe com as flags fixas do root, sem --session-id.
  k10_start() { local id; id=$(su -s /bin/bash fsd-dispatch -c "$SX start /tmp/k10-prompt" 2>/dev/null | sed -n 's/^backgrounded · \([0-9a-f]*\).*/\1/p'); [ -n "$id" ] && su -s /bin/bash fsd-dispatch -c "$SX agents" | grep -q "\"id\": \"$id\""; }
  k10_flags() { local f; f=/tmp/stub-claude-$(id -u fsd-stuart)/state.json; grep -q -- '--strict-mcp-config' "$f" && ! grep -q -- '--session-id' "$f"; }
  check K10 "o supervisor sobe a sessão do Stuart (como fsd-stuart, FSD_RUNNER=session) e o --bg diz o id" k10_start
  check K10 "a sessão sobe com as flags fixas do root (MCP do time, sem --session-id)" k10_flags
  check K10 "a sessão subiu como o Stuart" bash -c "grep -q '\"agent\": \"stuart\"' /tmp/stub-claude/state.json 2>/dev/null || grep -rq '\"agent\": \"stuart\"' /tmp/stub-claude* 2>/dev/null"
  check K10 "o supervisor não roda outra coisa como o Stuart" cannot fsd-dispatch "sudo -n -u fsd-stuart id"
  check K10 "o supervisor não usa o wrapper como root nem como fsd-run" bash -c "! su -s /bin/bash fsd-dispatch -c 'sudo -n -u root /usr/local/sbin/fsd-session-exec agents' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c 'sudo -n -u fsd-run /usr/local/sbin/fsd-session-exec agents' >/dev/null 2>&1"
  check K10 "um papel não usa o wrapper para outro papel" cannot fsd-mel "sudo -n -u fsd-stuart /usr/local/sbin/fsd-session-exec agents"
  check K10 "fsd-session (como fsd-dispatch, FSD_SESSION_VIA=sudo) sobe a Mel e vê o estado dela" bash -c "su -s /bin/bash fsd-dispatch -c 'cd ~ && FSD_SESSION_VIA=sudo FSD_STATE=\$HOME/st node $FSD_SIM_TEAM/bin/fsd-session start mel \"tarefa #3\" >/dev/null && FSD_SESSION_VIA=sudo FSD_STATE=\$HOME/st node $FSD_SIM_TEAM/bin/fsd-session status --json' 2>/dev/null | grep -q '\"mel\":{\"state\":\"idle\"'"
  check K10 "o wrapper recusa id e uuid inválidos" bash -c "! su -s /bin/bash fsd-dispatch -c '$SX stop \"x;id\"' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c '$SX resume not-a-uuid /tmp/k10-prompt' >/dev/null 2>&1"
fi
# K17 (validação R6/R7): a sessão do papel sobe com o PATH do time, o repositório, o estado do papel e o git do root; um commit como o
# papel sai com a identidade do bot só pelo GIT_CONFIG_GLOBAL (sem -c).
if [ -x /usr/local/sbin/fsd-session-exec ] && command -v jq >/dev/null; then
  sj=/tmp/stub-claude-$(id -u fsd-stuart)/state.json; T17=$(grep -E '^TEAM=' /etc/fsd/session.env | cut -d= -f2); R17=$(grep -E '^REPO=' /etc/fsd/session.env | cut -d= -f2)
  k17_env() { jq -e --arg t "$T17/bin" --arg r "$R17" '[.sessions[] | select(.agent == "stuart")] | last | (.path | startswith($t + ":")) and .repo == "/home/fsd-stuart/repo" and .state == "/var/lib/fsd-state/stuart" and .gitcfg == "/etc/fsd/profiles/stuart/gitconfig"' "$sj" >/dev/null; }
  check K17 "a sessão do Stuart sobe com PATH do time, FSD_REPO, FSD_STATE e o gitconfig do root" k17_env
  check K17 "o gitconfig do papel é do root, com a identidade do bot e o helper do time" bash -c "[ \"\$(stat -c %U /etc/fsd/profiles/stuart/gitconfig)\" = root ] && git config -f /etc/fsd/profiles/stuart/gitconfig user.name | grep -qx 'fsd-stuart\[bot\]' && git config -f /etc/fsd/profiles/stuart/gitconfig --get-all credential.https://github.com.helper | grep -q git-credential-fsd"
  if [ -n "${FSD_SIM_REPO:-}" ]; then
    k17_commit() { su -s /bin/bash fsd-stuart -c "umask 007; export GIT_CONFIG_GLOBAL=/etc/fsd/profiles/stuart/gitconfig; d=/home/fsd-stuart/wt/k17; cd /home/fsd-stuart/repo && git worktree add -q --no-track -b k17 \$d origin/develop && cd \$d && echo k > k && git add k && git commit -qm k && git log -1 --format=%an" 2>/dev/null | grep -qx 'fsd-stuart\[bot\]'; }
    check K17 "commit como o Stuart, sem -c, sai como fsd-stuart[bot]" k17_commit
  fi
fi
# K11 (F4.1): o perfil do papel junta os hooks do time e o papel; com a checagem ligada, sem ai-memory nem túnel, a sessão não sobe.
if [ -x /usr/local/sbin/fsd-session-exec ] && command -v jq >/dev/null; then
  check K11 "o perfil do Stuart tem os hooks do time e o deny dele" bash -c "jq -e '.hooks.PostToolUse | map(.hooks[].command) | any(test(\"fsd-session-hook\"))' /etc/fsd/profiles/stuart/settings.json >/dev/null && jq -e '.permissions.deny | any(test(\"git push\"))' /etc/fsd/profiles/stuart/settings.json >/dev/null"
  check K11 "o perfil do Kevin junta o deny da sessão nova (sem fsd-merge, sem Monitor) e o guard" bash -c "jq -e '(.permissions.deny | index(\"Bash(fsd-merge*)\")) and (.permissions.deny | index(\"Monitor\")) and (.hooks.PreToolUse | map(.hooks[].command) | any(test(\"fsd-native-guard\")))' /etc/fsd/profiles/kevin/settings.json >/dev/null"
  for r in kevin mel stuart bob; do
    check K11 "o prompt e as skills do perfil do $r não têm os termos do time no tmux (F4.3)" bash -c "[ -s /etc/fsd/profiles/$r/system.md ] && ! grep -rqE 'fsd-restart|fsd-wait|fsd-notify|\\bMonitor\\b|\\[fsd-aviso|fsd-merge' /etc/fsd/profiles/$r/system.md /etc/fsd/profiles/$r/skills"
  done
  sed -i 's/^PREFLIGHT=.*/PREFLIGHT=1/' /etc/fsd/session.env
  echo x > /tmp/k11-prompt; chmod 644 /tmp/k11-prompt
  out=$(su -s /bin/bash fsd-dispatch -c "sudo -n -u fsd-bob /usr/local/sbin/fsd-session-exec start /tmp/k11-prompt" 2>&1)
  check K11 "com a checagem ligada e o túnel fechado, a sessão do Bob não sobe e diz por quê" bash -c "grep -q 'a sessão não sobe' <<<\"$out\" && grep -q 'túnel do ai-memory fechado' <<<\"$out\""
  sed -i 's/^PREFLIGHT=.*/PREFLIGHT=0/' /etc/fsd/session.env
fi
# K12 (T2.5.2): o token do ai-memory fora do argv. O perfil chama o hook sem --auth-token; o token é um arquivo 0400 do papel, que
# outro papel não lê; um hook falso (que só imprime o argv) não vê o token; o config.toml do papel é do root.
if command -v jq >/dev/null && [ -f /etc/fsd/profiles/stuart/settings.json ]; then
  D=/home/fsd-stuart/.local/share/ai-memory
  check K12 "nenhum hook do perfil passa --auth-token" bash -c "for r in kevin mel stuart bob; do jq -e '[.hooks[][].hooks[].command] | any(test(\"auth-token\")) | not' /etc/fsd/profiles/\$r/settings.json >/dev/null || exit 1; done"
  check K12 "os hooks do ai-memory seguem no perfil" bash -c "jq -e '[.hooks[][].hooks[].command] | map(select(test(\"ai-memory\"))) | length > 5' /etc/fsd/profiles/stuart/settings.json >/dev/null"
  check K12 "o token do Stuart é 0400 dele" bash -c "[ \"\$(stat -c '%a %U' $D/auth-token)\" = '400 fsd-stuart' ]"
  check K12 "a Mel não lê o token do Stuart" cannot fsd-mel "cat $D/auth-token"
  AC=/etc/fsd/profiles/stuart/ai-memory.toml
  check K12 "R40: o config do ai-memory do papel é do root, no perfil, e aponta o arquivo" bash -c "[ \"\$(stat -c %U $AC)\" = root ] && grep -q 'bearer_token_file = \"$D/auth-token\"' $AC && [ ! -e $D/config.toml ]"
  check K12 "R40: o Stuart não apaga nem reescreve o config (rm -f e >>)" bash -c "! su -s /bin/bash fsd-stuart -c 'rm -f $AC' 2>/dev/null; [ -f $AC ] && ! su -s /bin/bash fsd-stuart -c 'echo x >> $AC' 2>/dev/null"
  check K12 "R40: os hooks e o MCP do papel passam --config com esse arquivo" bash -c "jq -e --arg c $AC '[.hooks[][].hooks[].command | select(test(\"ai-memory\"))] | all(contains(\"--config \" + \$c))' /etc/fsd/profiles/stuart/settings.json && jq -e --arg c $AC '.mcpServers[\"ai-memory\"].args | index(\$c)' /etc/fsd/profiles/stuart/mcp.json"
  # O comando do hook como o perfil o roda, com um ai-memory falso que grava o argv: nenhum pedaço do token aparece.
  cmd=$(jq -r '[.hooks[][].hooks[].command | select(test("ai-memory"))][0]' /etc/fsd/profiles/stuart/settings.json)
  [ -e /home/fsd-stuart/.local/lib ] && mv /home/fsd-stuart/.local/lib /home/fsd-stuart/.local/lib.k12   # o do setup nativo volta no fim
  install -d -o fsd-stuart -g fsd-stuart -m 0700 /home/fsd-stuart/.local/lib /home/fsd-stuart/.local/lib/ai-memory
  printf '#!/bin/sh\necho "$0 $*" > /tmp/k12-argv\n' > /home/fsd-stuart/.local/lib/ai-memory/ai-memory
  chown fsd-stuart: /home/fsd-stuart/.local/lib/ai-memory/ai-memory; chmod 0700 /home/fsd-stuart/.local/lib/ai-memory/ai-memory
  su -s /bin/bash fsd-stuart -c "AI_MEMORY_AUTH_TOKEN= $cmd" </dev/null >/dev/null 2>&1
  check K12 "o argv do hook não tem o token nem --auth-token" bash -c "[ -s /tmp/k12-argv ] && ! grep -qF \"\$(cat $D/auth-token)\" /tmp/k12-argv && ! grep -q -- --auth-token /tmp/k12-argv"
  rm -rf /home/fsd-stuart/.local/lib /tmp/k12-argv; [ -e /home/fsd-stuart/.local/lib.k12 ] && mv /home/fsd-stuart/.local/lib.k12 /home/fsd-stuart/.local/lib
fi
# K14 (F4.8): o modelo de cada papel vem do agents.json, no perfil do root.
if command -v jq >/dev/null && [ -n "${FSD_SIM_TEAM:-}" ]; then
  for r in "${ROLES[@]}"; do check K14 "o perfil do $r tem o modelo do agents.json" bash -c "[ \"\$(jq -r .model /etc/fsd/profiles/$r/settings.json)\" = \"\$(jq -r '.agents.$r.claude.model' $FSD_SIM_TEAM/agents.json)\" ]"; done
fi
# K15 (E6): o fsd-native-setup. O team/ que roda (hooks, perfis, wrappers) é uma cópia fixada do root, que nenhum papel grava; o
# session.env aponta para ela; as ferramentas chegam aos usuários de sistema. (A simulação monta a raiz em /srv/native.)
if [ -d /srv/native ]; then
  N=/srv/native; sha=$(cat $N/TEAM_SHA)
  check K15 "a cópia fixada é do root, sem escrita de grupo, e /srv/native/team aponta para ela" bash -c "[ \"\$(readlink -f $N/team)\" = $N/team-$sha ] && [ -z \"\$(find $N/team-$sha \\( \\! -user root -o \\( \\! -type l -perm /022 \\) \\) -print -quit)\" ]"
  for r in "${ROLES[@]}"; do check K15 "fsd-$r não grava o código que roda" cannot "fsd-$r" "echo x >> $N/team/bin/fsd-session-hook"; done
  check K15 "o session.env aponta o TEAM para a cópia fixada" grep -qx "TEAM=$N/team" /etc/fsd/session.env
  check K15 "o repositório dos papéis está preparado (fsd-repo)" bash -c "[ \"\$(git -C $N/repo config core.sharedRepository)\" = group ]"
  check K15 "node e claude para os usuários de sistema" bash -c "su -s /bin/bash fsd-mel -c 'node -e 0 && claude --help >/dev/null'"
  check K15 "o ai-memory na home de cada papel (caminho dos hooks)" bash -c "for r in kevin mel stuart bob; do su -s /bin/bash fsd-\$r -c \"test -x /home/fsd-\$r/.local/lib/ai-memory/ai-memory\" || exit 1; done"
fi
# K16 (F2.5): o Bash de cada papel no sandbox do claude, sem saída para fora dele, com a credencial e os tokens do ai-memory negados à
# leitura e a internet livre; só o fsd-qa do Bob fica fora (o sudo para o fsd-run não roda com no_new_privs; o guard o quer sozinho).
if command -v jq >/dev/null; then
  for r in "${ROLES[@]}"; do
    check K16 "o perfil do $r liga o sandbox, sem comando fora dele, e nega a credencial" jq -e '.sandbox.enabled == true and .sandbox.allowUnsandboxedCommands == false and .sandbox.failIfUnavailable == true and (.sandbox.filesystem.denyRead | index("~/.claude/.credentials.json")) and (.sandbox.network.allowedDomains == ["*"])' "/etc/fsd/profiles/$r/settings.json"
  done
  check K16 "só o fsd-qa do Bob fica fora do sandbox" bash -c "[ \"\$(jq -c .sandbox.excludedCommands /etc/fsd/profiles/bob/settings.json)\" = '[\"fsd-qa *\"]' ] && for r in kevin mel stuart; do [ \"\$(jq -c '.sandbox.excludedCommands // []' /etc/fsd/profiles/\$r/settings.json)\" = '[]' ] || exit 1; done"
fi
# K18 (validação R1, R2, R12 e R34): o estado entre os uids, de ponta a ponta e sem token. Cada papel tem a pasta dele em
# /var/lib/fsd-state; o Stuart manda uma mensagem à Mel; o supervisor roda uma rodada como fsd-dispatch (pelo wrapper, com o GitHub e o
# quadro falsos) e a Mel recebe pelo hook da sessão dela; com a Mel trabalhando, a mensagem seguinte vai para a caixa, sem turno novo
# (o turno dela não é cortado); com o PAUSE do time, nenhum turno sai.
if [ -x /usr/local/sbin/fsd-session-exec ] && [ -n "${FSD_SIM_TEAM:-}" ] && command -v getfacl >/dev/null; then
  SR=/var/lib/fsd-state; T=$FSD_SIM_TEAM/bin
  for r in "${ROLES[@]}"; do
    check K18 "a pasta de estado do $r é dele, do grupo fsd-dispatch, 2770, com a ACL padrão" bash -c "[ \"\$(stat -c '%U %G %a' $SR/$r)\" = 'fsd-$r fsd-dispatch 2770' ] && getfacl -p $SR/$r 2>/dev/null | grep -qx 'default:group:fsd-dispatch:rwx' && getfacl -p $SR/$r 2>/dev/null | grep -qx 'default:user:fsd-$r:rwx'"
  done
  check K18 "a Mel não entra na pasta de estado do Stuart" cannot fsd-mel "ls $SR/stuart"
  check K18 "a Mel não cria o PAUSE do time nem cria pasta na raiz" bash -c "! su -s /bin/bash fsd-mel -c 'touch $SR/PAUSE' 2>/dev/null && ! su -s /bin/bash fsd-mel -c 'mkdir $SR/x' 2>/dev/null"
  # O ambiente das partes: o supervisor como no fsd-svc (FSD_SESSION_VIA=sudo, FSD_STATE_ROOT), com o GitHub e o quadro falsos.
  KD=/home/fsd-dispatch/k18; rm -rf "$KD"; install -d -o fsd-dispatch -g fsd-dispatch -m 0700 "$KD"
  echo '{}' > "$KD/gh.json"; echo '{}' > "$KD/board.json"; chown fsd-dispatch: "$KD/gh.json" "$KD/board.json"
  disp() { su -s /bin/bash fsd-dispatch -c "cd ~ && FSD_SESSION_VIA=sudo FSD_STATE_ROOT=$SR FSD_STATE=$KD/st FSD_GH=$FSD_SIM_TEAM/setup/fake-gh FAKE_GH_STATE=$KD/gh.json FSD_BOARD_FAKE=$KD/board.json FSD_RUNNER=session node $T/fsd-dispatch round" 2>&1; }
  diga() { su -s /bin/bash fsd-stuart -c "FSD_AGENT=stuart FSD_STATE=$SR/stuart FSD_STATE_ROOT=$SR node $T/fsd-diga mel '$1' --urgente" >/dev/null 2>&1; }
  stubenv() { local d; d=/tmp/stub-claude-$(id -u fsd-mel); install -d -o fsd-mel -g fsd-mel -m 0700 "$d"; echo "$1" > "$d/env.json"; chmod 644 "$d/env.json"; }
  sjm=/tmp/stub-claude-$(id -u fsd-mel)/state.json
  stubenv '{"STUB_RUN_HOOKS":"1"}'
  has_out() { compgen -G "$SR/stuart/outbox/stuart/*.json" >/dev/null; }
  diga 'k18 primeira'
  check K18 "o Stuart grava a mensagem no próprio outbox" has_out
  check K18 "a Mel não grava no outbox do Stuart (o remetente é o dono do arquivo, A4)" cannot fsd-mel "touch $SR/stuart/outbox/stuart/forjada.json"
  round_ok() { grep -q ', 1 feita(s)$' <<<"$1"; }
  got() { jq -e --arg t "$1" '[.sessions[] | select(.agent == "mel") | (.prompts[]?, .context[]?.out)] | any(contains($t))' "$sjm" >/dev/null; }
  out1=$(disp)
  check K18 "a rodada do supervisor (fsd-dispatch, pelo wrapper) abre o turno da Mel" round_ok "$out1"
  check K18 "a Mel recebeu a mensagem do Stuart (no texto do turno, R23)" got 'stuart: [urgente] k18 primeira'
  check K18 "o outbox do Stuart ficou vazio (entregue uma vez)" bash -c "! compgen -G '$SR/stuart/outbox/stuart/*.json' >/dev/null"
  check K18 "o estado do hook da Mel está na pasta dela, é dela e o supervisor o lê" bash -c "[ \"\$(stat -c %U $SR/mel/session-state/mel.json)\" = fsd-mel ] && su -s /bin/bash fsd-dispatch -c 'cat $SR/mel/session-state/mel.json' | grep -q '\"state\":\"idle\"'"
  # A Mel num turno que não acaba (STUB_WORKING): a próxima mensagem abre o turno; a seguinte vai para a caixa, sem cortar o turno.
  stubenv '{"STUB_RUN_HOOKS":"1","STUB_WORKING":"1"}'
  diga 'k18 segunda'; disp >/dev/null
  check K18 "o supervisor vê a Mel trabalhando (estado do hook dela, sessão pelo wrapper)" bash -c "su -s /bin/bash fsd-dispatch -c 'cd ~ && FSD_SESSION_VIA=sudo FSD_STATE_ROOT=$SR FSD_STATE=$KD/st node $T/fsd-session status --json' 2>/dev/null | grep -q '\"mel\":{\"state\":\"working\"'"
  turns() { jq '[.calls[] | select(index("--bg"))] | length' "$sjm"; }
  to_inbox() { [ "$(turns)" = "$1" ] && grep -q 'k18 terceira' "$SR/mel/inbox/mel" && round_ok "$2"; }
  n0=$(turns); diga 'k18 terceira'; out3=$(disp)
  check K18 "com a Mel trabalhando, a mensagem vai para a caixa dela e nenhum turno novo sai" to_inbox "$n0" "$out3"
  # PAUSE único do time (R12): na raiz, criado pelo autor (root); nenhum turno novo sai, a mensagem espera no outbox.
  stubenv '{"STUB_RUN_HOOKS":"1"}'; su -s /bin/bash fsd-mel -c "FSD_AGENT=mel FSD_RUNNER=session FSD_STATE=$SR/mel FSD_STATE_ROOT=$SR $T/fsd-session-hook" <<<'{"hook_event_name":"Stop","session_id":"x"}' >/dev/null 2>&1
  touch $SR/PAUSE; n1=$(turns); diga 'k18 quarta'; disp >/dev/null
  held() { [ "$(turns)" = "$1" ] && has_out; }
  check K18 "com o PAUSE do time, nenhum turno sai e a mensagem fica no outbox" held "$n1"
  rm -f "$SR/PAUSE"
  # R23: o turno não abre (claude sem login): a mensagem fica no outbox e sai na rodada seguinte, que abre.
  stubenv '{"STUB_RUN_HOOKS":"1","STUB_NOT_LOGGED_IN":"1"}'; outf=$(disp)
  failed_kept() { grep -q 'falharam' <<<"$1" && has_out; }
  check K18 "R23: turno que não abre não consome a mensagem (fica no outbox)" failed_kept "$outf"
  stubenv '{"STUB_RUN_HOOKS":"1"}'; outa=$(disp)
  check K18 "R23: a rodada seguinte abre o turno e a Mel recebe a mensagem que esperava" bash -c "grep -q ', 1 feita(s)\$' <<<'$outa' && jq -e '[.sessions[] | select(.agent == \"mel\") | .prompts[]?] | any(contains(\"k18 quarta\"))' $sjm >/dev/null"
  # R25: uma cópia da Mel ligada fora da conversa gravada (o --bg subiu e ninguém gravou) é parada na rodada.
  echo x > /tmp/k18-prompt; chmod 644 /tmp/k18-prompt
  oid=$(su -s /bin/bash fsd-dispatch -c "sudo -n -u fsd-mel /usr/local/sbin/fsd-session-exec start /tmp/k18-prompt" 2>/dev/null | sed -n 's/^backgrounded · \([0-9a-f]*\).*/\1/p')
  outo=$(disp)
  orphan_stopped() { grep -q "cópia órfã de mel ($1) parada" <<<"$2" && ! jq -e --arg id "$1" '.sessions[] | select(.id == $id) | .alive' "$sjm" | grep -q true; }
  check K18 "R25: a cópia órfã da Mel é parada pelo supervisor" orphan_stopped "$oid" "$outo"
  # R12: o rate limit numa sessão do Bob pede a pausa na pasta dele; a rodada liga o PAUSE do time.
  su -s /bin/bash fsd-bob -c "FSD_AGENT=bob FSD_RUNNER=session FSD_STATE=$SR/bob FSD_STATE_ROOT=$SR node $T/fsd-usage.mjs stop-failure" >/dev/null 2>&1
  check K18 "R12: o StopFailure do Bob pede a pausa na pasta dele (não grava a raiz)" bash -c "[ -f $SR/bob/PAUSE.request ] && [ ! -e $SR/PAUSE ]"
  disp >/dev/null
  check K18 "R12: o supervisor aplica o pedido no PAUSE do time e apaga o pedido" bash -c "[ -f $SR/PAUSE ] && [ -f $SR/PAUSE.usage ] && [ ! -e $SR/bob/PAUSE.request ]"
  # R28: o juiz roda como o Kevin pelo verbo judge do wrapper (só como fsd-kevin), e o supervisor lê o resultado e avisa o Kevin.
  echo '[]' > /tmp/k18-waits.json; chmod 644 /tmp/k18-waits.json
  jout=$(su -s /bin/bash fsd-dispatch -c "sudo -n -u fsd-kevin /usr/local/sbin/fsd-session-exec judge 77 /tmp/k18-waits.json" 2>&1); jrc=$?
  judged_as_kevin() { [ "$1" != 1 ] && [ "$1" != 2 ] && ! grep -q 'only kevin' <<<"$2"; }
  check K18 "R28: o juiz roda como o Kevin pelo wrapper (passa a checagem do papel)" judged_as_kevin "$jrc" "$jout"
  check K18 "R28: o verbo judge recusa outro papel" cannot fsd-dispatch "sudo -n -u fsd-mel /usr/local/sbin/fsd-session-exec judge 77 /tmp/k18-waits.json"
  JD=$KD/st/dispatch/judge; install -d -o fsd-dispatch -g fsd-dispatch -m 0700 "$JD"
  printf '{"#77":{"at":%s,"state":"running"}}' "$(date +%s%3N)" > "$KD/st/dispatch/judging.json"; echo 0 > "$JD/77.done"
  printf 'fsd-judge: author decision needed (low confidence)\n**Deadlock: author decision needed**\nk18-comentario\n' > "$JD/77.out"; chown -R fsd-dispatch: "$KD/st/dispatch"
  disp >/dev/null
  judge_reported() { grep -q 'k18-comentario' "$SR/kevin/inbox/kevin" && jq -e 'index("#77")' "$KD/st/dispatch/judged.json" >/dev/null && [ ! -e "$JD/77.done" ]; }
  check K18 "R28: a resposta do juiz chega ao Kevin (comentário do autor) e o ref fica julgado só depois dela" judge_reported
  # R31: o fsd-eval --real como o supervisor: a situação vai para a pasta da Mel, a sessão sobe pelo wrapper, o eval espera o Stop da
  # conversa nova, lê a transcrição pelo verbo transcript e as mensagens pela pasta dela (o stub faz o papel do claude).
  printf '[{"bash":"fsd-diga kevin k18-eval-real"}]' > /tmp/k18-play.json; chmod 644 /tmp/k18-play.json
  printf '{"id":"k18-real","role":"mel","behaviors":[],"setup":{"prompt":"diga ao kevin"},"expect":{"messages":[{"to":"kevin","match":"k18-eval-real"}],"commands":{"must":["fsd-diga kevin"]}}}' > /tmp/k18-sc.json; chmod 644 /tmp/k18-sc.json
  stubenv '{"STUB_RUN_HOOKS":"1","STUB_PLAY":"/tmp/k18-play.json","STUB_HOME_TRANSCRIPT":"1"}'
  eout=$(su -s /bin/bash fsd-dispatch -c "cd ~ && FSD_STATE_ROOT=$SR FSD_EVAL_POLL_MS=200 FSD_EVAL_TIMEOUT_S=30 node $T/fsd-eval run /tmp/k18-sc.json --real" 2>&1)
  eval_real_ok() { grep -q '^PASS mel' <<<"$1" && ! compgen -G "$SR/mel/outbox/mel/*.json" >/dev/null; }
  check K18 "R31: o eval --real espera o Stop, lê a transcrição pelo wrapper e acha a mensagem da Mel (e não a deixa no outbox)" eval_real_ok "$eout"
  rm -f "$SR/PAUSE" "$SR/PAUSE.usage" "/tmp/stub-claude-$(id -u fsd-mel)/env.json" /tmp/k18-waits.json /tmp/k18-play.json /tmp/k18-sc.json
fi
# K19 (validação R14/R47): o cwd da sessão é uma pasta do root, só leitura para o papel, fora do checkout compartilhado; com .claude/ ou
# CLAUDE*.md nela a sessão não sobe; a confiança da pasta fica no .claude.json do papel; o .git compartilhado tem escrita no sandbox.
if [ -x /usr/local/sbin/fsd-session-exec ] && command -v jq >/dev/null; then
  CR=$(grep -E '^CWD_ROOT=' /etc/fsd/session.env | cut -d= -f2)
  echo x > /tmp/k19-prompt; chmod 644 /tmp/k19-prompt
  for r in "${ROLES[@]}"; do check K19 "o cwd do $r é do root, 0755, com o .ai-memory.toml" bash -c "[ \"\$(stat -c '%U %a' $CR/$r)\" = 'root 755' ] && [ -f $CR/$r/.ai-memory.toml ]"; done
  check K19 "o Stuart não grava .claude/ nem CLAUDE.local.md no cwd dele nem no de outro" bash -c "! su -s /bin/bash fsd-stuart -c 'mkdir $CR/stuart/.claude' 2>/dev/null && ! su -s /bin/bash fsd-stuart -c 'touch $CR/mel/CLAUDE.local.md' 2>/dev/null"
  su -s /bin/bash fsd-dispatch -c "sudo -n -u fsd-stuart /usr/local/sbin/fsd-session-exec start /tmp/k19-prompt" >/dev/null 2>&1
  sj19=/tmp/stub-claude-$(id -u fsd-stuart)/state.json
  k19_cwd() { jq -e --arg c "$CR/stuart" '[.sessions[] | select(.agent == "stuart")] | last | .cwd == $c' "$sj19" >/dev/null; }
  check K19 "a sessão do Stuart sobe no cwd do root, fora do checkout" k19_cwd
  check K19 "R47: a confiança do cwd está no .claude.json do Stuart" bash -c "jq -e --arg c '$CR/stuart' '.projects[\$c].hasTrustDialogAccepted == true' /home/fsd-stuart/.claude.json >/dev/null"
  mkdir "$CR/mel/.claude"
  check K19 "com .claude/ no cwd, a sessão da Mel não sobe" bash -c "! su -s /bin/bash fsd-dispatch -c 'sudo -n -u fsd-mel /usr/local/sbin/fsd-session-exec start /tmp/k19-prompt' 2>&1 | grep -q backgrounded"
  rmdir "$CR/mel/.claude"
  for r in "${ROLES[@]}"; do check K19 "o perfil do $r dá escrita ao clone do papel no sandbox (R18) e nega Write/Edit no checkout" jq -e '(.sandbox.filesystem.allowWrite | index("~/repo")) and (.permissions.deny | index("Write(//srv/fsd/repo/**)")) and (.permissions.deny | index("Edit(//srv/fsd/repo/**)"))' "/etc/fsd/profiles/$r/settings.json"; done
fi
# K20 (validação R20, R37, R39, R19): o fsd-run sem processo de um PR para o seguinte; as ferramentas dos papéis são cópias do root; o
# prompt da sessão não aparece no argv; o time só sobe no FSD_TEAM_SHA.
if [ -x /usr/local/sbin/fsd-run-exec ]; then
  RX="sudo -n -u fsd-run /usr/local/sbin/fsd-run-exec"
  install -d -o fsd-run -g fsd-run -m 0700 /var/lib/fsd-run/qa/k20a /var/lib/fsd-run/qa/k20a/work /var/lib/fsd-run/qa/k20a/home
  su -s /bin/bash fsd-bob -c "$RX run k20a -- 'setsid sleep 300 </dev/null >/dev/null 2>&1 &'" >/dev/null 2>&1
  left_before() { pgrep -u fsd-run -x sleep >/dev/null; }
  check K20 "R20: um processo deixado pelo item segue vivo (o cenário do ataque)" left_before
  su -s /bin/bash fsd-bob -c "$RX clean k20a" >/dev/null 2>&1
  clean_ok() { ! pgrep -u fsd-run >/dev/null && [ -z "$(ls -A /var/lib/fsd-run/qa)" ]; }
  check K20 "R20: o clean mata todo processo do fsd-run e apaga a área inteira" clean_ok
fi
if [ -d /srv/native ]; then
  for t in node claude; do check K20 "R37: o $t dos papéis é uma cópia do root, sem escrita de outro" bash -c "f=\$(readlink -f /usr/local/bin/$t); [ \"\${f#/opt/fsd-native/}\" != \"\$f\" ] && [ \"\$(stat -c %U \$f)\" = root ] && [ -z \"\$(find \$f -perm /022)\" ]"; done
  check K20 "R37: o ai-memory dos papéis aponta para a cópia do root" bash -c "[ \"\$(readlink /home/fsd-mel/.local/lib/ai-memory)\" = /opt/fsd-native/ai-memory ] && [ \"\$(stat -c %U /opt/fsd-native/ai-memory/ai-memory)\" = root ]"
  pin_refused() { local o; o=$(FSD_TEAM_SRC=/tmp/src FSD_TEAM_REF=HEAD FSD_TEAM_SHA=0000000000000000000000000000000000000000 FSD_NATIVE_ROOT=/tmp/k20-native bash /tmp/src/team/setup/container/fsd-native-setup 2>&1); grep -q 'não no FSD_TEAM_SHA' <<<"$o" && [ ! -d /tmp/k20-native/repo ]; }
  check K20 "R19: com FSD_TEAM_SHA diferente da ref, o setup recusa antes de tudo" pin_refused
fi
if [ -x /usr/local/sbin/fsd-session-exec ]; then
  printf '%s\n' 'segredo-do-cartao-k20' > /tmp/k20-prompt; chmod 644 /tmp/k20-prompt
  su -s /bin/bash fsd-dispatch -c "sudo -n -u fsd-bob /usr/local/sbin/fsd-session-exec start /tmp/k20-prompt" >/dev/null 2>&1
  sjb=/tmp/stub-claude-$(id -u fsd-bob)/state.json
  argv_clean() { jq -e '[.sessions[] | select(.agent == "bob")] | last | (.prompts[-1] == "segredo-do-cartao-k20") and ((.args | index("segredo-do-cartao-k20")) | not)' "$sjb" >/dev/null; }
  check K20 "R39: o prompt chega à sessão pelo stdin, fora do argv" argv_clean
fi
# K13 (F0.2, T0.2.2): o aceite do bypass em --bg vem das managed settings do root, que nenhum papel edita.
if command -v jq >/dev/null; then
  check K13 "managed settings do root com o aceite do bypass" bash -c "[ \"\$(stat -c '%U %a' /etc/claude-code/managed-settings.json)\" = 'root 644' ] && jq -e '.skipDangerousModePermissionPrompt == true' /etc/claude-code/managed-settings.json >/dev/null"
  for r in "${ROLES[@]}"; do check K13 "fsd-$r não edita as managed settings" cannot "fsd-$r" "echo x >> /etc/claude-code/managed-settings.json"; done
fi
[ $fail = 0 ] && echo "k-checks: tudo ok" || echo "k-checks: há falhas"
exit $fail
