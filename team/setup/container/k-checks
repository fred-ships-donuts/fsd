#!/usr/bin/env bash
# k-checks — verificações K do isolamento do time nativo (F2.0). Rode como root dentro do container; sai 0 só sem falha.
# Cada linha: ok/FALHA <id> <o que>. Cresce com a E2 (repositório, broker, fsd-run, token oculto).
set -uo pipefail
ROLES=(kevin mel stuart bob); fail=0
ok() { echo "ok    $1 $2"; }; bad() { echo "FALHA $1 $2"; fail=1; }
# shellcheck disable=SC2329  # as funções são chamadas por check "$@"
can() { su -s /bin/bash "$1" -c "$2" >/dev/null 2>&1; }   # can <usuário> <comando>: 0 se o usuário consegue
cannot() { ! can "$@"; }   # cannot <usuário> <comando>: 0 se o usuário NÃO consegue (no mesmo processo, nunca num bash -c)
check() { local id=$1 what=$2; shift 2; if "$@"; then ok "$id" "$what"; else bad "$id" "$what"; fi; }
no_edit() { cannot "$1" "echo x >> $2/settings.json" && cannot "$1" "touch $2/novo"; }
for u in "${ROLES[@]/#/fsd-}" fsd-run fsd-dispatch fsd-broker; do
  check K1 "$u existe e não é root" bash -c "id $u >/dev/null && [ \$(id -u $u) != 0 ]"
  check K2 "home de $u é 0700 e do dono" bash -c "[ \$(stat -c %a /home/$u) = 700 ] && [ \$(stat -c %U /home/$u) = $u ]"
done
echo s > /home/fsd-stuart/segredo; chown fsd-stuart: /home/fsd-stuart/segredo; chmod 600 /home/fsd-stuart/segredo
check K3 "fsd-stuart lê a própria home" can fsd-stuart "cat /home/fsd-stuart/segredo"
for u in fsd-mel fsd-bob fsd-kevin fsd-run fsd-dispatch; do check K3 "$u não lê a home do fsd-stuart" cannot "$u" 'ls /home/fsd-stuart'; done
check K3 "fsd-stuart não lê a home do broker" cannot fsd-stuart 'ls /home/fsd-broker'
for r in "${ROLES[@]}"; do
  p=/etc/fsd/profiles/$r
  check K4 "perfil do $r é do root" bash -c "[ \$(stat -c %U $p) = root ] && [ \$(stat -c %U $p/settings.json) = root ]"
  check K4 "fsd-$r lê o próprio perfil" can "fsd-$r" "cat $p/settings.json"
  check K4 "fsd-$r não edita o próprio perfil" no_edit "fsd-$r" "$p"
done
check K5 "fsd-run fora do grupo do repositório" bash -c "! id -nG fsd-run | tr ' ' '\n' | grep -qx fsd"
for r in "${ROLES[@]}"; do check K5 "fsd-$r no grupo fsd" bash -c "id -nG fsd-$r | tr ' ' '\n' | grep -qx fsd"; done
check K6 "o humano (root aqui) não ganha o umask do time" bash -c "[ \"\$(bash -lc umask)\" != 0077 ]"
check K6 "umask 077 numa sessão de login do papel" bash -c "[ \"\$(su -l -s /bin/bash fsd-mel -c umask)\" = 0077 ]"
su -l -s /bin/bash fsd-mel -c 'echo s > /tmp/k6-mel'
check K6 "arquivo novo da Mel no /tmp não é lido pelo Stuart" cannot fsd-stuart 'cat /tmp/k6-mel'
# K7 (F2.2, A6): o repositório entre uids. FSD_SIM_REPO = um clone preparado pelo fsd-repo (o Dockerfile.sim monta um, com um
# remoto bare local que o grupo grava).
if [ -n "${FSD_SIM_REPO:-}" ]; then
  R=$FSD_SIM_REPO; inrepo() { su -s /bin/bash "$1" -c "umask 007; cd $R && $2" >/dev/null 2>&1; }; notrepo() { ! inrepo "$@"; }
  check K7 "papel não grava alias no .git/config" notrepo fsd-stuart "git config alias.x '!id'"
  check K7 "papel não muda core.hooksPath" notrepo fsd-stuart "git config core.hooksPath /tmp"
  check K7 "papel não planta hook" notrepo fsd-mel "echo id > .git/hooks/pre-commit"
  su -s /bin/bash fsd-mel -c "cd $R && git config --file .git/config.worktree alias.y '!touch /tmp/k7-pwned'" >/dev/null 2>&1
  check K7 "config.worktree é ignorado (alias plantado não roda)" bash -c "! su -s /bin/bash fsd-stuart -c 'cd $R && git y' >/dev/null 2>&1 && [ ! -e /tmp/k7-pwned ]"
  W=/home/fsd-stuart/wt/fix-1-x
  check K7 "papel busca sem FETCH_HEAD" inrepo fsd-stuart "git fetch -q --no-write-fetch-head origin develop"
  check K7 "papel cria o worktree na própria home" inrepo fsd-stuart "mkdir -p /home/fsd-stuart/wt && git worktree add -q --no-track -b fix/1-x $W origin/develop"
  check K7 "commit no worktree funciona" inrepo fsd-stuart "cd $W && echo b > b && git add b && git -c user.email=s@s -c user.name=s commit -qm b"
  check K7 "push do branch funciona" inrepo fsd-stuart "cd $W && git push -q origin fix/1-x"
  check K7 "outro papel não lê o worktree do Stuart" notrepo fsd-mel "ls $W"
  check K7 "o supervisor busca, compacta as refs e apaga branch" inrepo fsd-dispatch "git fetch -q origin && git pack-refs --all && git worktree prune && git branch -D fix/1-x"
  check K7 ".git/config segue fora do alcance dos papéis" notrepo fsd-bob "git config alias.z '!id'"
fi
# K8 (F2.3, C1): o broker. FSD_SIM_TEAM = o team/bin e o agents.json dentro da imagem (tokens falsos, sem chave nem rede).
if [ -n "${FSD_SIM_TEAM:-}" ]; then
  T=$FSD_SIM_TEAM/bin; asu() { su -s /bin/bash "$1" -c "$2" 2>/dev/null; }
  su -s /bin/bash fsd-broker -c "FSD_BROKER_FAKE=1 node $T/fsd-broker once" >/dev/null 2>&1
  check K8 "o broker gravou o token de cada papel e o do supervisor" bash -c "for r in kevin mel stuart bob dispatch; do [ -s /var/lib/fsd-tokens/\$r/token ] || exit 1; done"
  perm_is() { [ "$(stat -c '%a %G' "$1")" = "$2" ]; }
  check K8 "token do papel é 0440 e do grupo do papel" perm_is /var/lib/fsd-tokens/stuart/token '440 fsd-stuart'
  check K8 "Stuart lê o próprio token pelo usuário Unix" bash -c "asu() { su -s /bin/bash \"\$1\" -c \"\$2\" 2>/dev/null; }; asu fsd-stuart '$T/fsd-token-file' | grep -q '^fake-stuart-repo-'"
  check K8 "C1: FSD_AGENT=mel não muda a identidade do Stuart" bash -c "su -s /bin/bash fsd-stuart -c 'FSD_AGENT=mel FSD_RUNNER=session $T/fsd-token-file' 2>/dev/null | grep -q '^fake-stuart-repo-'"
  check K8 "Stuart não lê o token da Mel" cannot fsd-stuart "cat /var/lib/fsd-tokens/mel/token"
  check K8 "Stuart não lê o token do supervisor" cannot fsd-stuart "cat /var/lib/fsd-tokens/dispatch/token"
  check K8 "Stuart não lê as chaves dos Apps" cannot fsd-stuart "ls /var/lib/fsd-broker/keys"
  check K8 "Stuart não reescreve o próprio token" cannot fsd-stuart "echo x > /var/lib/fsd-tokens/stuart/token"
  check K8 "o supervisor lê o token de merge e não o do Stuart" bash -c "su -s /bin/bash fsd-dispatch -c 'cat /var/lib/fsd-tokens/dispatch/token' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c 'cat /var/lib/fsd-tokens/stuart/token' >/dev/null 2>&1"
  check K8 "fsd-run não lê token nenhum" cannot fsd-run "cat /var/lib/fsd-tokens/bob/token"
  printf '#!/bin/sh\necho "$GH_TOKEN"\n' > /usr/local/bin/fake-gh; chmod 755 /usr/local/bin/fake-gh
  check K8 "gh (wrapper) na sessão nova usa o token do usuário, com FSD_AGENT de outro" bash -c "su -s /bin/bash fsd-stuart -c 'FSD_RUNNER=session FSD_AGENT=mel FSD_REAL_GH=/usr/local/bin/fake-gh $T/gh pr list' 2>/dev/null | grep -q '^fake-stuart-repo-'"
  check K8 "git-credential-fsd na sessão nova dá o token do usuário" bash -c "printf 'protocol=https\nhost=github.com\n\n' | su -s /bin/bash fsd-stuart -c 'FSD_RUNNER=session FSD_AGENT=mel $T/git-credential-fsd get' 2>/dev/null | grep -q '^password=fake-stuart-repo-'"
fi
# K9 (F2.4, A2): o código do PR roda como fsd-run, sem o ambiente de quem chamou, e o exit vem de arquivo do Bob, não da tela.
if [ -x /usr/local/sbin/fsd-run-exec ]; then
  RX="sudo -n -u fsd-run /usr/local/sbin/fsd-run-exec"
  install -d -o fsd-run -g fsd-run -m 0700 /var/lib/fsd-run/qa/k9 /var/lib/fsd-run/qa/k9/work /var/lib/fsd-run/qa/k9/home
  check K9 "o Bob roda um comando como fsd-run" bash -c "su -s /bin/bash fsd-bob -c '$RX run k9 -- id -un' 2>/dev/null | grep -qx fsd-run"
  check K9 "o Stuart não usa o fsd-run" cannot fsd-stuart "$RX run k9 -- id -un"
  check K9 "o Bob não vira fsd-run para outra coisa" cannot fsd-bob "sudo -n -u fsd-run id"
  check K9 "A2: postinstall/código do PR não vê o ambiente do Bob (token, FSD_*)" bash -c "out=\$(su -s /bin/bash fsd-bob -c 'GH_TOKEN=s3cr3t FSD_AGENT=bob FSD_TOKEN_DIR=/x $RX run k9 -- env' 2>/dev/null); [ -n \"\$out\" ] && ! grep -qE 's3cr3t|^FSD_|^GH_TOKEN' <<<\"\$out\""
  check K9 "o código do PR não lê o token do Bob" bash -c "! su -s /bin/bash fsd-bob -c '$RX run k9 -- cat /var/lib/fsd-tokens/bob/token' >/dev/null 2>&1"
  su -s /bin/bash fsd-bob -c "mkdir -p ~/qa && chmod 700 ~/qa; $RX run k9 -- 'echo __EXIT=0; exit 3'; echo \$? > ~/qa/exit.k9" >/dev/null 2>&1
  check K9 "o exit vem do arquivo do Bob: __EXIT=0 impresso não vira 0" bash -c "[ \"\$(cat /home/fsd-bob/qa/exit.k9)\" = 3 ]"
  check K9 "o fsd-run não escreve o arquivo de exit do Bob" cannot fsd-run "echo 0 > /home/fsd-bob/qa/exit.k9"
  check K9 "prep recusa url fora do GitHub e sha inválido" bash -c "! su -s /bin/bash fsd-bob -c '$RX prep k9 file:///srv/origin.git 0123' >/dev/null 2>&1"
fi
# K10 (F2.6): o supervisor controla só as sessões dos papéis, só pelo wrapper e como cada papel (stub-claude no lugar do claude).
if [ -x /usr/local/sbin/fsd-session-exec ]; then
  SX="sudo -n -u fsd-stuart /usr/local/sbin/fsd-session-exec"; U=11111111-2222-3333-4444-555555555555
  echo "tarefa" > /tmp/k10-prompt; chmod 644 /tmp/k10-prompt
  check K10 "o supervisor lista as sessões do Stuart como o Stuart" bash -c "su -s /bin/bash fsd-dispatch -c '$SX agents' 2>/dev/null | grep -q '^\['"
  check K10 "o supervisor sobe a sessão do Stuart (como fsd-stuart, FSD_RUNNER=session)" bash -c "su -s /bin/bash fsd-dispatch -c '$SX start $U /tmp/k10-prompt' >/dev/null 2>&1 && su -s /bin/bash fsd-dispatch -c '$SX agents' | grep -q '\"sessionId\": \"$U\"'"
  check K10 "a sessão subiu como o Stuart" bash -c "grep -q '\"agent\": \"stuart\"' /tmp/stub-claude/state.json 2>/dev/null || grep -rq '\"agent\": \"stuart\"' /tmp/stub-claude* 2>/dev/null"
  check K10 "o supervisor não roda outra coisa como o Stuart" cannot fsd-dispatch "sudo -n -u fsd-stuart id"
  check K10 "o supervisor não usa o wrapper como root nem como fsd-run" bash -c "! su -s /bin/bash fsd-dispatch -c 'sudo -n -u root /usr/local/sbin/fsd-session-exec agents' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c 'sudo -n -u fsd-run /usr/local/sbin/fsd-session-exec agents' >/dev/null 2>&1"
  check K10 "um papel não usa o wrapper para outro papel" cannot fsd-mel "sudo -n -u fsd-stuart /usr/local/sbin/fsd-session-exec agents"
  check K10 "fsd-session (como fsd-dispatch, FSD_SESSION_VIA=sudo) sobe a Mel e vê o estado dela" bash -c "su -s /bin/bash fsd-dispatch -c 'cd ~ && FSD_SESSION_VIA=sudo FSD_STATE=\$HOME/st node $FSD_SIM_TEAM/bin/fsd-session start mel \"tarefa #3\" >/dev/null && FSD_SESSION_VIA=sudo FSD_STATE=\$HOME/st node $FSD_SIM_TEAM/bin/fsd-session status --json' 2>/dev/null | grep -q '\"mel\":{\"state\":\"idle\"'"
  check K10 "o wrapper recusa id e uuid inválidos" bash -c "! su -s /bin/bash fsd-dispatch -c '$SX stop \"x;id\"' >/dev/null 2>&1 && ! su -s /bin/bash fsd-dispatch -c '$SX start not-a-uuid /tmp/k10-prompt' >/dev/null 2>&1"
fi
[ $fail = 0 ] && echo "k-checks: tudo ok" || echo "k-checks: há falhas"
exit $fail
