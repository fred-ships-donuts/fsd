#!/usr/bin/env bash
# fsd-native-setup — prepara o time nativo dentro do container (preparação da E6). Rode como root; idempotente. O entrypoint só chama
# com FSD_NATIVE=1, extraindo ESTE arquivo da ref fixada (não roda o checkout do humano, que ele grava).
#   1. team/ da ref fixa → /srv/fsd/team-<sha>, do root e sem escrita de grupo; /srv/fsd/team aponta para ela. Hooks, perfis, prompts e
#      wrappers saem daqui: um papel grava o repositório (grupo fsd), mas nunca o código que roda como ele ou como o root.
#   2. Repositório dos papéis em /srv/fsd/repo (clone da origem), preparado pelo fsd-repo.
#   3. fsd-users com os perfis da cópia fixada, os tokens do ai-memory (FSD_AIM_TOKENS_SRC) e o session.env.
#   4. node, claude e ai-memory acessíveis aos usuários de sistema (links para /opt/fsd, só leitura).
# Variáveis: FSD_TEAM_SRC (clone git com o time; obrigatória) · FSD_TEAM_REF (padrão origin/develop) · FSD_REPO_URL (padrão: o
#   origin do FSD_TEAM_SRC) · FSD_NATIVE_ROOT (padrão /srv/fsd) · FSD_NODE_BIN, FSD_CLAUDE_REAL, FSD_AIM_DIR (as ferramentas; padrão
#   as de /opt/fsd) · FSD_AIM_TOKENS_SRC (pasta com um aim_… por papel) · FSD_CLAUDE_TOKEN_SRC (token do `claude setup-token`) · FSD_BROKER_KEYS_SRC (as chaves .pem dos Apps) ·
#   FSD_NATIVE_PREFLIGHT (padrão 1).
# Saída: 0 pronto (imprime o sha) · 2 uso/ambiente · 1 falha de um passo.
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "fsd-native-setup: rode como root"; exit 2; }
SRC=${FSD_TEAM_SRC:?defina FSD_TEAM_SRC (o clone com o time)}; REF=${FSD_TEAM_REF:-origin/develop}; ROOT=${FSD_NATIVE_ROOT:-/srv/fsd}
git config --system --get-all safe.directory 2>/dev/null | grep -qxF "$SRC" || git config --system --add safe.directory "$SRC"
sha=$(git -C "$SRC" rev-parse --verify --quiet "$REF^{commit}") || { echo "fsd-native-setup: ref $REF não existe em $SRC"; exit 2; }
# Validação R19: com FSD_TEAM_SHA (team.env), o time só sobe se a ref apontar para esse commit (um ref movido no clone do humano não
# troca o código que o root roda).
if [ -n "${FSD_TEAM_SHA:-}" ] && [ "$sha" != "$FSD_TEAM_SHA" ]; then echo "fsd-native-setup: $REF está em ${sha:0:12}, não no FSD_TEAM_SHA ${FSD_TEAM_SHA:0:12}"; exit 2; fi
install -d -o root -g root -m 0755 "$ROOT"

# 1. A cópia fixada do team/, do root.
T="$ROOT/team-$sha"
if [ ! -d "$T" ]; then
  tmp=$(mktemp -d "$ROOT/.team-XXXXXX"); git -C "$SRC" archive "$sha" team | tar -x -C "$tmp"
  chown -R root:root "$tmp"; chmod -R u+rwX,go+rX,go-w "$tmp"; mv "$tmp/team" "$T"; rmdir "$tmp"
fi
ln -sfn "$T" "$ROOT/team.new" && mv -Tf "$ROOT/team.new" "$ROOT/team"
echo "$sha" > "$ROOT/TEAM_SHA"; chmod 0644 "$ROOT/TEAM_SHA"

# 2. O repositório dos papéis.
R="$ROOT/repo"
if [ ! -d "$R/.git" ]; then
  url=${FSD_REPO_URL:-$(git -C "$SRC" remote get-url origin)}
  git clone -q --no-hardlinks -b develop "$url" "$R"
fi
# 3. Usuários, perfis (da cópia fixada), sudoers, managed settings, tokens do ai-memory.
FSD_PROFILES_SRC="$ROOT/team/agents" FSD_TEAM_DIR="$ROOT/team" FSD_REPO_DIR="$R" FSD_CWD_ROOT="$ROOT/cwd" FSD_CLAUDE_BIN=/usr/local/bin/claude \
  FSD_NATIVE_PREFLIGHT="${FSD_NATIVE_PREFLIGHT:-1}" FSD_AIM_TOKENS_SRC="${FSD_AIM_TOKENS_SRC:-}" FSD_CLAUDE_TOKEN_SRC="${FSD_CLAUDE_TOKEN_SRC:-}" "$ROOT/team/setup/container/fsd-users"
"$ROOT/team/setup/container/fsd-repo" "$R"

# 4. Ferramentas para os usuários de sistema (sem o nvm nem o PATH do humano).
NODE=${FSD_NODE_BIN:-$(ls -d /opt/fsd/nvm/versions/node/v*/bin/node 2>/dev/null | head -1)}
CLAUDE=${FSD_CLAUDE_REAL:-/opt/fsd/claude/versions/$(cat /opt/fsd/CLAUDE_VERSION 2>/dev/null || echo x)}
AIM=${FSD_AIM_DIR:-/opt/fsd/ai-memory}
for x in "$NODE" "$CLAUDE" "$AIM/ai-memory"; do [ -x "$x" ] || { echo "fsd-native-setup: falta $x"; exit 1; }; done
# Validação R37: cópias do root (o /opt/fsd é do uid 1000, que as trocaria); o nvm e o npm -g do humano seguem como estão.
N=/opt/fsd-native; install -d -o root -g root -m 0755 "$N" "$N/bin"
install -o root -g root -m 0755 "$NODE" "$N/bin/node"; install -o root -g root -m 0755 "$CLAUDE" "$N/bin/claude"
rm -rf "$N/ai-memory.new"; cp -rL "$AIM" "$N/ai-memory.new"; chown -R root:root "$N/ai-memory.new"; chmod -R u+rwX,go+rX,go-w "$N/ai-memory.new"
rm -rf "$N/ai-memory"; mv "$N/ai-memory.new" "$N/ai-memory"; AIM=$N/ai-memory
ln -sfn "$N/bin/node" /usr/local/bin/node; ln -sfn "$N/bin/claude" /usr/local/bin/claude
# npm e npx dos papéis e do fsd-run (npm ci, build e testes no worktree): cópia do root do npm que vem com o mesmo node.
NPM=$(dirname "$(dirname "$NODE")")/lib/node_modules/npm
[ -f "$NPM/bin/npm-cli.js" ] || { echo "fsd-native-setup: falta o npm do node em $NPM"; exit 1; }
install -d -o root -g root -m 0755 "$N/lib" "$N/lib/node_modules"; rm -rf "$N/lib/node_modules/npm.new"; cp -rL "$NPM" "$N/lib/node_modules/npm.new"
chown -R root:root "$N/lib/node_modules/npm.new"; chmod -R u+rwX,go+rX,go-w "$N/lib/node_modules/npm.new"
rm -rf "$N/lib/node_modules/npm"; mv "$N/lib/node_modules/npm.new" "$N/lib/node_modules/npm"
for c in npm npx; do ln -sfn "../lib/node_modules/npm/bin/$c-cli.js" "$N/bin/$c"; ln -sfn "$N/bin/$c" "/usr/local/bin/$c"; done
# Motor do fsd-map: cópia do root já corrigida (o /opt/fsd é do uid 1000, e um papel não grava nem corrige nada lá).
if [ -d /opt/fsd/map/node_modules ]; then
  rm -rf "$N/map.new"; cp -rL /opt/fsd/map "$N/map.new"; chown -R root:root "$N/map.new"; chmod -R u+rwX,go+rX,go-w "$N/map.new"
  rm -rf "$N/map"; mv "$N/map.new" "$N/map"; mh=$(mktemp -d)
  FSD_MAP_PKG="$N/map" FSD_MAP_HOME="$mh" "$N/bin/node" "$ROOT/team/bin/fsd-map" engine || { echo "fsd-native-setup: o motor do fsd-map não ficou pronto"; exit 1; }
  rm -rf "$mh"
fi
# rtk dos hooks (validação R6): cópia do root em /usr/local/bin, não o /opt/fsd/bin do uid 1000.
RTK=${FSD_RTK_BIN:-/opt/fsd/bin/rtk}; [ -x "$RTK" ] && install -o root -g root -m 0755 "$RTK" /usr/local/bin/rtk
for r in kevin mel stuart bob; do
  h=/home/fsd-$r; install -d -o "fsd-$r" -g "fsd-$r" -m 0700 "$h/.local" "$h/.local/lib"
  ln -sfn "$AIM" "$h/.local/lib/ai-memory"; chown -h "fsd-$r:fsd-$r" "$h/.local/lib/ai-memory"
done
# 5. Chaves dos Apps para o broker (FSD_BROKER_KEYS_SRC=<pasta com <slug>.pem>): só o fsd-broker lê (0400).
if [ -n "${FSD_BROKER_KEYS_SRC:-}" ] && compgen -G "$FSD_BROKER_KEYS_SRC/*.pem" >/dev/null; then
  for k in "$FSD_BROKER_KEYS_SRC"/*.pem; do install -o fsd-broker -g fsd-broker -m 0400 "$k" "/var/lib/fsd-broker/keys/$(basename "$k")"; done
fi
echo "fsd-native-setup: time nativo em $ROOT (team ${sha:0:7}, repo $R)"
