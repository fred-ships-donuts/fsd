#!/usr/bin/env bash
# fsd-repo <repo> — o repositório do time entre uids (F2.2, T2.2.1; A6; validação R18). Rode como root depois do fsd-users; idempotente.
# Validação R18: cada papel trabalha num clone próprio, na home dele (0700): /home/fsd-<papel>/repo, criado com --shared a partir do
# <repo> (os objetos vêm dele, sem cópia) e com o origin no GitHub. O <repo> vira só o depósito de objetos: do fsd-dispatch, o grupo
# fsd só lê (nenhum papel troca index, HEAD, refs ou worktree de outro, nem planta hook ou alias), sem gc que apague objeto de que um
# clone dependa (gc.auto 0, gc.pruneExpire never). O .git/config, hooks/ e info/ seguem do root.
#   Os papéis buscam e empurram do próprio clone, com o token deles (o helper do GIT_CONFIG_GLOBAL do perfil).
set -euo pipefail
[ "$(id -u)" = 0 ] || { echo "fsd-repo: rode como root"; exit 2; }
R=${1:?uso: fsd-repo <repo>}; G=$R/.git
[ -d "$G" ] || { echo "fsd-repo: $R não é um clone (sem .git)"; exit 2; }
# Antes de qualquer git no <repo>: num container recriado com os mesmos volumes o <repo> já é do fsd-dispatch, e o git do root o recusa.
# O clone de cada papel lê o depósito pelo file:// (o .git dele é aberto como repositório): o .git também é seguro.
for d in "$R" "$G"; do grep -qxF "$d" <(git config --system --get-all safe.directory 2>/dev/null) || git config --system --add safe.directory "$d"; done
git -C "$R" config core.sharedRepository group
git -C "$R" config --unset-all extensions.worktreeConfig 2>/dev/null || true
git -C "$R" config gc.auto 0; git -C "$R" config gc.pruneExpire never
chown -R fsd-dispatch:fsd "$R"; chmod -R u+rwX,g+rX,g-w,o-rwx "$R"; find "$R" -type d -exec chmod g+s {} +
chmod 2750 "$G"
chown root:root "$G/config"; chmod 0644 "$G/config"
for d in hooks info; do mkdir -p "$G/$d"; chown -R root:root "$G/$d"; chmod 0755 "$G/$d"; find "$G/$d" -type f -exec chmod 0644 {} +; done
rm -f "$G/config.worktree"
# O clone de cada papel (R18): --shared (alternates para os objetos do <repo>), o origin no GitHub (o mesmo do <repo>), core.hooksPath
# vazio pelo gitconfig do perfil. Já existe: não mexe (o trabalho do papel está nele).
url=$(git -C "$R" remote get-url origin)
for r in kevin mel stuart bob; do
  id "fsd-$r" >/dev/null 2>&1 || continue
  c=/home/fsd-$r/repo
  rg() { runuser -u "fsd-$r" -- env HOME="/home/fsd-$r" git "$@"; }
  if [ ! -d "$c/.git" ]; then
    { rg clone -q --reference "$R" --no-checkout "file://$R" "$c" && rg -C "$c" remote set-url origin "$url" && rg -C "$c" checkout -q -B develop origin/develop; } \
      || { echo "fsd-repo: o clone de fsd-$r falhou"; exit 1; }
  fi
done
echo "fsd-repo: $R pronto (só leitura para os papéis; um clone por papel na home dele)"
