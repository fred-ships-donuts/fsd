#!/usr/bin/env bash
# fsd-session-exec — o que o supervisor pode fazer com a sessão de um papel, como o próprio papel (F2.6, T2.6.1). Instalado pelo
# fsd-users em /usr/local/sbin (dono root); o sudoers só deixa o fsd-dispatch chamar este arquivo, e só como fsd-kevin, fsd-mel,
# fsd-stuart ou fsd-bob. Cada papel tem o próprio supervisor nativo do claude (o socket é por uid), daí a troca de usuário.
#   agents                                  claude agents --json (as sessões deste papel)
#   stop <id>                               claude stop <id>
#   start <arquivo-prompt>                  claude --bg --name <papel> … (prompt lido do arquivo; o --bg escolhe o id e o imprime)
#   resume <sessionId> <arquivo-prompt>     claude --bg --name <papel> … --resume <uuid> (com as flags fixas: cópia com o histórico)
#   state                                   o estado do hook (session-state/<papel>.json) · unsaved: o que está só no disco
#   judge <n> <arquivo-esperas>             só como fsd-kevin: o fsd-judge do impasse <n>, com as esperas (leases) que o supervisor leu
#   transcript <sessionId>                  a transcrição da conversa (~/.claude/projects/*/<id>.jsonl), para o fsd-eval --real
# Valida tudo: id hex curto, uuid, arquivo de prompt legível. As flags da sessão são fixas aqui, não vêm de quem chama: só os settings
# do perfil (do root; hooks do time + o papel) e nenhuma outra fonte (--setting-sources local).
set -uo pipefail
umask 077   # validação R38: arquivos da sessão só do papel (o sudo não passa pelo /etc/profile.d)
u=$(id -un); role=${u#fsd-}
case "$role" in kevin|mel|stuart|bob) ;; *) echo "fsd-session-exec: só como usuário de papel" >&2; exit 2 ;; esac
# Configuração só do root (/etc/fsd/session.env, escrita pelo fsd-users): o ambiente de quem chama não entra (sudo env_reset).
REPO=/srv/fsd/repo; TEAM=/srv/fsd/repo/team; CLAUDE=/usr/local/bin/claude; PREFLIGHT=1; STATE_ROOT=/var/lib/fsd-state; CWD_ROOT=/srv/fsd/cwd
# shellcheck disable=SC1091
[ -r /etc/fsd/session.env ] && [ "$(stat -c %U /etc/fsd/session.env)" = root ] && . /etc/fsd/session.env
UUID='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
# Validação R39: o prompt (cartão, mensagens) entra pelo stdin do claude --bg (provado no 2.1.322), não pelo argv, que todo uid lê em
# /proc/<pid>/cmdline.
prompt() { [ -f "$1" ] && [ -r "$1" ] && [ -s "$1" ] || { echo "fsd-session-exec: prompt ilegível" >&2; exit 2; }; }
run_bg() {   # run_bg <arquivo> [--resume <uuid>]
  local pf=$1; prompt "$pf"; shift
  # Validação R40: o MCP do papel (do root) passa o --config do ai-memory, fora da pasta de dados que o papel grava.
  local MCP="$TEAM/mcp.json"; [ -f "/etc/fsd/profiles/$role/mcp.json" ] && MCP="/etc/fsd/profiles/$role/mcp.json"
  # F4.1 (T4.1.3): recusa subir sem os hooks do time, sem o ai-memory, sem login ou com o túnel fechado.
  if [ "$PREFLIGHT" != 0 ]; then FSD_PREFLIGHT_CLAUDE="$CLAUDE" FSD_TEAM="$TEAM" node "$TEAM/bin/fsd-session-preflight.mjs" "/etc/fsd/profiles/$role/settings.json" || exit 3; fi
  # Validação R14: o cwd é uma pasta do root, só leitura para o papel ($CWD_ROOT/<papel>, com o .ai-memory.toml do projeto). No
  # checkout compartilhado, um papel que gravasse .claude/settings.local.json ou CLAUDE.local.md injetava hooks ou instruções na sessão
  # dos colegas (o --setting-sources local lê o settings.local.json do cwd). Recusa se a pasta não for do root, se o papel puder
  # gravá-la ou se tiver .claude/ ou CLAUDE*.md. R47: a confiança da pasta vai no .claude.json do papel (fsd-profile.mjs).
  local cwd="$CWD_ROOT/$role"
  if [ ! -d "$cwd" ] || [ "$(stat -c %U "$cwd")" != root ] || [ -w "$cwd" ] || [ -n "$(find "$cwd" -maxdepth 1 \( -name .claude -o -name 'CLAUDE*.md' \) -print -quit)" ]; then
    echo "fsd-session-exec: o cwd $cwd não é uma pasta do root, só leitura e limpa (sem .claude/ nem CLAUDE*.md)" >&2; exit 3
  fi
  node "$TEAM/bin/fsd-profile.mjs" "$HOME/.claude.json" "$cwd" >/dev/null || { echo "fsd-session-exec: não consegui gravar a confiança de $cwd" >&2; exit 3; }
  # Validação R6/R7: o PATH do time (fsd-*, o wrapper gh, rtk), o repositório (o fsd-lib não acha pelo link da cópia fixada) e o git do
  # root; sem prompt de git nem editor. R1: o estado na pasta do papel ($STATE_ROOT/<papel>), que o supervisor também lê e grava.
  cd "$cwd" && exec env FSD_AGENT="$role" FSD_RUNNER=session FSD_TEAM="$TEAM" FSD_REPO="$REPO" FSD_STATE="$STATE_ROOT/$role" FSD_STATE_ROOT="$STATE_ROOT" \
    PATH="$TEAM/bin:/usr/local/bin:/usr/bin:/bin" GIT_CONFIG_GLOBAL="/etc/fsd/profiles/$role/gitconfig" GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true \
    "$CLAUDE" --bg --name "$role" --permission-mode bypassPermissions \
    --setting-sources local --settings "/etc/fsd/profiles/$role/settings.json" \
    --append-system-prompt-file "/etc/fsd/profiles/$role/system.md" --mcp-config "$MCP" --strict-mcp-config "$@" < "$pf"
}
case "${1:-}" in
  agents) exec "$CLAUDE" agents --json ;;
  stop) [[ ${2:-} =~ ^[0-9a-f]{6,16}$ ]] || { echo "fsd-session-exec: id inválido" >&2; exit 2; }; exec "$CLAUDE" stop "$2" ;;
  start) [ $# -eq 2 ] || { echo "fsd-session-exec: start <arquivo-prompt>" >&2; exit 2; }; run_bg "$2" ;;
  resume) [[ ${2:-} =~ $UUID ]] || { echo "fsd-session-exec: uuid inválido" >&2; exit 2; }; run_bg "${3:-}" --resume "$2" ;;
  state) cat "$STATE_ROOT/$role/session-state/$role.json" 2>/dev/null || echo '{}' ;;
  unsaved) exec node -e 'import(process.argv[1]).then((m) => console.log(JSON.stringify(m.unsaved(process.argv[2], { repo: process.argv[3] }))))' "$TEAM/bin/fsd-eod.mjs" "$role" "$REPO" ;;
  # Validação R28: o juiz roda como o Kevin (o token pelo uid dele, o login do claude na home dele), com o ambiente da sessão.
  judge) [ "$role" = kevin ] || { echo "fsd-session-exec: o juiz só roda como fsd-kevin" >&2; exit 2; }
    [[ ${2:-} =~ ^[0-9]{1,7}$ ]] && [ -f "${3:-}" ] && [ -r "$3" ] || { echo "fsd-session-exec: judge <n> <arquivo-esperas>" >&2; exit 2; }
    cd "$REPO" && exec env FSD_AGENT=kevin FSD_RUNNER=session FSD_TEAM="$TEAM" FSD_REPO="$REPO" FSD_STATE="$STATE_ROOT/kevin" FSD_STATE_ROOT="$STATE_ROOT" \
      FSD_JUDGE_WAITS_FILE="$3" PATH="$TEAM/bin:/usr/local/bin:/usr/bin:/bin" GIT_CONFIG_GLOBAL="/etc/fsd/profiles/kevin/gitconfig" GIT_TERMINAL_PROMPT=0 \
      node "$TEAM/bin/fsd-judge" "$2" ;;
  # Validação R31: a transcrição fica na home do papel (0700); o eval real a lê por aqui.
  transcript) [[ ${2:-} =~ $UUID ]] || { echo "fsd-session-exec: uuid inválido" >&2; exit 2; }
    f=$(find "$HOME/.claude/projects" -mindepth 2 -maxdepth 2 -name "$2.jsonl" -print -quit 2>/dev/null); [ -n "$f" ] && exec cat -- "$f"; exit 0 ;;
  *) echo "uso: fsd-session-exec agents | stop <id> | start <arquivo-prompt> | resume <uuid> <arquivo-prompt> | state | unsaved | judge <n> <arquivo-esperas> | transcript <uuid>" >&2; exit 2 ;;
esac
