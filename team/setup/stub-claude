#!/usr/bin/env node
// stub-claude — um claude falso para os testes D do time nativo (0 token). Estado em $STUB_CLAUDE_DIR/state.json.
// Emula o que o supervisor usa, no formato visto na T0.1.5 (claude agents --json do 2.1.322):
//   --help                       as flags e subcomandos que o check-claude-cli confere
//   --bg [--name n] [--resume u] ... "<prompt>"   imprime "backgrounded · <id> · <nome>" (ver o bloco --bg). Grava prompts, cwd,
//                                FSD_AGENT e FSD_RUNNER de cada sessão.
//                                STUB_RUN_HOOKS=1: roda $FSD_TEAM/bin/fsd-session-hook com SessionStart, UserPromptSubmit e Stop (o
//                                turno começa e acaba). STUB_WORKING=1: o turno não acaba (sem Stop).
//   agents --json [--all]        as sessões background ligadas (com --all, também as paradas)
//   stop <id>                    desliga (a conversa fica) · reboot (só do stub): desliga todas, como um docker restart
//   auth status                  {loggedIn}; STUB_NOT_LOGGED_IN=1: false, e o --bg falha com "Not logged in"
import { readFileSync, writeFileSync, mkdirSync, appendFileSync } from 'node:fs';
import { join } from 'node:path';
import { randomUUID, randomBytes } from 'node:crypto';
import { spawnSync } from 'node:child_process';
const DIR = process.env.STUB_CLAUDE_DIR || `/tmp/stub-claude-${process.getuid?.() ?? 'x'}`; mkdirSync(DIR, { recursive: true });   // um por uid (cada papel tem o seu supervisor)
const F = join(DIR, 'state.json');
// $STUB_CLAUDE_DIR/env.json ({ "STUB_RUN_HOOKS": "1", ... }): variáveis do stub para quando ele roda atrás do sudo do fsd-session-exec,
// que limpa o ambiente (os K de ponta a ponta no simulate-container). Só as STUB_*.
try { for (const [k, v] of Object.entries(JSON.parse(readFileSync(join(DIR, 'env.json'), 'utf8')))) if (k.startsWith('STUB_')) process.env[k] = String(v); } catch {}
const load = () => { try { return JSON.parse(readFileSync(F, 'utf8')); } catch { return { sessions: [], calls: [] }; } };
const st = load(); const a = process.argv.slice(2); st.calls.push(a); const save = () => writeFileSync(F, JSON.stringify(st, null, 1));
const opt = (k) => { const i = a.indexOf(k); return i >= 0 ? a[i + 1] : undefined; };
const hooks = (s, prompt) => {
  if (!process.env.STUB_RUN_HOOKS || !process.env.FSD_TEAM) return;
  const h = join(process.env.FSD_TEAM, 'bin', 'fsd-session-hook');
  const evs = ['SessionStart', 'UserPromptSubmit', ...(process.env.STUB_WORKING ? [] : ['Stop'])];
  for (const ev of evs) { const r = spawnSync(h, { input: JSON.stringify({ hook_event_name: ev, session_id: s.sessionId, prompt }), encoding: 'utf8', env: process.env }); if (r.stdout) s.context.push({ ev, out: r.stdout }); }
};
// STUB_PLAY=<json [{ bash } | { write: { path, content } } | { tool, input }]>: o stub "age" como um agente com um roteiro fixo (o executor de
// eval prova a si mesmo sem token, F4.9). Cada ação roda no cwd da sessão, com o ambiente dela, e vira tool_use/tool_result na
// transcrição $STUB_CLAUDE_DIR/transcripts/<sessionId>.jsonl, no formato do Claude Code (o fsd-audit lê).
function play(s, prompt) {
  if (!process.env.STUB_PLAY) return;
  let acts = []; try { acts = JSON.parse(readFileSync(process.env.STUB_PLAY, 'utf8')); } catch { return; }
  const dir = join(DIR, 'transcripts'); mkdirSync(dir, { recursive: true }); const f = join(dir, `${s.sessionId}.jsonl`);
  const lines = [{ type: 'user', message: { role: 'user', content: prompt } }]; let k = 0;
  for (const x of acts) {
    const id = `toolu_stub_${++k}`; let name = 'Bash', input = {}, out = '';
    if (x.bash) { input = { command: x.bash }; const r = spawnSync('bash', ['-c', x.bash], { cwd: process.cwd(), encoding: 'utf8', env: process.env }); out = `${r.stdout}${r.stderr}`.trim(); }
    else if (x.write) { name = 'Write'; input = { file_path: x.write.path, content: x.write.content }; writeFileSync(x.write.path, typeof x.write.content === 'string' ? x.write.content : JSON.stringify(x.write.content)); out = 'ok'; }
    else if (x.tool) { name = x.tool; input = x.input || {}; out = 'ok'; }
    lines.push({ type: 'assistant', message: { role: 'assistant', content: [{ type: 'tool_use', id, name, input }] } });
    lines.push({ type: 'user', message: { role: 'user', content: [{ type: 'tool_result', tool_use_id: id, content: out }] } });
  }
  appendFileSync(f, lines.map((l) => JSON.stringify(l)).join('\n') + '\n');
  // STUB_HOME_TRANSCRIPT=1: também em ~/.claude/projects/-stub/<sessionId>.jsonl, onde o claude de verdade grava (o verbo transcript do
  // fsd-session-exec lê dali; o eval --real no simulate-container).
  if (process.env.STUB_HOME_TRANSCRIPT && process.env.HOME) { const hd = join(process.env.HOME, '.claude', 'projects', '-stub'); mkdirSync(hd, { recursive: true }); appendFileSync(join(hd, `${s.sessionId}.jsonl`), lines.map((l) => JSON.stringify(l)).join('\n') + '\n'); }
}
if (a[0] === '--help') { console.log('Usage: claude [options]\n  --bg, --background\n  --bare\n  --permission-prompts\n  --settings <file-or-json>\n  --json-schema <schema>\n  --setting-sources <sources>\n  --resume [value]\n  --session-id <uuid>\n  -n, --name <name>'); process.exit(0); }
if (['agents', 'respawn', 'stop', 'daemon'].includes(a[0]) && a[1] === '--help') { console.log(`Usage: claude ${a[0]} [options]${a[0] === 'agents' ? '\n  --json  Print active sessions' : ''}`); process.exit(0); }
if (a[0] === 'auth' && a[1] === 'status') { save(); console.log(JSON.stringify({ loggedIn: !process.env.STUB_NOT_LOGGED_IN, authMethod: process.env.STUB_NOT_LOGGED_IN ? 'none' : 'claude.ai' })); process.exit(process.env.STUB_NOT_LOGGED_IN ? 1 : 0); }
if (a.includes('--bg') && process.env.STUB_NOT_LOGGED_IN) { save(); console.error('Not logged in · Please run /login'); process.exit(1); }   // a variante "Not logged in"
if (a[0] === 'agents') {
  const list = st.sessions.filter((s) => a.includes('--all') || s.alive).map((s) => ({ id: s.id, cwd: s.cwd, kind: 'background', startedAt: s.startedAt, sessionId: s.sessionId, name: s.name, state: s.alive ? 'idle' : 'completed' }));
  save(); console.log(JSON.stringify(list, null, 2)); process.exit(0);
}
if (a[0] === 'stop') { const s = st.sessions.find((x) => x.id === a[1]); if (!s) { save(); console.error(`no session ${a[1]}`); process.exit(1); } s.alive = false; save(); process.exit(0); }
if (a[0] === 'reboot') { for (const s of st.sessions) s.alive = false; save(); process.exit(0); }
if (a.includes('--bg')) {
  // Como o 2.1.322 (F0.2): o --bg escolhe o id (ignora --session-id, com aviso) e imprime "backgrounded · <id> · <nome>"; o id curto é o
  // começo do sessionId. --resume com flags (além do --bg) cria uma cópia que leva o histórico (id novo; a sessão guarda as próprias
  // opções); sem flags, acorda a mesma sessão desligada; ligada (ociosa ou trabalhando), sempre cópia (E-cópia).
  // Validação R39: o prompt pode vir pelo stdin (o fsd-session-exec não o põe no argv, que todos os uids leem); sem stdin, o último arg.
  let stdinPrompt = ''; if (!process.stdin.isTTY) { try { stdinPrompt = readFileSync(0, 'utf8'); } catch {} }
  const viaStdin = stdinPrompt.trim() !== ''; const noPrompt = viaStdin ? a : a.slice(0, -1);
  const prompt = viaStdin ? stdinPrompt.trim() : a[a.length - 1]; const resume = opt('--resume');
  const env = { agent: process.env.FSD_AGENT || null, runner: process.env.FSD_RUNNER || null,
    path: process.env.PATH || null, repo: process.env.FSD_REPO || null, state: process.env.FSD_STATE || null, gitcfg: process.env.GIT_CONFIG_GLOBAL || null };
  if (opt('--session-id')) console.error('warning: --bg manages the session id; ignoring --session-id (use --resume <id> to continue an existing session)');
  const flags = noPrompt.filter((x, i, l) => !['--bg', '--background', '--resume'].includes(x) && l[i - 1] !== '--resume');
  let s = resume ? st.sessions.find((x) => x.sessionId === resume) : null;
  if (resume && !s) { save(); console.error(`no conversation ${resume}`); process.exit(1); }
  const fresh = () => { const sessionId = randomUUID(); return { id: sessionId.slice(0, 8), sessionId, alive: true, context: [], startedAt: Date.now(), cwd: process.cwd(), ...env }; };
  if (s && (s.alive || flags.length)) {
    console.error(s.alive ? `note: session ${s.id} is already running in the background, so this started a copy.` : `note: background session ${s.id} keeps its own saved options, so the flags you passed started a copy.`);
    s = { ...s, ...fresh(), name: opt('--name') || null, copyOf: s.sessionId, prompts: [...s.prompts, prompt], args: flags.length ? noPrompt : s.args }; st.sessions.push(s);
  } else if (s) { console.error(`note: woke session ${s.id} with its saved options.`); s.alive = true; s.prompts.push(prompt); Object.assign(s, env, { cwd: process.cwd() }); }
  else { s = { ...fresh(), name: opt('--name') || null, prompts: [prompt], args: noPrompt }; st.sessions.push(s); }
  hooks(s, prompt); play(s, prompt); save(); console.log(`backgrounded · ${s.id}${s.name ? ` · ${s.name}` : ''}`); process.exit(0);
}
save(); console.error(`stub-claude: não emulado: ${a.join(' ')}`); process.exit(2);
