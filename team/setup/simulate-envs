#!/usr/bin/env bash
# simulate-envs [--keep] — simula instalações do fsd em layouts diferentes e confere onde quebra.
# Clona este repositório (o branch atual) em vários caminhos e HOMEs: um container padrão, um container com outro
# nome e caminho (sem FSD_REPO), o layout da matriz e um caminho com espaços; cada um com os links de ~/.local/bin
# e um estado de agentes que veio de outra máquina. Confere a raiz do repo pelos scripts (direto e pelo link),
# o agents.json, fsd-dev start (com e sem tarefa), fsd-pr open (regra de commits e npm ci automático), fsd-agent
# (modelo, janela, perfis religados, com um claude falso), a CLI (build e task) e os arquivos citados pelas skills.
# Não gasta token nem toca no estado real: o claude e o gh são falsos, o token do App vem de um cache semeado (sem
# chaves, sem api.github.com) e cada ambiente tem HOME, FSD_STATE, TMPDIR e socket tmux próprios. Roda em qualquer
# máquina, com HOME e FSD_STATE vazios. Recusa (exit 2) com mudança não commitada: ele clona o branch commitado.
# Não simula outro usuário, outro UID nem um container de verdade: para isso, rode num host com Docker.
set -uo pipefail
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
SRC="$(dirname "$(dirname "$HERE")")"; BR="$(git -C "$SRC" branch --show-current)"; KEEP=0; [ "${1:-}" = --keep ] && KEEP=1
# O clone só vê o que está commitado: mudança local (exceto neste script, que roda daqui) seria ignorada em silêncio.
dirty="$(git -C "$SRC" status --porcelain | grep -v " team/setup/simulate-envs$")"
if [ -n "$dirty" ]; then echo "simulate-envs: mudanças não commitadas em $SRC:" >&2; echo "$dirty" >&2; echo "commit first; simulate-envs tests the committed branch" >&2; exit 2; fi
BASE="$(mktemp -d "${TMPDIR:-/tmp}/fsd-sim.XXXX")"; RES="$BASE/results"; : > "$RES"
# Na saída, mesmo abortando no meio: derruba os servidores tmux da simulação (sockets em $BASE) e apaga $BASE.
# Hermético: nenhuma FSD_* da sessão de quem roda (FSD_DRY, FSD_STATE, FSD_TMUX_SOCKET…) entra nos ambientes simulados.
for v in $(compgen -e | grep '^FSD_'); do unset "$v"; done
trap 'node "$SRC/team/bin/fsd-loops.mjs" kill --under "$BASE" >/dev/null 2>&1; for d in "$BASE"/tmux-*; do [ -d "$d" ] && TMUX_TMPDIR="$d" tmux -L fsd-sim kill-server 2>/dev/null; done; TMUX_TMPDIR="$BASE/tmux-watch" tmux -L "fsdsim$$" kill-server 2>/dev/null; [ "$KEEP" = 1 ] || rm -rf "$BASE"' EXIT
ok()  { echo "  PASS $*"; echo P >> "$RES"; }
bad() { echo "  FAIL $*"; echo F >> "$RES"; }
chk() { local d="$1"; shift; local o; if o=$("$@" 2>&1); then ok "$d"; else bad "$d :: $(tail -3 <<<"$o" | tr '\n' ' ' | cut -c1-300)"; fi; }
mkdir -p "$BASE/stub" "$BASE/trap"; for b in claude gh; do printf '#!/bin/sh\necho "$0 $*" >> "%s/trap.hits"; exit 99\n' "$BASE" > "$BASE/trap/$b"; chmod +x "$BASE/trap/$b"; done
# Rede: nenhum processo node da simulação fala com api.github.com nem com a Anthropic (o fsd-watch chama o fsd-progress, que lê o
# quadro): a conexão falha na hora. O registro do npm segue livre (o npm ci dos cenários).
printf 'const n=require("net"),c=n.Socket.prototype.connect;n.Socket.prototype.connect=function(...a){const h=a[0]&&a[0].host;if(/(^|\\.)(github\\.com|anthropic\\.com)$/.test(h||""))throw new Error("simulate-envs: rede bloqueada: "+h);return c.apply(this,a)}\n' > "$BASE/nonet.cjs"; export NODE_OPTIONS="${NODE_OPTIONS:-} --require $BASE/nonet.cjs"
printf '#!/usr/bin/env bash\necho "STUB claude $* | DISABLE_1M=${CLAUDE_CODE_DISABLE_1M_CONTEXT:-<unset>} | WINDOW=${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-}"\n' > "$BASE/stub/claude"; chmod +x "$BASE/stub/claude"
# gh de verdade simulado (FSD_REAL_GH): o issue da tarefa existe e está aberto, sem depender do estado do GitHub (o #81 já fechou).
printf '#!/usr/bin/env bash\nif [ "$1 $2" = "issue view" ]; then echo "{\\"number\\":$3,\\"title\\":\\"sim\\",\\"body\\":\\"\\",\\"state\\":\\"OPEN\\",\\"labels\\":[],\\"comments\\":[]}"; else echo "gh simulado: $*" >&2; exit 1; fi\n' > "$BASE/stub/gh-real"; chmod +x "$BASE/stub/gh-real"

mkenv() { # nome repo home FSD_REPO(set|unset) links(container|host) node_modules(link|none)
  local n="$1" repo="$2" home="$3" setrepo="$4" links="$5" nm="$6"
  echo "== $n | repo=$repo | HOME=$home | FSD_REPO=$setrepo | links=$links | node_modules=$nm"
  mkdir -p "$(dirname "$repo")" "$home/.local/bin"
  git clone -q --no-hardlinks "$SRC" "$repo" && git -C "$repo" checkout -q "$BR"
  git -C "$repo" config user.email sim@sim; git -C "$repo" config user.name sim
  git -C "$repo" fetch -q origin "+refs/heads/develop:refs/remotes/origin/develop"
  [ "$nm" = link ] && ln -s "$SRC/node_modules" "$repo/node_modules"
  local st="$home/.config/fsd-agents"; mkdir -p "$st/agents/mel/claude" "$st/agents/kevin/claude" "$st/ai-memory-tokens" "$st/cache"
  # Token do App sem chave e sem rede: o fsd-token devolve o cache enquanto faltar mais de 10 min para expirar.
  node -e 'const fs=require("fs"),[a,d]=process.argv.slice(1),x=new Date(Date.now()+864e5).toISOString();for(const n of Object.keys(JSON.parse(fs.readFileSync(a)).agents))for(const f of [n,n+"-org"])fs.writeFileSync(d+"/"+f+".json",JSON.stringify({token:"sim",expires_at:x}),{mode:0o600})' "$repo/team/agents.json" "$st/cache"
  echo dummy > "$st/claude-oauth-token"; echo dummy > "$st/ai-memory-tokens/mel"
  ln -s /media/outra-maquina/Projects/fred-ships-donuts/team/agents/mel/claude/CLAUDE.md "$st/agents/mel/claude/CLAUDE.md"
  echo "cópia antiga" > "$st/agents/kevin/claude/CLAUDE.md"
  if [ "$links" = container ]; then printf '#!/bin/sh\nexec "%s/team/bin/fsd-agent" "$@"\n' "$repo" > "$home/.local/bin/fsd-agent"; chmod +x "$home/.local/bin/fsd-agent"
    for b in fsd-stats fsd-watch fsd-cleanup fsd-sync-pair fsd-map; do ln -s "$repo/team/bin/$b" "$home/.local/bin/$b"; done
  else for b in fsd-agent fsd-memory-backup fsd-sync-pair fsd-restart fsd-trash fsd-stop fsd-map; do ln -s "$repo/team/bin/$b" "$home/.local/bin/$b"; done; fi
  local T="$repo/team/bin" L="$home/.local/bin"
  mkdir -p "$home/tmp"
  run() { ( export HOME="$home" FSD_STATE="$st" TMPDIR="$home/tmp" FSD_REAL_GH="$BASE/stub/gh-real" PATH="$BASE/stub:$home/.local/bin:$BASE/trap:$PATH"; unset FSD_REPO FSD_DRY; [ "$setrepo" = set ] && export FSD_REPO="$repo"; cd "$home" && "$@" ); }
  # 1. raiz do repo e configuração
  for s in "$T/fsd-trash" "$L/fsd-trash"; do [ -e "$s" ] || continue
    o=$(run env FSD_DRY=1 "$s" "$repo" 2>&1); [ "$o" = "recusado: $repo" ] && ok "fsd-trash protege o repo (${s#$BASE/})" || bad "fsd-trash ${s#$BASE/}: $o"; done
  chk "fsd-lib REPO_DIR = repo" run bash -c '[ "$(node --input-type=module -e "import(process.argv[1]).then(m=>console.log(m.REPO_DIR))" "$0")" = "$1" ]' "$T/fsd-lib.mjs" "$repo"
  chk "fsd-token: cache semeado vale sem chaves e sem rede (mel)" run bash -c '[ ! -e "$FSD_STATE/keys" ] && [ "$("$0" mel)" = sim ] && [ "$("$0" mel org)" = sim ]' "$T/fsd-token"
  chk "fsd-context lê agents.json" run node "$T/fsd-context.mjs" mel limit restartAbove
  printf '%s' '{"claude_common":{"context":{"restartAbove":100000}},"agents":{"bob":{"context":{"restartAbove":90000}}}}' > "$st/agents.local.json"
  chk "fsd-context: agents.local.json por cima (comum e por agente)" run bash -c '[ "$(node "$0" mel restartAbove)" = 100000 ] && [ "$(node "$0" bob restartAbove)" = 90000 ]' "$T/fsd-context.mjs"
  printf '%s' '{"claude_common":{"context":{"bands":{"normal":{"urgentAt":3}}}}}' > "$st/agents.local.json"
  chk "fsd-context: objeto aninhado local muda só o campo dado" run bash -c '[ "$(node "$0" mel bands.normal.urgentAt bands.normal.mediumAt bands.heavy.urgentAt | tr "\n" " ")" = "3 4 3 " ]' "$T/fsd-context.mjs"
  printf '%s' '{"timing":{"readyGraceMin":3,"watch":{"idleMin":42}}}' > "$st/agents.local.json"
  chk "fsd-timing: agents.local.json por cima, campo a campo" run bash -c '[ "$(node "$0" readyGraceMin watch.idleMin | tr "\n" " ")" = "3 42 " ] && [ "$(node "$0" watch.loopSeconds)" = "$(FSD_STATE=/nonexistent node "$0" watch.loopSeconds)" ]' "$T/fsd-timing.mjs"
  # agents.local.json quebrado não derruba o vigia: mel ocioso sem Monitor (sessão num tmux isolado, transcript de 1 h
  # atrás) obriga o fsd-watch a ler o contexto; ele deve mostrar "configuração inválida" e sair 0.
  printf '{x' > "$st/agents.local.json"
  local tx="$st/agents/mel/claude/projects/sim"; mkdir -p "$tx"; echo '{}' > "$tx/s.jsonl"; touch -d '1 hour ago' "$tx/s.jsonl"
  local tsock="$BASE/tmux-$n"; mkdir -p "$tsock"; chmod 700 "$tsock"
  TMUX_TMPDIR="$tsock" tmux -L fsd-sim -f /dev/null new-session -d -s fsd-mel 'sleep 600'
  # TMPDIR próprio: o hash da sessão (fsd-live-hash), as ferramentas em andamento (fsd-live) e o fsd-watch-state.json
  # moram em $TMPDIR, os mesmos dos agentes reais desta máquina. Sem isolar, o Mel simulado cai em "configuração antiga"
  # conforme o que o Mel real estiver fazendo, e o check grava no estado do vigia real.
  local ttmp; ttmp="$(mktemp -d "$BASE/tmp.XXXX")"
  chk "fsd-watch: agents.local.json inválido → 'configuração inválida', vigia segue" run env TMPDIR="$ttmp" TMUX_TMPDIR="$tsock" FSD_TMUX_SOCKET=fsd-sim bash -c 'o=$("$0" 2>&1) && grep -q "Mel .*configuração inválida" <<<"$o" && ! grep -q "at .*fsd-context" <<<"$o" && grep -q "mel: configuração inválida (agents.local.json inválido" "$1/watch.log"' "$T/fsd-watch" "$st"
  TMUX_TMPDIR="$tsock" tmux -L fsd-sim kill-server 2>/dev/null; rm -rf "$tx" "$st/agents.local.json"
  chk "fsd-redirects --check: tabela do team.md em dia" run "$T/fsd-redirects" --check
  chk "fsd-redirects --test: fixtures do hook" run "$T/fsd-redirects" --test
  chk "fsd-sync-pair: modelos achados pelo link" run bash -c 'H=$(dirname "$(readlink -f "$0")"); test -f "$(dirname "$H")/setup/syncthing/agent.stignore"' "$L/fsd-sync-pair"
  # 2. trabalho sem tarefa: fsd-dev start - (de verdade, só local) e fsd-pr open (dry)
  chk "fsd-dev start - sim-x cria worktree chore/sim-x" run env FSD_AGENT=stuart "$T/fsd-dev" start - sim-x --chore
  local W="$repo/.claude/worktrees/chore-sim-x"
  chk "worktree sem marca de tarefa" bash -c '! git -C "$0" config --get branch.chore/sim-x.fsd-issue' "$repo"
  git -C "$W" commit -q --allow-empty -m "chore: sim commit"
  chk "fsd-pr open sem tarefa: commitlint ok, faria o push" run bash -c 'FSD_DRY=1 FSD_AGENT=stuart FSD_STATE="$2" "$0" open "chore: sim" --docs -C "$1" 2>&1 | tee /dev/stderr | grep -q "\[dry\] git -C .* push"' "$T/fsd-pr" "$W" "$st"
  # conflito com a develop (#154): origem local, o branch e a develop mudam a mesma linha; nada pode ir ao push
  local CF="$BASE/cf-$n" gc="git -c user.email=sim@sim -c user.name=sim"; mkdir -p "$CF"
  git init -q -b develop "$CF/seed" && echo base > "$CF/seed/f" && git -C "$CF/seed" add f && $gc -C "$CF/seed" commit -qm "chore: seed"
  git clone -q --bare "$CF/seed" "$CF/origin.git" && git clone -q "$CF/origin.git" "$CF/w" && git clone -q "$CF/origin.git" "$CF/other"
  git -C "$CF/w" checkout -qb chore/sim-conflict && echo mine > "$CF/w/f" && $gc -C "$CF/w" commit -qam "chore: sim mine"
  echo theirs > "$CF/other/f" && $gc -C "$CF/other" commit -qam "chore: sim theirs" && git -C "$CF/other" push -q origin develop
  chk "fsd-pr open com conflito: exit 1, lista o arquivo, dica do sync, nada no push" run bash -c 'o=$(FSD_DRY=1 FSD_AGENT=stuart FSD_STATE="$2" "$0" open "chore: sim" --docs -C "$1" 2>&1); rc=$?; [ "$rc" = 1 ] && grep -qx "  f" <<<"$o" && grep -q "fsd-dev sync -C" <<<"$o" && ! grep -q "\[dry\] git .* push" <<<"$o"' "$T/fsd-pr" "$CF/w" "$st"
  git -C "$W" commit -q --allow-empty -m "wip"
  chk "fsd-pr open recusa 'wip'" run bash -c 'FSD_DRY=1 FSD_AGENT=stuart "$0" open "chore: sim" --docs -C "$1" 2>&1 | grep -q "commit fora da regra"' "$T/fsd-pr" "$W"
  # 3. trabalho com tarefa (marca gravada como o fsd-dev start <n> faz)
  git -C "$repo" worktree add -q -b feature/81-sim "$repo/.claude/worktrees/t81" origin/develop && git -C "$repo" config branch.feature/81-sim.fsd-issue 81
  git -C "$repo/.claude/worktrees/t81" commit -q --allow-empty -m "feat: sim (#81)"
  chk "com tarefa #81: 'feat: sim (#81)' passa" run bash -c 'FSD_DRY=1 FSD_REAL_GH="$3" FSD_AGENT=stuart FSD_STATE="$2" "$0" open "feat: sim" --docs -C "$1" 2>&1 | grep -q "\[dry\] git -C .* push"' "$T/fsd-pr" "$repo/.claude/worktrees/t81" "$st" "$BASE/stub/gh-real"
  git -C "$repo/.claude/worktrees/t81" commit -q --allow-empty -m "feat: sem número"
  chk "com tarefa #81: commit sem (#81) é recusado" run bash -c 'FSD_DRY=1 FSD_REAL_GH="$3" FSD_AGENT=stuart FSD_STATE="$2" "$0" open "feat: sim" --docs -C "$1" 2>&1 | grep -q "fsd-task-ref"' "$T/fsd-pr" "$repo/.claude/worktrees/t81" "$st" "$BASE/stub/gh-real"
  # 4. fsd-agent com claude simulado
  o=$(run "$T/fsd-agent" mel claude 2>&1)
  local model; model=$(node -p 'require(process.argv[1]).agents.mel.claude.model' "$repo/team/agents.json")   # o modelo do mel vem do agents.json, não de um valor fixo aqui
  grep -q -- "--model $model " <<<"$o" && ok "fsd-agent: modelo $model (agents.json)" || bad "fsd-agent modelo (esperado $model): $(tail -1 <<<"$o")"
  grep -q "DISABLE_1M=<unset> | WINDOW=250000" <<<"$o" && ok "fsd-agent: 1M ligada, teto 250000" || bad "fsd-agent janela: $(grep -o 'DISABLE.*' <<<"$o")"
  [ "$(readlink "$st/agents/mel/claude/CLAUDE.md")" = "$repo/team/agents/mel/claude/CLAUDE.md" ] && ok "perfil mel (link de outra máquina) religado" || bad "perfil mel: $(readlink "$st/agents/mel/claude/CLAUDE.md")"
  # O import do team.md em cada CLAUDE.md (@~/…) tem que cair no team/common/team.md deste repo, pelo link common/.
  local a imp want miss=""; want="$(readlink -f "$repo/team/common/team.md")"
  for a in kevin mel stuart bob; do
    imp=$(grep -o '^@~/[^ ]*team\.md' "$repo/team/agents/$a/claude/CLAUDE.md"); imp="${imp#@\~/}"
    [ -n "$imp" ] && [ "$(readlink -f "$home/$imp")" = "$want" ] || miss+=" $a"
  done
  [ -z "$miss" ] && ok "team.md: o import do CLAUDE.md cai em team/common/team.md (4 agentes)" || bad "team.md: import não resolve para:$miss ($(readlink "$st/common"))"
  run "$T/fsd-agent" kevin claude >/dev/null 2>&1
  [ "$(readlink "$st/agents/kevin/claude/CLAUDE.md")" = "$repo/team/agents/kevin/claude/CLAUDE.md" ] && [ -f "$st/agents/kevin/claude/CLAUDE.md.pre-team" ] && ok "perfil kevin: cópia → .pre-team, link novo" || bad "perfil kevin"
  # 5. CLI
  if [ "$nm" = link ]; then
    chk "npm run build" run npm --prefix "$repo" run -s build
    chk "fsd -v" run node "$repo/dist/cli/fsd.js" -v
    mkdir -p "$home/proj/nook"
    chk "fsd task: new/step/done/archive/list" run bash -c 'cd "$1/proj" && f(){ node "$0/dist/cli/fsd.js" "$@"; } && f task new "Sim task" && f task step add sim-task passo && f task step done sim-task 1 && f task done sim-task && f task archive sim-task && f task list --all | grep -q "sim-task  archived"' "$repo" "$home"
  fi
  # 6. skills: arquivos citados existem
  local miss=0; for sk in "$repo"/src/skills/_i18n/*/*/SKILL.md; do d=$(dirname "$sk"); while read -r p; do [ -n "$p" ] && [ ! -e "$d/$p" ] && { bad "skill ${d#$repo/} cita $p"; miss=1; }; done < <(grep -oE '(scripts|references|templates)/[A-Za-z0-9_./-]+[A-Za-z0-9_]' "$sk" | sort -u); done; [ $miss = 0 ] && ok "skills: arquivos citados existem"
  # 7. fsd-map pelo atalho: mapa fora do repo, HOME sem rastro do motor
  if [ -n "$MAPENG" ]; then
    local eng="$BASE/eng-$n"; cp -a "$MAPENG" "$eng"   # cópia própria: o patch do fsd-map reescreve arquivos do motor
    chk "fsd-map pelo atalho: grep acha código, repo intacto, HOME limpo" bash -c 'cd "$1" && o=$(HOME="$2" FSD_MAP_HOME="$2/.local/share/fsd/map" FSD_MAP_PKG="$3" "$2/.local/bin/fsd-map" grep openPrs) && grep -q "fsd-lib.mjs" <<<"$o" && [ -z "$(git status --porcelain | grep -v " node_modules$")" ] && [ ! -e "$2/.trail" ] && [ ! -e "$2/.graft" ] && ls "$2/.local/share/fsd/map/maps" | grep -q .' _ "$repo" "$home" "$eng"
  fi
}
npmci() { # cenários do npm ci automático do fsd-pr num clone sem node_modules
  local repo="$BASE/n/repo" home="$BASE/n/home"; echo "== npm ci automático | repo=$repo"
  local st="$BASE/n/state"; mkdir -p "$home" "$st" "$home/tmp"; git clone -q --no-hardlinks "$SRC" "$repo" && git -C "$repo" checkout -q "$BR" && git -C "$repo" config user.email s@s && git -C "$repo" config user.name s
  git -C "$repo" fetch -q origin "+refs/heads/develop:refs/remotes/origin/develop"; git -C "$repo" switch -q -c chore/npm-sim; git -C "$repo" commit -q --allow-empty -m "chore: npm sim"
  pr() { ( export HOME="$home" TMPDIR="$home/tmp" PATH="$BASE/stub:$BASE/trap:$PATH" FSD_REAL_GH="$BASE/stub/gh-real" npm_config_cache="$BASE/npm-cache" npm_config_prefer_offline=true FSD_DRY=1 FSD_AGENT=stuart FSD_STATE="$st" FSD_REPO="$repo"; timeout 900 "$repo/team/bin/fsd-pr" open "chore: npm" --docs -C "$repo" 2>&1 ); }
  # a) npm ausente: falha clara, sem loop, trava solta
  local nodeonly="$BASE/nodeonly"; mkdir -p "$nodeonly"; ln -s "$(command -v node)" "$nodeonly/node"; ln -s "$(command -v git)" "$nodeonly/git"
  o=$( export PATH="$nodeonly:/usr/bin:/bin"; ( export HOME="$home" TMPDIR="$home/tmp" PATH="$BASE/stub:$BASE/trap:$PATH" FSD_REAL_GH="$BASE/stub/gh-real" npm_config_cache="$BASE/npm-cache" npm_config_prefer_offline=true FSD_DRY=1 FSD_AGENT=stuart FSD_STATE="$st" FSD_REPO="$repo"; PATH="$nodeonly:/bin"; timeout 60 "$repo/team/bin/fsd-pr" open x --docs -C "$repo" 2>&1 ) ); rc=$?
  { grep -q "npm ci falhou" <<<"$o" && [ ! -e "$repo/.git/fsd-npm-ci.lock" ]; } && ok "sem npm: erro claro e trava solta" || bad "sem npm (rc=$rc): $(tail -2 <<<"$o" | tr '\n' ' ')"
  # b) trava velha (> 10 min) é removida e o npm ci roda; c) depois, commitlint presente: sem novo npm ci
  mkdir "$repo/.git/fsd-npm-ci.lock"; touch -d '20 minutes ago' "$repo/.git/fsd-npm-ci.lock"
  o=$(pr); grep -q "rodando npm ci" <<<"$o" && grep -q "\[dry\] git -C .* push" <<<"$o" && [ -x "$repo/node_modules/.bin/commitlint" ] && ok "trava velha removida, npm ci uma vez, segue" || bad "npm ci: $(tail -3 <<<"$o" | tr '\n' ' ')"
  o=$(pr); ! grep -q "rodando npm ci" <<<"$o" && ok "segunda vez: não roda npm ci de novo" || bad "rodou npm ci de novo"
  # d) trava recente de outro processo: espera e segue quando ela sai
  rm -rf "$repo/node_modules"; mkdir "$repo/.git/fsd-npm-ci.lock"; ( sleep 8; rmdir "$repo/.git/fsd-npm-ci.lock" ) &
  s=$(date +%s); o=$(pr); e=$(( $(date +%s) - s )); [ "$e" -ge 8 ] && grep -q "\[dry\] git -C .* push" <<<"$o" && ok "trava de outro processo: esperou ${e}s e seguiu" || bad "espera da trava (${e}s): $(tail -2 <<<"$o" | tr '\n' ' ')"
  # e) package.json sem commitlint (develop antiga): erro claro
  # um package.json sem commitlint (como o de uma develop antiga), com o lock que casa: o npm ci passa e o commitlint não vem
  echo '{"name":"sim","version":"0.0.0","private":true}' > "$repo/package.json"
  echo '{"name":"sim","version":"0.0.0","lockfileVersion":3,"requires":true,"packages":{"":{"name":"sim","version":"0.0.0"}}}' > "$repo/package-lock.json"; rm -rf "$repo/node_modules"
  o=$(pr); grep -q "commitlint não veio" <<<"$o" && ok "develop sem commitlint: erro claro, sem loop" || bad "sem commitlint no package.json: $(tail -2 <<<"$o" | tr '\n' ' ')"
}
# Motor do fsd-map para os cenários: cópia do pacote instalado aqui (sem o patch), dependências por link.
MAPENG=""
mapengine() {
  local real; real=$(FSD_MAP_HOME="" "$SRC/team/bin/fsd-map" status 2>/dev/null | sed -n '1s/.* em //p')
  local pkg="$real/node_modules/@trailhq/trail-code"
  [ -n "$real" ] && [ -d "$pkg" ] || { echo "== fsd-map: motor não instalado aqui (rode fsd-map status): cenários pulados"; return; }
  MAPENG="$BASE/engine"; mkdir -p "$MAPENG/node_modules/@trailhq"
  for d in "$real"/node_modules/* "$real"/node_modules/.bin; do [ "$(basename "$d")" = @trailhq ] || ln -s "$d" "$MAPENG/node_modules/"; done
  cp -r "$pkg" "$MAPENG/node_modules/@trailhq/"; sed -i '/fsd-patch/d' "$MAPENG"/node_modules/@trailhq/trail-code/dist/{claude/hooks,claude/pre-bash,context/savings,ask/ask}.js
  cp -r "$MAPENG/node_modules/@trailhq/trail-code" "$BASE/engine-pristine"
}
mapsim() { # fsd-map: patch, saída sem a marca do motor, worktree, versão diferente, código que mudou
  [ -n "$MAPENG" ] || return 0
  local repo="$BASE/m/repo" home="$BASE/m/home" E P="$MAPENG/node_modules/@trailhq/trail-code"; echo "== fsd-map | repo=$repo"
  mkdir -p "$home"; git clone -q --no-hardlinks "$SRC" "$repo" && git -C "$repo" checkout -q "$BR"
  sed -i "/fsd-patch/d" "$P"/dist/{claude/hooks,claude/pre-bash,context/savings,ask/ask}.js   # os atalhos acima já corrigiram
  E=(env HOME="$home" FSD_MAP_HOME="$home/map" FSD_MAP_PKG="$MAPENG")
  m() { ( cd "$repo" && "${E[@]}" "$repo/team/bin/fsd-map" "$@" ); }
  marks() { cat "$P"/dist/{claude/hooks,claude/pre-bash,context/savings,ask/ask}.js | grep -c fsd-patch; }
  m status >/dev/null 2>&1 && bad "status sem patch devia sair 1" || ok "status sem patch sai 1"
  local o; o=$(m ask "how does fsd-pr open a pull request" --source 2>&1); local rc=$?
  { [ $rc = 0 ] && [ "$(marks)" = 4 ] && grep -q "^fsd-map ask" <<<"$o"; } && ok "ask: aplica o patch (4 pontos) e responde" || bad "ask (rc=$rc, marcas=$(marks)): $(head -2 <<<"$o" | tr '\n' ' ')"
  o=$(for c in "ask openPrs --full" "grep openPrs" "skeleton team/bin/fsd-lib.mjs" "callers openPrs --depth all" map build; do m $c 2>&1; done)
  [ -n "$o" ] && ! grep -qiE 'trail|graft|tokens saved|learning' <<<"$o" && ok "saída de todos os comandos sem a marca do motor" || bad "marca na saída: $(grep -iE 'trail|graft|tokens saved|learning' <<<"$o" | head -2 | tr '\n' ' ')"
  [ "$(marks)" = 4 ] && ok "segunda execução: patch não duplica" || bad "patch duplicado ($(marks))"
  { [ -z "$(git -C "$repo" status --porcelain)" ] && [ ! -e "$home/.trail" ] && [ ! -e "$home/.graft" ]; } && ok "repo intacto e HOME sem rastro do motor" || bad "rastro: $(git -C "$repo" status --porcelain | head -2) $(ls -a "$home")"
  git -C "$repo" worktree add -q "$repo/.claude/worktrees/sim" -b chore/map-sim
  ( cd "$repo/.claude/worktrees/sim" && "${E[@]}" "$repo/team/bin/fsd-map" grep openPrs >/dev/null ) && [ "$(ls "$home/map/maps" | wc -l)" = 2 ] && ok "worktree: mapa próprio" || bad "worktree: $(ls "$home/map/maps")"
  m note x >/dev/null 2>&1; [ $? = 2 ] && ok "comando fora do mapa recusado (sai 2)" || bad "comando fora do mapa não foi recusado"
  # versão diferente da fixada: reinstala a fixada (npm simulado) e corrige
  sed -i 's/"version": *"[^"]*"/"version": "99.0.0"/' "$P/package.json"
  printf '#!/bin/sh\nrm -rf "%s"; cp -r "%s" "%s"\n' "$P" "$BASE/engine-pristine" "$P" > "$BASE/fake-npm"; chmod +x "$BASE/fake-npm"
  o=$(cd "$repo" && "${E[@]}" FSD_MAP_NPM="$BASE/fake-npm" "$repo/team/bin/fsd-map" grep openPrs 2>&1); rc=$?
  { [ $rc = 0 ] && [ "$(marks)" = 4 ] && grep -q '"version": "'"$(sed -n 's/^ARG MAP_VERSION=//p' "$SRC/team/setup/container/Dockerfile")"'"' "$P/package.json"; } && ok "versão diferente: reinstala a fixada e corrige" || bad "reinstalação (rc=$rc): $(tail -1 <<<"$o")"
  # código do motor mudou: falha sem gravar nada
  sed -i '/fsd-patch/d' "$P"/dist/{claude/hooks,claude/pre-bash,context/savings,ask/ask}.js; sed -i 's/function renderAsk(r) {/function renderAsk(r, o) {/' "$P/dist/ask/ask.js"
  o=$(m grep openPrs 2>&1); rc=$?
  { [ $rc = 1 ] && [ "$(marks)" = 0 ] && grep -q "não aceita o patch" <<<"$o"; } && ok "código mudou: falha clara, nada gravado" || bad "código mudou (rc=$rc, marcas=$(marks)): $(tail -1 <<<"$o")"
}
# Vigia com as quatro sessões vivas num servidor tmux isolado (FSD_TMUX_SOCKET): nenhuma linha "sem sessão", nenhuma sessão nova (#174).
watchsim() {
  local sock="fsdsim$$" st="$BASE/watch-st" a o
  mkdir -p "$st" "$BASE/watch-home/tmp"; chmod 700 "$BASE/tmux-watch" 2>/dev/null || { mkdir -p "$BASE/tmux-watch"; chmod 700 "$BASE/tmux-watch"; }
  export TMUX_TMPDIR="$BASE/tmux-watch"; echo "== vigia com sessões vivas | tmux -L $sock"
  for a in kevin mel stuart bob; do tmux -L "$sock" new-session -d -s "fsd-$a" "sleep 120"; done
  o=$(cd "$SRC" && env FSD_STATE="$st" FSD_TMUX_SOCKET="$sock" HOME="$BASE/watch-home" TMPDIR="$BASE/watch-home/tmp" "$SRC/team/bin/fsd-watch" --fix 2>&1); local n; n=$(tmux -L "$sock" list-sessions 2>/dev/null | wc -l)
  { ! grep -q "sem sessão" "$st/watch.log" 2>/dev/null && [ "$n" = 4 ]; } && ok "sessões vivas: sem 'sem sessão' no log e 4 sessões (sem duplicar)" || bad "sessões vivas: log=$(cat "$st/watch.log" 2>/dev/null | head -3 | tr '\n' ' ') sessões=$n"
  tmux -L "$sock" kill-server 2>/dev/null
}
