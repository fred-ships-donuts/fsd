#!/usr/bin/env node
// fsd-queue [agente] — a fila do agente agora, em até ~6 linhas (usado no reinício da sessão).
import * as L from './fsd-lib.mjs';
import { spawnSync } from 'node:child_process';
import { parseBoardList, kevinQueue } from './fsd-backlog.mjs';
const a = (process.argv[2] || L.ME).replace(/^fsd-/, ''); const login = `fsd-${a}`; const out = [];
const col = (c) => { const r = spawnSync(L.BIN + '/fsd-board', ['list', c], { encoding: 'utf8' }); const m = r.status === 0 && r.stdout.match(/\((\d+)\):\s*(.*)/); return m && Number(m[1]) ? `${c}: ${m[2].trim()}` : ''; };
const todo = L.REVIEWERS.includes(a) ? L.todo(login) : []; if (todo.length) out.push(`revisar: ${todo.map((p) => '#' + p.number).join(' ')}`);
const mine = L.openPrs().filter((p) => L.norm(p.author?.login) === login);
const prLines = [];
for (const p of mine) { const s = L.reviewState(p); prLines.push({ conflict: p.mergeable === 'CONFLICTING' && !s.changes.length && !L.ready(p), line: `meu PR #${p.number}: ${s.changes.length ? 'mudanças pedidas (fsd-review read ' + p.number + ')' : L.ready(p) ? 'pronto (fsd-merge ' + p.number + ')' : p.mergeable === 'CONFLICTING' ? 'conflito com a develop (fsd-dev sync -C <worktree>)' : `aprov ${s.approvers.length}/2`}` }); }
// Quem desenvolve: Changes Requested primeiro, depois o PR em conflito, o resto dos PRs e, por último, Ready for Development.
if (a === 'stuart') out.push(col(L.STAGE.changes), ...prLines.filter((x) => x.conflict).map((x) => x.line), ...prLines.filter((x) => !x.conflict).map((x) => x.line));
else out.push(...prLines.map((x) => x.line));
// Kevin: o Backlog é o trabalho essencial; o merge vem depois de cada item (#159). Ordem: decision, Backlog, desbloqueados, PRs prontos.
if (a === 'kevin') {
  const r = spawnSync(L.BIN + '/fsd-board', ['list', L.STAGE.backlog, '-t'], { encoding: 'utf8' });
  const ghNums = (label) => L.ghJson(['issue', 'list', '--label', label, '--state', 'open', '--json', 'number', '--limit', '100']).map((x) => x.number);
  out.push(...kevinQueue({
    decisions: ghNums('decision'), backlog: r.status === 0 ? parseBoardList(r.stdout) : [], blocked: ghNums('blocked'),
    unblocked: L.unblocked().map((x) => x.line), ready: L.openPrs().filter((p) => L.readyIdle(p)).filter((p) => !mine.includes(p)).map((p) => p.number),
  }));
}
if (a === 'mel') out.push(col(L.STAGE.archReady));
if (a === 'stuart') out.push(col(L.STAGE.devReady));
console.log(out.filter(Boolean).join('\n') || 'nada na fila');
