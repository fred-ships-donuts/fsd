#!/usr/bin/env node
// fsd-context-guard — hook dos agentes (PreToolUse do Monitor, PostToolUse, UserPromptSubmit, Stop).
//   Monitor com contexto > restartAbove → negado: fim de entrega é fsd-restart, e a sessão nova arma o Monitor.
// Julga sem gastar token:
//   livre = limit − outputReserve − atual − marginPct% (a API recusa o prompt antes do limit: reserva a saída) · custo = crescimento médio por chamada (últimas 20) · restam = livre ÷ custo
//   pesada = alguma das 3 últimas chamadas custou ≥ heavyFactor × a média → valem as faixas heavy
//   restam ≤ urgentAt ou livre ≤ urgentFree → 🔴 urgente · restam < mediumAt ou livre < mediumFree → 🟡 médio · senão nada.
//   (o piso de livre cobre a leitura grande, ex. um diff de revisão, que a média por chamada não prevê)   --print: mostra a conta (teste)
// Config: agents.json → claude_common.context (variáveis FSD_CONTEXT_* via fsd-agent).
import { openSync, readSync, fstatSync, closeSync, existsSync, readFileSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

// ── Mensagens (editar aqui). {used} {limit} {calls} {cost} {heavy} ──
const HANDOFF = 'WIP no GitHub, memory_handoff_begin (feito, falta, branch/worktree, próximo passo) e fsd-restart';
const MSG = {
  urgent: `**🔴 [prioridade alta] Contexto {used}/{limit}, restam ~{calls} chamadas (~{cost} cada{heavy}). Finalize urgentemente, o quanto antes, o processo vigente e faça handoff: ${HANDOFF}. Vale no meio da tarefa.**`,
  medium: `🟡 [prioridade média] Contexto {used}/{limit}, restam ~{calls} chamadas (~{cost} cada{heavy}). Finalize o processo vigente e faça handoff: ${HANDOFF}. Vale no meio da tarefa.`,
};
const SCREEN = { urgent: '🔴 contexto {used}/{limit}: handoff urgente (~{calls} chamadas)', medium: '🟡 contexto {used}/{limit}: finalizar e handoff (~{calls} chamadas)' };

const env = (n, d) => (Number(process.env[`FSD_CONTEXT_${n}`]) > 0 ? Number(process.env[`FSD_CONTEXT_${n}`]) : d);
const LIMIT = env('LIMIT', 200000), RESERVE = env('RESERVE', 32000), MARGIN = LIMIT * env('MARGIN_PCT', 5) / 100, FACTOR = env('HEAVY_FACTOR', 1.5);
const BANDS = { normal: [env('URGENT_AT', 2), env('MEDIUM_AT', 4)], heavy: [env('HEAVY_URGENT_AT', 3), env('HEAVY_MEDIUM_AT', 7)] };
const FREE = { urgent: env('URGENT_FREE', 15000), medium: env('MEDIUM_FREE', 30000) };
const WINDOW = 20, RECENT = 3, MIN_COST = 1000;

let input = {}; try { input = JSON.parse(readStdin() || '{}'); } catch { process.exit(0); }
const { used, cost: raw, n, peak } = sample(input.transcript_path);
const cost = Math.max(MIN_COST, raw), free = LIMIT - RESERVE - used - MARGIN, left = Math.max(0, free / cost);
const heavy = peak >= FACTOR * cost, [urgentAt, mediumAt] = BANDS[heavy ? 'heavy' : 'normal'];
const level = !used ? null : left <= urgentAt || free <= FREE.urgent ? 'urgent' : left < mediumAt || free < FREE.medium ? 'medium' : null;
const k = (x) => `${Math.round(x / 1000)}k`;
const fill = (t) => t.replace(/\{(\w+)\}/g, (_, v) => ({ used: k(used), limit: k(LIMIT), calls: left.toFixed(1), cost: k(cost), heavy: heavy ? `; pico de ${k(peak)}` : '' })[v]);

if (process.argv.includes('--print')) {
  console.log(`atual ${k(used)} · custo ~${k(cost)} (${n} chamadas) · pico ${k(peak)}${heavy ? ' → pesada' : ''} · livre ${k(free)} · restam ${left.toFixed(1)} · faixa ${heavy ? 'pesada' : 'normal'} (≤${urgentAt} urgente, <${mediumAt} médio; livre ≤${k(FREE.urgent)} urgente, <${k(FREE.medium)} médio) → ${level || 'nada'}${level ? `\n${fill(MSG[level])}` : ''}`);
  process.exit(0);
}
if (input.hook_event_name === 'PreToolUse') {
  let above = 60000; try { const j = JSON.parse(readFileSync(join(import.meta.dirname, '..', 'agents.json'), 'utf8'));
    above = j.agents?.[process.env.FSD_AGENT]?.context?.restartAbove || j.claude_common?.context?.restartAbove || above; } catch {}
  if (input.tool_name === 'Monitor' && used > above) console.log(JSON.stringify({ hookSpecificOutput: { hookEventName: 'PreToolUse', permissionDecision: 'deny',
    permissionDecisionReason: `Contexto ${k(used)} > ${k(above)}: não espere nesta sessão. Fim de entrega é fsd-restart (handoff antes só se houver contexto que o GitHub e a fsd-queue não têm); a sessão nova vê a fila e, sem trabalho, avisa o Kevin e arma o Monitor.` } }));
  process.exit(0);
}
if (!level) process.exit(0);

const ev = input.hook_event_name, state = join(tmpdir(), `fsd-ctx-${input.session_id || 'x'}.json`);
let st = {}; try { st = JSON.parse(readFileSync(state, 'utf8')); } catch {}
const out = (o, patch) => { try { writeFileSync(state, JSON.stringify({ ...st, ...patch })); } catch {} console.log(JSON.stringify({ ...o, systemMessage: fill(SCREEN[level]) })); };
// Stop: bloqueia uma vez por sessão o fim de turno sem handoff. Urgente: sempre; médio: ao aparecer e a cada prompt.
if (ev === 'Stop') { if (!input.stop_hook_active && !st.stopBlocked) out({ decision: 'block', reason: fill(MSG[level]) }, { stopBlocked: true }); }
else if ((ev === 'PostToolUse' || ev === 'UserPromptSubmit') && !(ev === 'PostToolUse' && level === 'medium' && st.level === 'medium'))
  out({ hookSpecificOutput: { hookEventName: ev, additionalContext: fill(MSG[level]) } }, { level });

function readStdin() { const c = [], b = Buffer.alloc(65536); let r; while ((r = readSync(0, b, 0, b.length, null)) > 0) c.push(Buffer.from(b.subarray(0, r))); return Buffer.concat(c).toString('utf8'); }

// Fim do transcript, só o agente principal: pontos [contexto, chamadas acumuladas] do mais novo ao mais velho.
// Uma resposta vira várias linhas com o mesmo usage; a chamada feita numa resposta faz o contexto crescer até a
// próxima, por isso conta antes do ponto. cost = média na janela; peak = maior custo nos RECENT intervalos com chamada.
function sample(path) {
  const r = { used: 0, cost: 0, n: 0, peak: 0 };
  if (!path || !existsSync(path)) return r;
  const fd = openSync(path, 'r');
  try {
    for (let size = fstatSync(fd).size, span = 1 << 20; ; span *= 4) {
      const start = Math.max(0, size - span), buf = Buffer.alloc(size - start);
      readSync(fd, buf, 0, buf.length, start);
      const lines = buf.toString('utf8').split('\n'); if (start > 0) lines.shift();
      const pts = []; let calls = 0;
      for (let i = lines.length - 1; i >= 0; i--) {
        if (!lines[i].includes('"assistant"')) continue;
        let j; try { j = JSON.parse(lines[i]); } catch { continue; }
        if (j.type !== 'assistant' || j.isSidechain || j.message?.model === '<synthetic>') continue;   // erro sintético vem com usage zerado
        const u = j.message?.usage, content = Array.isArray(j.message?.content) ? j.message.content : [];
        calls += content.filter((c) => c.type === 'tool_use').length;
        if (u) pts.push([(u.input_tokens || 0) + (u.cache_read_input_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.output_tokens || 0), calls]);
        if (calls - (pts[0]?.[1] || 0) >= WINDOW && pts.length > 1) break;
      }
      if (pts.length) {
        const [now, old] = [pts[0], pts[pts.length - 1]], m = old[1] - now[1];
        r.used = now[0];
        if (m > 0 && now[0] > old[0]) Object.assign(r, { cost: (now[0] - old[0]) / m, n: m });
        for (let i = 0, seen = 0; i + 1 < pts.length && seen < RECENT; i++) {
          const c = pts[i + 1][1] - pts[i][1];
          if (c > 0) { r.peak = Math.max(r.peak, (pts[i][0] - pts[i + 1][0]) / c); seen++; }
        }
      }
      if (r.n >= WINDOW || start === 0) return r;
    }
  } finally { closeSync(fd); }
}
