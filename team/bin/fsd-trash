#!/usr/bin/env bash
# fsd-trash <caminho…> — "apagar" sem rm: move para /tmp/fsd-trash/<agente>/<data-hora>-<nome> (volta com mv).
# Evita a caixa de permissão do Claude Code ("rm perigoso"), que trava a sessão. Esvazia o que tiver mais de 3 dias;
# o /tmp some ao reiniciar a máquina. Sem --dry: FSD_DRY=1 só mostra.
set -uo pipefail
[ $# -gt 0 ] || { echo "uso: fsd-trash <caminho…>" >&2; exit 2; }
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
repo="${FSD_REPO:-$(dirname "$(dirname "$HERE")")}"
dir="/tmp/fsd-trash/${FSD_AGENT:-autor}"; mkdir -p -m 700 "$dir"
find "/tmp/fsd-trash" -mindepth 2 -maxdepth 2 -mtime +3 -exec rm -rf -- {} + 2>/dev/null
ts=$(date +%Y%m%d-%H%M%S); rc=0
for p in "$@"; do
  [ -e "$p" ] || [ -L "$p" ] || { echo "não existe: $p" >&2; rc=1; continue; }
  abs=$(realpath -s -- "$p")
  case "$abs" in /|/home|/home/*/|"$HOME"|/media|/media/*/Projects|"$repo") echo "recusado: $abs" >&2; rc=1; continue;; esac
  dest="$dir/$ts-$(basename -- "$abs")"; n=1; while [ -e "$dest" ]; do dest="$dir/$ts-$n-$(basename -- "$abs")"; n=$((n+1)); done
  if [ -n "${FSD_DRY:-}" ]; then echo "[dry] $abs → $dest"; continue; fi
  mv -- "$abs" "$dest" && echo "lixeira: $abs → $dest" || rc=1
done
exit $rc
