#!/usr/bin/env node
// fsd-dev start <n> [slug] [--fix|--docs|--chore]   com tarefa: card → Developing (Stuart); worktree <tipo>/<n>-<slug> (feature/ por
//                                       padrão) a partir da origin/develop, com o issue gravado no branch (branch.<b>.fsd-issue,
//                                       lido pelo fsd-pr open); mostra o issue e a passagem. Um card por vez: recusa (exit 1, quadro intacto)
//                                       se o agente já tem outro em Developing ou Changes Requested; PR em In Review sem mudança pedida não conta.
// fsd-dev start - <slug> [--fix|--docs|--chore]     sem tarefa: worktree <tipo>/<slug>, sem issue nem quadro.
// fsd-dev sync -C <worktree>             git pull da develop no branch (merge comum): "ok" ou "conflito: <arquivos>"
// Nunca troque de branch na pasta principal: cada trabalho vive no seu worktree em .claude/worktrees/.
import * as L from './fsd-lib.mjs';
import { markSet } from './fsd-mark.mjs';
import { existsSync, readFileSync, appendFileSync, mkdirSync } from 'node:fs';
import { dirname } from 'node:path';
const a = process.argv.slice(2); const [cmd, n] = a;
const opt = (k) => { const i = a.indexOf(k); return i >= 0 ? a[i + 1] : undefined; };
const slugify = (t) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40).replace(/^-+|-+$/g, '');
if (cmd === 'start') {
  const task = n !== '-';
  if (task && !/^\d+$/.test(n || '')) L.die('uso: fsd-dev start <n> [slug] [--fix|--docs|--chore] (com tarefa) | fsd-dev start - <slug> [--fix|--docs|--chore] (sem tarefa)', 2);
  const i = task ? L.issue(n) : null;
  const raw = a[2] && !a[2].startsWith('-') ? a[2] : task ? i.title.replace(new RegExp(`^(F-\\w+:?|(${L.BRANCH_TYPES.join('|')})(\\([^)]*\\))?!?:)\\s*`, 'i'), '') : '';
  const slug = slugify(raw); if (!slug) L.die(`faltou o slug: fsd-dev start ${task ? n : '-'} <slug>`, 2);
  // Um card por vez: só o Developing conta (Changes Requested é fila). Card novo com outro em Developing → recusa antes de criar ou mover qualquer coisa;
  // correção (card com PR aberto) com outro em Developing → o outro volta para Ready for Development (worktree mantido): correção primeiro.
  const branch0 = `${a.includes('--fix') ? 'fix' : a.includes('--docs') ? 'docs' : a.includes('--chore') ? 'chore' : 'feature'}/${n}-${slug}`;
  const open = task ? L.openPrs().find((x) => x.headRefName === branch0) : null;
  let sentBack = '';
  if (task && L.WHO[L.STAGE.dev].includes(L.ME)) {
    const rule = L.oneCardRule(L.devCards(), Number(n), !!open);
    if (rule.refuse) L.die(`fsd-dev: ${L.ME} already has #${rule.refuse.n} in ${rule.refuse.col}; finish it or move it back to ${L.STAGE.devReady}`, 1);
    if (rule.back.length) sentBack = L.board(L.STAGE.devReady, rule.back);
  }
  const type = a.includes('--fix') ? 'fix' : a.includes('--docs') ? 'docs' : a.includes('--chore') ? 'chore' : 'feature';
  // Sessão nova (F2.2): o worktree fica na home do papel (0700), fora do repositório compartilhado; o fetch não grava o FETCH_HEAD
  // (é do supervisor), o branch nasce sem upstream e as marcas vão para ~/.fsd/marks.json (o .git/config é do root).
  const SESSION = process.env.FSD_RUNNER === 'session';
  const branch = task ? `${type}/${n}-${slug}` : `${type}/${slug}`; const dir = SESSION ? `${process.env.HOME}/wt/${branch.replace('/', '-')}` : `${L.REPO_DIR}/.claude/worktrees/${branch.replace('/', '-')}`;
  const ex = `${L.REPO_DIR}/.git/info/exclude`; if (!SESSION) { try { if (!readFileSync(ex, 'utf8').includes('.claude/worktrees/')) appendFileSync(ex, '\n.claude/worktrees/\n'); } catch {} }
  L.run('git', ['-C', L.REPO_DIR, 'fetch', '-q', ...(SESSION ? ['--no-write-fetch-head'] : []), 'origin', 'develop']);
  if (!existsSync(dir)) {
    const have = L.run('git', ['-C', L.REPO_DIR, 'rev-parse', '--verify', '-q', `refs/heads/${branch}`], { allowFail: true }).ok;
    if (SESSION) mkdirSync(dirname(dir), { recursive: true });
    L.write('git', ['-C', L.REPO_DIR, 'worktree', 'add', '-q', ...(have ? [dir, branch] : [...(SESSION ? ['--no-track'] : []), dir, '-b', branch, 'origin/develop'])]);
  }
  // A tarefa fica gravada no branch: o fsd-pr open só a reconhece por aqui (o número no nome não conta).
  // Dono do worktree (fim do dia, T3.4.2): o supervisor só aposenta a sessão sem nada deste papel só no disco.
  if (L.DRY) console.log(`[dry] marcas de ${branch}: issue=${task ? n : '-'} agent=${L.ME || '-'}${SESSION ? ' (~/.fsd/marks.json)' : ' (git config)'}`);
  else markSet(branch, { agent: L.ME || null, issue: task ? n : null }, { repo: L.REPO_DIR });
  // Card que já tem PR vai para a coluna calculada (pulled); sem PR é trabalho novo: Developing.
  const b = !task ? '' : open ? L.boardPr(open, { pulled: true }) : L.board(L.STAGE.dev, [Number(n)]);
  console.log(`worktree ${dir} | branch ${branch}${[sentBack, b].filter(Boolean).map((x) => ' | ' + x).join('')}`);
  if (task) console.log(L.run(L.BIN + '/fsd-issue', ['show', n]));
} else if (cmd === 'sync') {
  const dir = opt('-C'); if (!dir) L.die('uso: fsd-dev sync -C <worktree>', 2);
  const r = L.write('git', ['-C', dir, 'pull', '--no-edit', '--no-rebase', 'origin', 'develop'], { allowFail: true });
  if (r.ok) L.die('ok', 0);
  const files = L.run('git', ['-C', dir, 'diff', '--name-only', '--diff-filter=U']).split('\n').filter(Boolean);
  L.die(files.length ? `conflito: ${files.join(' ')} (resolva, git add, git commit, fsd-pr open -C ${dir} --reply -)` : `merge falhou: ${r.err}`, 1);
} else L.die('uso: fsd-dev start <n|-> [slug] [--fix|--docs|--chore] | sync -C <worktree>', 2);
