#!/usr/bin/env node
// fsd-eval run [<papel>|<arquivo.json>…] [--real] [--json] | catalog — evals por papel (F4.9). Sem --real, cada cenário roda com o
// stub-claude e o roteiro de ouro dele (prova o executor, 0 token). Com --real, a sessão de verdade (M; só no ambiente isolado, E2).
// Saída: o resultado de cada cenário, a nota por papel e exit 0 só se todo papel chegar a minRatio (80%).
import { readFileSync } from 'node:fs';
const E = await import('./fsd-eval.mjs');
const [cmd, ...a] = process.argv.slice(2);
if (cmd === 'catalog') {
  const c = JSON.parse(readFileSync(`${E.EVALS}/catalog.json`, 'utf8'));
  for (const b of c.behaviors) console.log(`${b.scenarios.length ? 'ok   ' : 'FALTA'} ${b.role.padEnd(7)} ${b.id}: ${b.text}`);
  process.exit(c.behaviors.every((b) => b.scenarios.length) ? 0 : 1);
}
if (cmd !== 'run') { console.log('uso: fsd-eval run [<papel>|<arquivo.json>…] [--real] [--json] | catalog'); process.exit(2); }
const targets = a.filter((x) => !x.startsWith('--'));
const scs = targets.length ? targets.flatMap((t) => (t.endsWith('.json') ? [JSON.parse(readFileSync(t, 'utf8'))] : E.loadScenarios(t))) : E.loadScenarios();
const results = []; for (const sc of scs) results.push(await E.run(sc, { mode: a.includes('--real') ? 'real' : 'stub' }));
const sc = E.score(results);
if (a.includes('--json')) console.log(JSON.stringify({ results, score: sc }));
else {
  for (const r of results) console.log(`${r.pass ? 'PASS' : 'FAIL'} ${r.role.padEnd(7)} ${r.id}${r.pass ? '' : `: ${r.reasons.join('; ')}`}`);
  for (const [role, s] of Object.entries(sc)) console.log(`${role}: ${s.pass}/${s.total} (${Math.round(s.ratio * 100)}%)${s.ok ? '' : ' abaixo do mínimo'}`);
}
process.exit(Object.values(sc).every((s) => s.ok) ? 0 : 1);
