#!/usr/bin/env node
// Verificação de QA em comandos curtos (estado em /tmp/fsd-qa-<agente>/state.json):
// fsd-qa prep <n>                     issue, aceite numerado, worktree, build e tmux 80x24 (HOME temporário, alias fsd); card → In Review
// fsd-qa run <k> "<comando>" | run <k> - <<'X' …   roda no item k (repita o mesmo k para mais comandos), espera o fim, mostra a saída + EXIT=n
//                                     (o EXIT sai sozinho: comando com $? é recusado, porque pegaria o código do comando errado)
// fsd-qa key [--text] <tecla…>        teclas (Down, Enter, Escape, C-c…) ou texto literal (--text) no item atual; mostra a tela
// fsd-qa verdict <k> PASS|FAIL "<esperado>"   |   fsd-qa verdict --all-pass   (marca PASS os itens rodados sem veredito)
//                                     1º FAIL de um item rodado não vale ainda: guarda a tentativa e pede o item de novo, do zero.
//                                     O 2º FAIL confirma; um PASS na repetição sai no relatório como "resultado oscilou".
// FSD_QA_REDO=<n> fsd-qa prep <n>     ÚLTIMO RECURSO: refaz a verificação no mesmo SHA já verificado, só no PR <n>. Só vale com
//                                     comentário do autor no PR contendo FSD_QA_REDO (team.md, "Impasse total").
// fsd-qa finish                       confere que todo item foi rodado, publica o relatório em inglês (approve/request-changes), card, avisos, limpeza
// fsd-qa bug "<título>" "<esperado>" [k]   issue de bug com o item k (padrão: o último rodado) e avisa o kevin
// fsd-qa clean                        fecha o tmux e remove o worktree
import * as L from './fsd-lib.mjs';
import { rmSync, readdirSync } from 'node:fs';
const Q = `/tmp/fsd-qa-${L.ME || 'x'}`, SF = `${Q}/state.json`, T = `fsd-qa-${L.ME || 'x'}`;
const [cmd, ...a] = process.argv.slice(2);
const tmux = (...x) => L.run('tmux', x, { allowFail: true });
const sleep = (ms) => L.run('sleep', [String(ms / 1000)]);
const tidy = (txt) => txt.split('\n').map((l) => l.replace(/\s+$/, '')).filter((l) => !/__EXIT=|^__BEGIN$|^\$ ?$/.test(l) && !l.includes('echo __EXIT') && !l.includes('echo __BEGIN')).join('\n').replace(/\n{3,}/g, '\n\n').trim();
const after = (raw) => { const i = raw.lastIndexOf('\n__BEGIN\n'); return i >= 0 ? raw.slice(i + 9) : raw.startsWith('__BEGIN\n') ? raw.slice(8) : raw; };
const pane = (hist) => tmux('capture-pane', '-p', '-t', T, ...(hist ? ['-S', '-300'] : [])).out;
function need() {
  const s = L.state(SF); if (!s) L.die('nenhuma verificação em andamento: fsd-qa prep <n>', 1);
  if (s.build && !tmux('has-session', '-t', T).ok) L.die('terminal de teste fechado: rode fsd-qa prep ' + s.n + ' de novo', 1);
  return s;
}
function clean(s) {
  tmux('kill-session', '-t', T);
  let ds = []; try { ds = readdirSync(Q).filter((x) => /^pr-\d+$/.test(x)); } catch {}
  for (const d of ds) L.run('git', ['-C', L.REPO_DIR, 'worktree', 'remove', '--force', `${Q}/${d}`], { allowFail: true });
  L.run('git', ['-C', L.REPO_DIR, 'worktree', 'prune'], { allowFail: true });
  if (s?.n) L.run('git', ['-C', L.REPO_DIR, 'branch', '-D', '-q', `qa-${L.ME}-${s.n}`], { allowFail: true });
}
const row = (s, k) => (s.rows[k] ||= { cmd: '', screen: '', exit: null, verdict: null, expected: '' });

if (cmd === 'prep') {
  const n = a[0]; if (!/^\d+$/.test(n || '')) L.die('uso: fsd-qa prep <n>', 2);
  const p = L.pr(n); if (p.state !== 'OPEN') L.die(`PR #${n} está ${p.state}`, 1);
  const st = L.myStatus(p);
  if (st === 'ok' || st === 'changes') {
    if (process.env.FSD_QA_REDO !== n) L.die(`JÁ VERIFICADO no ${p.headRefOid.slice(0, 7)}: nada a fazer até um commit novo`, 0);
    // Último recurso (team.md, "Impasse total"): só com a decisão escrita pelo próprio autor no PR, citando FSD_QA_REDO.
    const author = process.env.FSD_AUTHOR || '';
    const cs = L.ghJson(['api', `repos/${L.REPO}/issues/${n}/comments`, '--paginate']) || [];
    if (!cs.some((c) => c.user?.login === author && c.body.includes('FSD_QA_REDO')))
      L.die(`FSD_QA_REDO recusado: o PR #${n} não tem comentário do autor (${author}) com FSD_QA_REDO. É o último recurso do "Impasse total" (team.md): o Kevin pede a decisão no PR e o time espera.`, 1);
    console.log(`FSD_QA_REDO: decisão do autor no PR #${n}; nova verificação no ${p.headRefOid.slice(0, 7)}`);
  }
  const i = L.closes(p.body)[0];
  if (!i) L.die(`PR #${n} sem "Closes #<issue>": avise o autor (fsd-notify ${L.agentOf(p.author?.login)} "PR #${n} sem Closes #<issue>")`, 1);
  const ac = L.acceptance(L.issue(i).body);
  if (!ac.items.length) L.die(`issue #${i} sem itens de aceite: fsd-notify kevin "#${i} sem Acceptance"`, 1);
  clean(L.state(SF)); rmSync(Q, { recursive: true, force: true }); L.run('mkdir', ['-p', `${Q}/home`, `${Q}/work`]);
  L.run('git', ['-C', L.REPO_DIR, 'fetch', '-q', '--force', 'origin', `pull/${n}/head:qa-${L.ME}-${n}`]);
  L.run('git', ['-C', L.REPO_DIR, 'worktree', 'add', '-q', `${Q}/pr-${n}`, `qa-${L.ME}-${n}`]);
  const sha = L.run('git', ['-C', `${Q}/pr-${n}`, 'rev-parse', 'HEAD']);
  const b1 = L.run('npm', ['ci', '--silent', '--no-audit', '--no-fund'], { cwd: `${Q}/pr-${n}`, allowFail: true });
  const b2 = b1.ok ? L.run('npm', ['run', '-s', 'build'], { cwd: `${Q}/pr-${n}`, allowFail: true }) : b1;
  L.saveState(SF, { n: Number(n), i, sha, items: ac.items, rows: [], build: b2.ok, buildErr: b2.ok ? '' : b2.err });
  if (!b2.ok) L.die(`BUILD FALHOU no ${sha.slice(0, 7)}: ${b2.err.slice(0, 300)}\n→ fsd-qa finish`, 1);
  tmux('new-session', '-d', '-s', T, '-x', '80', '-y', '24', '-c', `${Q}/work`);
  tmux('send-keys', '-t', T, `export HOME=${Q}/home PS1='$ '; alias fsd='node ${Q}/pr-${n}/dist/cli/fsd.js'; clear`, 'Enter');
  const bd = L.board(L.STAGE.review, [i]);
  console.log(`PR #${n} | issue #${i} | ${sha.slice(0, 7)} | build ok | ${ac.items.length} itens${bd ? ' | ' + bd : ''}`);
  console.log(ac.items.map((x, k) => `${k + 1}. ${x.slice(0, 200)}`).join('\n'));
} else if (cmd === 'run') {
  const s = need(); const k = Number(a[0]); const c = (a[1] === '-' ? L.readArgFile('-') : a.slice(1).join(' ')).trim();
  if (!(k >= 1 && k <= s.items.length) || !c) L.die(`uso: fsd-qa run <k> "<comando>" (itens 1..${s.items.length})`, 2);
  if (c.includes('$?')) L.die(`comando com $? recusado: o fsd-qa já mostra o EXIT=n do comando no fim da saída (e da tela interativa, depois do fsd-qa key que a fecha). Rode só: fsd-qa run ${k} "${c.replace(/\s*;?\s*echo[^;]*\$\?[^;]*/g, '').trim()}"`, 2);
  let note = ''; if (s.cur && s.rows[s.cur - 1]?.exit === null) { tmux('send-keys', '-t', T, 'C-c'); sleep(300); note = '(item anterior encerrado com C-c)\n'; }
  tmux('send-keys', '-t', T, `clear; echo __BEGIN; ${c}; echo __EXIT=$?`, 'Enter');
  let code = null, vis = '';
  for (let t = 0; t < 50; t++) { sleep(300); vis = after(pane(false)); const m = vis.match(/__EXIT=(\d+)/); if (m) { code = Number(m[1]); break; } }
  const all = tidy(code === null ? vis : after(pane(true))); const lines = all.split('\n'); const shown = lines.length > 40 ? `(+${lines.length - 40} linhas acima)\n` + lines.slice(-40).join('\n') : all;
  const r = row(s, k - 1); r.cmd = r.cmd ? `${r.cmd} ; ${c}` : c; r.screen = all.slice(-3000); r.exit = code; r.verdict = null; s.cur = k; L.saveState(SF, s);
  console.log(`${note}[item ${k}] ${shown || '(sem saída)'}\n${code === null ? 'TELA INTERATIVA (sem fim em 15s): fsd-qa key …' : 'EXIT=' + code}`);
} else if (cmd === 'key') {
  const s = need(); const lit = a[0] === '--text'; const keys = lit ? a.slice(1) : a; if (!keys.length) L.die('uso: fsd-qa key [--text] <tecla…>', 2);
  tmux('send-keys', '-t', T, ...(lit ? ['-l', keys.join(' ')] : keys)); sleep(500);
  const vis = pane(false); const m = vis.match(/__EXIT=(\d+)/); const sc = tidy(vis);
  if (s.cur) { const r = row(s, s.cur - 1); r.screen = sc.slice(-3000); r.cmd += ` ⟶ ${keys.join(' ')}`; if (m) r.exit = Number(m[1]); L.saveState(SF, s); }
  console.log((sc || '(tela vazia)') + (m ? `\nEXIT=${m[1]}` : ''));
} else if (cmd === 'verdict') {
  const s = need();
  if (a[0] === '--all-pass') { const skip = []; s.rows.forEach((r, k) => { if (r && r.cmd && !r.verdict) { if (r.exit === 0) r.verdict = 'PASS'; else skip.push(k + 1); } }); if (skip.length) console.log(`não marcados (EXIT≠0 ou tela aberta): ${skip.join(',')} → fsd-qa verdict <k> PASS|FAIL "<esperado>"`); }
  else { const k = Number(a[0]); const v = (a[1] || '').toUpperCase(); if (!(k >= 1 && k <= s.items.length) || !['PASS', 'FAIL'].includes(v)) L.die(`uso: fsd-qa verdict <k> PASS|FAIL "<esperado>" | --all-pass (itens 1..${s.items.length})`, 2); const r = row(s, k - 1); if (v === 'PASS' && !r.cmd) L.die(`item ${k} não foi rodado: fsd-qa run ${k} "…" antes de PASS`, 1); if (v === 'PASS' && r.exit !== 0 && !a[2]) L.die(`item ${k} saiu com ${r.exit ?? 'tela aberta'}: PASS só com "<esperado>" dizendo por que isso é o certo`, 1);
    // 1º FAIL de item rodado: guarda a tentativa e pede a repetição do zero (separa erro do processo de erro do código).
    if (v === 'FAIL' && r.cmd && !r.first) {
      s.rows[k - 1] = { cmd: '', screen: '', exit: null, verdict: null, expected: a[2] || '', first: { cmd: r.cmd, screen: r.screen, exit: r.exit, expected: a[2] || '' } };
      L.saveState(SF, s);
      L.die(`item ${k}: 1ª falha guardada, ainda não vale. Repita o item ${k} DO ZERO (o preparo dele também), com fsd-qa run ${k} "…", e marque de novo: FAIL de novo confirma; PASS sai no relatório como resultado que oscilou.`, 0);
    }
    r.verdict = v; r.expected = a[2] || r.expected || ''; }
  L.saveState(SF, s); console.log(s.items.map((_, k) => `${k + 1}:${s.rows[k]?.verdict || (s.rows[k]?.cmd ? '?' : '-')}`).join(' '));
} else if (cmd === 'finish') {
  const s = L.state(SF) || L.die('nenhuma verificação em andamento: fsd-qa prep <n>', 1);
  let rows = s.rows;
  if (!s.build) rows = [{ cmd: 'npm ci && npm run build', screen: s.buildErr || 'build failed', exit: 1, verdict: 'FAIL', expected: 'build passes' }];
  else {
    const miss = s.items.map((_, k) => k + 1).filter((k) => !rows[k - 1]?.verdict);
    if (miss.length) L.die(`itens sem veredito: ${miss.join(',')} (fsd-qa run <k> "…" e fsd-qa verdict; item sem como rodar: fsd-qa verdict <k> FAIL "<motivo>")`, 1);
  }
  const p = L.pr(s.n); if (p.headRefOid !== s.sha) L.die(`o PR mudou (${p.headRefOid.slice(0, 7)} ≠ ${s.sha.slice(0, 7)}): rode fsd-qa prep ${s.n} de novo`, 1);
  const fails = rows.filter((r) => r.verdict === 'FAIL'); const cell = (x) => String(x || '').replace(/\|/g, '\\|').replace(/\n/g, ' ').slice(0, 90);
  let body = `Verified on commit ${s.sha.slice(0, 7)}, 80x24 terminal, temporary HOME.\n\n| # | Acceptance item | Command | Actual | Result |\n|---|---|---|---|---|\n`;
  body += rows.map((r, k) => `| ${k + 1} | ${cell(r.expected || s.items[k] || '')} | ${r.cmd ? '`' + cell(r.cmd) + '`' : '(not run)'} | exit ${r.exit ?? '-'}: ${cell(r.screen.split('\n').slice(-2).join(' '))} | ${r.verdict} |`).join('\n');
  const rep = rows.map((r, k) => (r.first ? `- Item ${k + 1}: the 1st attempt failed (exit ${r.first.exit ?? '-'}: ${cell(r.first.screen.split('\n').slice(-2).join(' '))}); repeated from scratch: **${r.verdict}**.${r.verdict === 'PASS' ? ' The result oscillated: a mistake in the 1st run, or an intermittent bug.' : ''}` : '')).filter(Boolean);
  if (rep.length) body += `\n\n## Repeated items\n${rep.join('\n')}`;
  if (fails.length) body += `\n\n## Steps to reproduce\n${rows.map((r, k) => (r.verdict === 'FAIL' ? `${k + 1}. \`${r.cmd}\`\n\n\`\`\`\n${r.screen.slice(-800)}\n\`\`\`` : '')).filter(Boolean).join('\n')}`;
  L.ghw(['api', '-X', 'POST', `repos/{owner}/{repo}/pulls/${s.n}/reviews`, '-f', `event=${fails.length ? 'REQUEST_CHANGES' : 'APPROVE'}`, '-f', `commit_id=${s.sha}`, '-F', 'body=@-'], { input: body });
  const after = L.DRY ? '' : L.afterReview(s.n); if (!L.DRY) { clean(s); rmSync(SF, { force: true }); }
  console.log([`#${s.n} ${fails.length ? `mudanças pedidas (itens ${rows.map((r, k) => (r.verdict === 'FAIL' ? k + 1 : 0)).filter(Boolean).join(',')})` : 'aprovado'}`, after].filter(Boolean).join(' | '));
} else if (cmd === 'bug') {
  const s = need(); const [title, expected, kk] = a; const k = kk ? Number(kk) : s.cur; const r = k && s.rows[k - 1];
  if (!title || !expected || !r) L.die('uso: fsd-qa bug "<título>" "<esperado>" [k] (depois de um fsd-qa run)', 2);
  const body = `## What\nSee Steps.\n\n## Why\nFound while verifying PR #${s.n}.\n\n## Steps\n1. \`${r.cmd}\`\n\n## Expected\n${expected}\n\n## Actual\n\`\`\`\n${r.screen.slice(-1500)}\n\`\`\`\nexit ${r.exit ?? '-'}\n\n## Acceptance\n1. \`${r.cmd}\` → ${expected}\n\n## Environment\ncommit ${s.sha.slice(0, 7)} (PR #${s.n}), Node ${process.version}, terminal 80x24\n\n## References\n- PR #${s.n}\n`;
  const url = L.ghw(['issue', 'create', '--title', title, '--label', 'bug,area:cli,size:S', '--body-file', '-'], { input: body });
  console.log([`bug ${url}`, L.board(L.STAGE.backlog, [Number(url.split('/').pop())]), L.notify(['kevin'], `Bug aberto na verificação do PR #${s.n}: ${url}`)].filter(Boolean).join(' | '));
} else if (cmd === 'clean') { clean(L.state(SF)); rmSync(Q, { recursive: true, force: true }); console.log('limpo');
} else L.die('uso: fsd-qa prep <n> | run <k> "<cmd>" | key [--text] <tecla…> | verdict <k> PASS|FAIL "<esperado>" | verdict --all-pass | finish | bug "<título>" "<esperado>" [k] | clean', 2);
