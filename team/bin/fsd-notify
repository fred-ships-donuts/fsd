#!/usr/bin/env bash
# fsd-notify <agente[,agente…]> "<texto>" — entrega um aviso na sessão tmux fsd-<agente> (zero tokens para quem envia).
# Sessão fechada ou parada numa pergunta de permissão: o aviso fica em $FSD_STATE/inbox/<agente> e chega no próximo SessionStart
# ou no próximo fsd-wait do agente. Saída: "delivered: a,b" (se algum recebeu) e "<agente> did not receive: queued" por agente na fila.
# FSD_DRY=1 só pula o paste no tmux (o resto, inclusive a fila, roda: aponte FSD_STATE para um diretório temporário). O oficial fica no GitHub.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
to="${1:?uso: fsd-notify <agente[,agente…]> \"<texto>\"}"; text="${2:?uso: fsd-notify <agente[,agente…]> \"<texto>\"}"
from="${FSD_AGENT:-autor}"; got=(); queued=(); names=()
IFS=',' read -ra raw <<<"$to"
for a in "${raw[@]}"; do
  [ -z "$a" ] && continue
  { [[ "$a" =~ ^[a-z0-9_-]+$ ]] && "$HERE/fsd-inbox" valid "$a"; } || { echo "fsd-notify: unknown agent: $a" >&2; exit 2; }
  names+=("$a")
done
for a in "${names[@]}"; do
  [ "$a" = "$from" ] && continue
  if ! tmux has-session -t "fsd-$a" 2>/dev/null || tmux capture-pane -p -t "fsd-$a" | tail -10 | grep -qiE 'Do you want|❯ 1\. Yes'; then
    if "$HERE/fsd-inbox" append "$a" "$from" "$text"; then queued+=("$a"); else echo "$a did not receive: not queued (inbox write failed)"; fi
    continue
  fi
  if [ -n "${FSD_DRY:-}" ]; then echo "[dry] would deliver to $a"; got+=("$a"); continue; fi
  printf '[fsd-aviso de %s] %s' "$from" "$text" | tmux load-buffer -b "n-$a-$$" - \
    && tmux paste-buffer -p -d -b "n-$a-$$" -t "fsd-$a" && sleep 0.4 && tmux send-keys -t "fsd-$a" Enter && got+=("$a")
done
[ ${#got[@]} -gt 0 ] && (IFS=,; echo "delivered: ${got[*]}")
for a in "${queued[@]}"; do echo "$a did not receive: queued"; done
exit 0
