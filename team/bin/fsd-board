#!/usr/bin/env node
// fsd-board — o quadro do time, assinado pelo bot do agente ($FSD_AGENT).
//   fsd-board list [coluna] [-t]       uma linha por coluna (Done vira contagem; -t mostra títulos)
//   fsd-board list --json              todos os itens: [{"column","number","type","updatedAt"}] (o fsd-progress usa)
//   fsd-board move "<coluna>" <n…>     põe os issues/PRs no quadro, se faltarem, e muda a coluna (também aceita: move <n> "<coluna>")
//   fsd-board rename [--dry]           põe nas colunas do GitHub os nomes de fsd-stages.mjs (com o responsável entre parênteses), no lugar,
//                                      e cria as colunas que faltam (na ordem de fsd-stages.mjs): mesmas opções, nenhum card muda de
//                                      coluna (conferido antes e depois). --dry só mostra o plano.
// Coluna: a chave (devReady), o nome com ou sem o responsável ("Ready for Development (Stuart)") ou um nome antigo; o quadro do GitHub
// pode estar com os nomes velhos ou novos (stageName() dos dois lados), então o código serve antes e depois do rename.
// Config em agents.json: "board": { "owner": "<org>", "number": <n>, "repo": "<dono>/<repo>" }
// e "org_installation_id" em cada agente. Os tokens vêm do fsd-token; o agente nunca os vê.
import { execFileSync } from 'node:child_process';
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

import { STAGE, stageName, ownersOf } from './fsd-stages.mjs';
const HERE = dirname(fileURLToPath(import.meta.url));
const cfg = JSON.parse(readFileSync(join(HERE, '..', 'agents.json'), 'utf8'));
const agent = process.env.FSD_AGENT;
const die = (m, c = 1) => { console.error(`fsd-board: ${m}`); process.exit(c); };
process.on('uncaughtException', (e) => die(String(e.message || e).split('\n')[0].slice(0, 200), 4));
process.on('unhandledRejection', (e) => die(String(e?.message || e).split('\n')[0].slice(0, 200), 4));
if (!agent || !cfg.agents[agent]) die('rode dentro de uma sessão aberta pelo fsd-agent', 2);
const board = cfg.board;
// FSD_BOARD_FAKE=<arquivo>: o quadro num JSON ({ "<n>": "<coluna>" }) para os ciclos dry (F4.5–F4.8, com o fake-gh). Sem rede nem token.
const FAKE = process.env.FSD_BOARD_FAKE;
const COLS = Object.values(STAGE);
const fakeLoad = () => { try { return JSON.parse(readFileSync(FAKE, 'utf8')); } catch { return {}; } };
if (FAKE) {
  const [c, ...r] = process.argv.slice(2); const quiet = r.includes('--quiet'); const a = r.filter((x) => x !== '--quiet' && x !== '-t' && x !== '--json');
  const b = fakeLoad();
  if (c === 'move') {
    let col, nums; if (a.length === 2 && /^\d+$/.test(a[0]) && !/^\d+$/.test(a[1])) { nums = [a[0]]; col = a[1]; } else { col = a[0]; nums = a.slice(1); }
    if (!col || !nums.length || nums.some((n) => !/^\d+$/.test(n))) die('uso: fsd-board move "<coluna>" <n…>', 2);
    col = stageName(col); if (!COLS.includes(col)) die(`coluna "${col}" não existe. Colunas: ${COLS.join(', ')}`, 2);
    for (const n of nums) b[n] = col; writeFileSync(FAKE, JSON.stringify(b, null, 1));
    const own = ownersOf(col); let told = '';
    if (own && !quiet) { try { told = execFileSync(join(HERE, 'fsd-notify'), [own.join(','), `${nums.map((n) => '#' + n).join(',')} → ${col}`], { encoding: 'utf8' }).trim(); } catch {} }
    console.log(`${nums.map((n) => '#' + n).join(',')} → ${col}${told && told !== 'ninguém recebeu' ? ' | avisados: ' + told : ''}`);
  } else if (c === 'list') {
    if (r.includes('--json')) console.log(JSON.stringify(Object.entries(b).map(([n, column]) => ({ column, number: Number(n), type: 'Issue', updatedAt: null }))));
    else { const want = a[0] ? stageName(a[0]) : null; for (const o of COLS.filter((x) => !want || x === want)) { const here = Object.keys(b).filter((n) => b[n] === o); if (here.length || want) console.log(`${o} (${here.length}): ${here.map((n) => '#' + n).join(' ')}`); } }
  } else die('fsd-board (fake): só list e move', 2);
  process.exit(0);
}
if (!board?.owner || !board?.number || !board?.repo) {
  const av = process.argv.slice(2);
  if (av[0] === 'move' && !av.includes('--quiet') && !process.env.FSD_DRY) {
    const nums = av.slice(1).filter(x => /^\d+$/.test(x)); const col = av.slice(1).find(x => !/^\d+$/.test(x)) || '';
    const own = ownersOf(col)?.join(',');
    if (own) { try { execFileSync(join(HERE, 'fsd-notify'), [own, `${nums.map(n => '#' + n).join(',')} → ${col}`]); } catch {} }
  }
  die('quadro ainda não configurado (falta "board" no agents.json)', 2);
}
const tok = new Map();
// Sessão nova (F2.3, C1): o token vem do arquivo do papel (fsd-token-file, pelo usuário Unix); o fsd-token lê as chaves, que o papel não vê.
const SESSION = process.env.FSD_RUNNER === 'session';
const token = (scope) => { if (!tok.has(scope)) { try { tok.set(scope, execFileSync(join(HERE, SESSION ? 'fsd-token-file' : 'fsd-token'), SESSION ? (scope === 'org' ? ['org'] : []) : (scope === 'org' ? [agent, 'org'] : [agent]), { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()); } catch (e) { die(String(e.stderr || e.message).trim().split('\n')[0], 4); } } return tok.get(scope); };

async function gql(scope, query, variables = {}) {
  const r = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: { Authorization: `Bearer ${token(scope)}`, 'Content-Type': 'application/json', 'User-Agent': 'fsd-board' },
    body: JSON.stringify({ query, variables }),
    signal: AbortSignal.timeout(15000),
  });
  const j = await r.json();
  if (!r.ok || j.errors) die(`GitHub ${r.status}: ${(j.errors || []).map(e => e.message).join('; ') || j.message}`);
  return j.data;
}

async function project() {
  const d = await gql('org', `query($o:String!,$n:Int!){organization(login:$o){projectV2(number:$n){id
    field(name:"Status"){... on ProjectV2SingleSelectField{id options{id name color description}}}}}}`, { o: board.owner, n: board.number });
  const p = d.organization?.projectV2;
  if (!p) die(`quadro ${board.owner}#${board.number} não encontrado (o App tem Organization → Projects?)`);
  return p;
}

async function itemsOf(p) {
  const items = []; let after = null;
  do {
    const d = await gql('org', `query($id:ID!,$a:String){node(id:$id){... on ProjectV2{items(first:100,after:$a){pageInfo{hasNextPage endCursor}
      nodes{id updatedAt status:fieldValueByName(name:"Status"){... on ProjectV2ItemFieldSingleSelectValue{name optionId}}
      content{__typename ... on Issue{number title state} ... on PullRequest{number title state} ... on DraftIssue{title}}}}}}}`, { id: p.id, a: after });
    const page = d.node.items; items.push(...page.nodes); after = page.pageInfo.hasNextPage ? page.pageInfo.endCursor : null;
  } while (after);
  return items;
}
const same = (a, b) => stageName(a) === stageName(b);

async function list(column, titles, json) {
  const p = await project();
  const items = await itemsOf(p);
  if (json) {
    console.log(JSON.stringify(items.map((i) => ({ column: i.status?.name ?? null, number: i.content?.number ?? null, type: i.content?.__typename ?? null, updatedAt: i.updatedAt ?? null }))));
    return;
  }
  if (column) column = stageName(column);
  const cols = column ? p.field.options.filter(o => same(o.name, column)) : p.field.options;
  if (column && !cols.length) die(`coluna "${column}" não existe. Colunas: ${p.field.options.map(o => o.name).join(', ')}`, 2);
  const fmt = (i) => `${i.content?.__typename === 'PullRequest' ? 'PR' : ''}#${i.content?.number ?? '-'}${titles ? ' ' + (i.content?.title ?? '').slice(0, 50) : ''}`;
  for (const o of cols) {
    const here = items.filter(i => i.status?.name === o.name);
    if (!here.length && !column) continue;
    const compact = !column && same(o.name, STAGE.done);
    console.log(`${o.name} (${here.length})${compact ? '' : ': ' + here.map(fmt).join(titles ? ' ; ' : ' ')}`);
  }
}

async function move(args) {
  const quiet = args.includes('--quiet'); args = args.filter(x => x !== '--quiet');
  if (process.env.FSD_DRY) { console.log(`[dry] fsd-board move ${args.join(' ')}`); return; }
  let col, nums;
  if (args.length === 2 && /^\d+$/.test(args[0]) && !/^\d+$/.test(args[1])) { nums = [args[0]]; col = args[1]; }
  else { col = args[0]; nums = args.slice(1); }
  if (!col || !nums.length || nums.some(n => !/^\d+$/.test(n))) die('uso: fsd-board move "<coluna>" <n…>', 2);
  col = stageName(col);
  const p = await project();
  const opt = p.field.options.find(o => same(o.name, col));
  if (!opt) die(`coluna "${col}" não existe. Colunas: ${p.field.options.map(o => o.name).join(', ')}`, 2);
  const [owner, name] = board.repo.split('/'); const done = [];
  for (const num of nums) {
    const d = await gql('repo', `query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){issueOrPullRequest(number:$n){... on Issue{id} ... on PullRequest{id}}}}`, { o: owner, r: name, n: Number(num) });
    const c = d.repository?.issueOrPullRequest; if (!c?.id) die(`#${num} não existe em ${board.repo}`);
    const add = await gql('org', `mutation($p:ID!,$c:ID!){addProjectV2ItemById(input:{projectId:$p,contentId:$c}){item{id}}}`, { p: p.id, c: c.id });
    await gql('org', `mutation($p:ID!,$i:ID!,$f:ID!,$o:String!){updateProjectV2ItemFieldValue(input:{projectId:$p,itemId:$i,fieldId:$f,value:{singleSelectOptionId:$o}}){projectV2Item{id}}}`,
      { p: p.id, i: add.addProjectV2ItemById.item.id, f: p.field.id, o: opt.id });
    done.push('#' + num);
  }
  let told = '';
  const OWN = ownersOf(opt.name);
  if (OWN && !quiet) { try { told = execFileSync(join(HERE, 'fsd-notify'), [OWN.join(','), `${done.join(',')} → ${opt.name}`], { encoding: 'utf8' }).trim(); } catch {} }
  console.log(`${done.join(',')} → ${opt.name}${told && told !== 'ninguém recebeu' ? ' | avisados: ' + told : ''}`);
}

// Renomeia as opções do Status para os nomes de fsd-stages.mjs e cria as que faltam (logo depois da etapa anterior da tabela). As opções que
// já existem mantêm o id, então nenhum card sai da coluna; mesmo assim o estado de antes vai para $FSD_STATE/board-rename-<data>.json, e
// depois se confere opção por opção e card por card. Idempotente.
async function rename(args) {
  const dry = args.includes('--dry') || !!process.env.FSD_DRY;
  const p = await project();
  const plan = p.field.options.map(o => ({ ...o, to: stageName(o.name) }));
  const stages = Object.values(STAGE); const added = [];
  stages.forEach((name, k) => {
    if (plan.some(o => o.to === name)) return;
    const prev = plan.findIndex(o => o.to === stages[k - 1]);
    plan.splice(prev >= 0 ? prev + 1 : plan.length, 0, { id: null, name: null, color: 'GRAY', description: '', to: name }); added.push(name);
  });
  const changes = plan.filter(o => o.id && o.to !== o.name);
  for (const o of changes) console.log(`${dry ? '[dry] ' : ''}${o.name} → ${o.to}`);
  for (const n of added) console.log(`${dry ? '[dry] ' : ''}+ ${n} (coluna nova, depois de ${plan[plan.findIndex(o => o.to === n) - 1]?.to ?? 'nada'})`);
  if (!changes.length && !added.length) { console.log('colunas já com os nomes de fsd-stages.mjs'); return; }
  if (dry) return;
  const before = await itemsOf(p); const count = (items, opts) => Object.fromEntries(opts.map(o => [o.id, items.filter(i => i.status?.optionId === o.id).length]));
  const was = count(before, p.field.options);
  const dir = process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents'); mkdirSync(dir, { recursive: true });
  const file = join(dir, `board-rename-${new Date().toISOString().replace(/[:.]/g, '-')}.json`);
  writeFileSync(file, JSON.stringify({ options: p.field.options, items: before.map(i => ({ id: i.id, status: i.status, number: i.content?.number ?? null })) }, null, 1));
  await gql('org', `mutation($f:ID!,$o:[ProjectV2SingleSelectFieldOptionInput!]!){updateProjectV2Field(input:{fieldId:$f,singleSelectOptions:$o}){projectV2Field{... on ProjectV2SingleSelectField{id}}}}`,
    { f: p.field.id, o: plan.map(o => ({ ...(o.id ? { id: o.id } : {}), name: o.to, color: o.color, description: o.description ?? '' })) });
  const after = await project(); const now = await itemsOf(after);
  const kept = plan.filter(o => o.id).map(o => o.id).join(), keptNow = after.field.options.filter(o => o.id in was).map(o => o.id).join();
  const names = after.field.options.map(o => o.name).join(), wantNames = plan.map(o => o.to).join();
  const moved = count(now, after.field.options); const lost = Object.keys(was).filter(id => was[id] !== moved[id] && after.field.options.some(o => o.id === id));
  if (kept !== keptNow || names !== wantNames || lost.length || now.filter(i => !i.status).length !== before.filter(i => !i.status).length)
    die(`rename: conferência falhou (ids ${kept === keptNow ? 'iguais' : 'MUDARAM'}, nomes ${names === wantNames ? 'ok' : 'diferentes'}, colunas com contagem diferente: ${lost.length}). Estado anterior em ${file}`, 4);
  console.log(`${changes.length} coluna(s) renomeada(s), ${added.length} criada(s); ${now.length} cards conferidos, nenhum mudou de coluna (estado anterior em ${file})`);
}

const [cmd, ...rest] = process.argv.slice(2);
if (cmd === 'list') await list(rest.find(x => x !== '-t' && x !== '--json'), rest.includes('-t'), rest.includes('--json'));
else if (cmd === 'move') await move(rest);
else if (cmd === 'rename') await rename(rest);
else die('uso: fsd-board list [coluna] [-t] [--json] | fsd-board move "<coluna>" <n…> | fsd-board rename [--dry]', 2);
