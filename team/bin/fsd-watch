#!/usr/bin/env node
// fsd-watch [--fix] [--loop [segundos]] — vigia dos agentes, sem gastar token. Sem --fix só mostra o estado e o que faria.
// Respeita o PAUSE e não repete a mesma ação no mesmo agente dentro de cooldownMin. Log das ações:
// ~/.config/fsd-agents/watch.log (fora do git). Tempos: agents.json → timing.watch (fsd-timing.mjs).
//   sem sessão  → sobe o agente          estourou  → reinicia limpo        travado → reinicia
//   ocioso sem Monitor → empurrão curto (acima de restartAbove, reinicia)  permissão / limite de uso → só avisa o autor
//   pediu ao autor (parado, e o fim do painel pede uma ação a ele: redirects.json → authorAsks) → fsd-notify kevin + empurrão
//   "não espere o autor"; o mesmo pedido na tela não repete (nem dentro do cooldownMin, nem sob PAUSE).
//   limpeza (fsd-cleanup --loop): sem cleanup.pid ou com o pid morto, e sem PAUSE → sobe o laço destacado (com --fix; sem ele, "faria").
// Sinal de vida de quem está trabalhando (o mais recente vale):
//   1. gravação no transcript da sessão ou de um subagente;
//   2. contador de tokens do rodapé do painel ("↓ 4.1k tokens") diferente do da rodada anterior: o modelo está gerando;
//   3. ferramenta em andamento, registrada pelo hook fsd-context-guard em liveDir(agente).
// Travado = trabalhando e:
//   sem ferramenta em andamento, sem sinal há mais de silentMin;
//   Bash em andamento: só depois do timeout do próprio comando + toolGraceMin, e sem sinal há mais de silentMin;
//   outra ferramenta em andamento (Agent, WebFetch…): sem sinal há mais de toolDefaultMin.
import { readFileSync, readdirSync, statSync, existsSync, appendFileSync, writeFileSync, rmSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { tmpdir } from 'node:os';
import { fileURLToPath } from 'node:url';
import { spawnSync, spawn } from 'node:child_process';
import { context } from './fsd-context.mjs';
import { timing, liveDir } from './fsd-timing.mjs';
import { load as loadRedirects } from './fsd-redirects.mjs';

const BIN = dirname(fileURLToPath(import.meta.url)); const ROOT = dirname(BIN);
const REPO = process.env.FSD_REPO || dirname(ROOT); // o clone em que team/ mora
const LAUNCH = process.env.FSD_AGENT_BIN || join(process.env.HOME, '.local/bin/fsd-agent');
const cfg = JSON.parse(readFileSync(join(ROOT, 'agents.json'), 'utf8'));
const RESTART_ABOVE = (a) => context(a).restartAbove;
const T = timing().watch; const MIN = 60000;
const RD = loadRedirects(); const ASKS = (RD.authorAsks || []).map((p) => new RegExp(p, 'i')); const NO_ASK = RD.authorAsksSkip || [];
const AGENTS = ['kevin', 'mel', 'stuart', 'bob'].filter((a) => cfg.agents[a]);
const STATE = join(tmpdir(), 'fsd-watch-state.json');
const a = process.argv.slice(2); const FIX = a.includes('--fix');
const LOOP = a.includes('--loop') ? Number(a[a.indexOf('--loop') + 1]) || Number(T.loopSeconds) : 0;

// FSD_TMUX_SOCKET (teste num servidor tmux isolado): todo tmux daqui ganha -L <socket>; sem ele, o comportamento de sempre.
const sh = (cmd, args, o = {}) => spawnSync(cmd, cmd === 'tmux' && process.env.FSD_TMUX_SOCKET ? ['-L', process.env.FSD_TMUX_SOCKET, ...args] : args, { encoding: 'utf8', timeout: 60000, ...o });
const log = (m) => { const l = `${new Date().toISOString()} ${m}`; try { appendFileSync(join((process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents')), 'watch.log'), l + '\n'); } catch {} if (LOOP) console.log(l); };
const min = (ms) => Math.round(ms / 60000);
const k = (n) => `${Math.round(n / 1000)}k`;

function transcript(agent) {
  const base = join((process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents')), 'agents', agent, 'claude', 'projects'); let best = null;
  if (!existsSync(base)) return null;
  for (const p of readdirSync(base)) {
    const d = join(base, p); if (!statSync(d).isDirectory()) continue;
    for (const f of readdirSync(d)) if (f.endsWith('.jsonl')) { const m = statSync(join(d, f)).mtimeMs; if (!best || m > best.m) best = { f: join(d, f), m }; }
  }
  if (!best) return null;
  // Subagentes gravam em <sessão>/subagents/*.jsonl: também é sinal de vida da sessão.
  let last = best.m; const sub = join(best.f.replace(/\.jsonl$/, ''), 'subagents');
  if (existsSync(sub)) for (const f of readdirSync(sub)) if (f.endsWith('.jsonl')) last = Math.max(last, statSync(join(sub, f)).mtimeMs);
  let ctx = 0;
  for (const line of readFileSync(best.f, 'utf8').split('\n')) {
    if (!line.includes('"assistant"')) continue;
    let e; try { e = JSON.parse(line); } catch { continue; }
    const u = e.message?.usage; if (e.type !== 'assistant' || e.isSidechain || !u || e.message.model === '<synthetic>') continue;
    ctx = (u.input_tokens || 0) + (u.cache_read_input_tokens || 0) + (u.cache_creation_input_tokens || 0) + (u.output_tokens || 0);
  }
  return { idle: Date.now() - last, ctx };
}

// Ferramentas em andamento (hook fsd-context-guard): [{ tool, started, timeoutMs }].
function liveTools(agent) {
  const d = liveDir(agent), out = [];
  if (!existsSync(d)) return out;
  for (const f of readdirSync(d)) { try { out.push(JSON.parse(readFileSync(join(d, f), 'utf8'))); } catch {} }
  return out;
}
// Contador de tokens do rodapé: mudou desde a última rodada → o modelo está gerando. Devolve há quanto tempo está igual
// (Infinity sem contador na tela). mem = estado guardado entre rodadas.
function tokenIdle(agent, pane, mem) {
  const m = pane.match(/[↓↑]\s*([\d.,]+\s*[kKmM]?)\s*tokens/g); const tok = m ? m.join('|') : '';
  const key = `sig:${agent}`, prev = mem[key];
  if (!tok) { delete mem[key]; return Infinity; }
  if (!prev || prev.tok !== tok) mem[key] = { tok, at: Date.now() };
  return Date.now() - mem[key].at;
}

// O fim do painel pede uma ação ao autor? Devolve a linha (≤120 caracteres) ou ''. Entra o painel com as linhas quebradas pelo
// terminal juntas (capture-pane -J), sem cor. Avisos do time ("[fsd-aviso …]", inclusive o que o próprio vigia entrega) não são
// pedido do agente: ficam de fora, senão o aviso ao Kevin dispara o vigia no painel do Kevin.
function authorAsk(paneJ) {
  const lines = paneJ.replace(/\x1b\[[0-9;?]*[ -\/]*[@-~]/g, '').split('\n').map((l) => l.trim()).filter((l) => l && !l.includes('[fsd-aviso')).slice(-6);
  const joined = lines.join(' ');
  for (const re of ASKS) {
    const one = lines.find((l) => re.test(l)); if (one) return one.slice(0, 120);
    const m = joined.match(re); if (m) return joined.slice(Math.max(0, m.index - 40), m.index + 80).trim().slice(0, 120);
  }
  return '';
}

function classify(agent, mem = {}) {
  const s = `fsd-${agent}`;
  if (sh('tmux', ['has-session', '-t', s]).status !== 0) return { state: 'sem sessão', act: 'start' };
  const pane = (sh('tmux', ['capture-pane', '-p', '-t', s]).stdout || '').split('\n').filter((l) => l.trim()).slice(-14).join('\n');
  const t = transcript(agent) || { idle: 0, ctx: 0 };
  const base = { idle: t.idle, ctx: t.ctx };
  if (/Context limit reached|Prompt is too long/.test(pane)) return { ...base, state: 'estourou', act: 'restart' };
  if (/Do you want|❯ 1\. Yes/.test(pane)) return { ...base, state: 'permissão', act: 'alert' };
  if (/usage limit|hit your limit|limit will reset|resets? at/i.test(pane)) return { ...base, state: 'limite de uso', act: 'alert' };
  const working = /esc to interrupt/.test(pane), monitor = /\d+ monitors?\b/.test(pane);
  if (working) {
    const now = Date.now(), tools = liveTools(agent), quiet = Math.min(t.idle, tokenIdle(agent, pane, mem));
    const bash = tools.filter((x) => x.tool === 'Bash'), other = tools.filter((x) => x.tool !== 'Bash');
    const names = [...new Set(tools.map((x) => x.tool))].join(', '), w = { ...base, idle: quiet };
    // Bash dentro do próprio prazo: vivo, mesmo em silêncio (npm ci, testes).
    if (bash.some((x) => now < x.started + x.timeoutMs + T.toolGraceMin * MIN)) return { ...w, state: `trabalhando (${names})`, act: null };
    const allowed = (other.length ? T.toolDefaultMin : T.silentMin) * MIN;
    if (quiet > allowed) return { ...w, state: tools.length ? `travado (${names})` : 'travado', act: 'restart' };
    return { ...w, state: tools.length ? `trabalhando (${names})` : 'trabalhando', act: null };
  }
  delete mem[`sig:${agent}`];
  const ask = NO_ASK.includes(agent) ? '' : authorAsk(sh('tmux', ['capture-pane', '-p', '-J', '-t', s]).stdout || '');
  if (!ask) delete mem[`ask:${agent}`];   // o pedido saiu da tela: o mesmo texto, mais tarde, vale de novo
  if (ask && mem[`ask:${agent}`] !== ask) return { ...base, state: 'pediu ao autor', act: 'redirect', ask };
  if (monitor) return { ...base, state: 'esperando (Monitor)', act: null };
  if (t.idle > T.idleMin * MIN) return { ...base, state: 'ocioso sem Monitor', act: t.ctx > RESTART_ABOVE(agent) ? 'restart' : 'nudge' };
  return { ...base, state: 'acabou de responder', act: null };
}

function kick(agent, why) {
  const q = (sh(join(BIN, 'fsd-queue'), [agent], { env: { ...process.env, FSD_AGENT: agent } }).stdout || '').trim().split('\n').join(';').slice(0, 600);
  return `Sessão nova de ${agent} (contexto limpo; o vigia reiniciou: ${why}). Antes de tudo confira o seu worktree (git status, commits sem push) e retome de lá. A fila abaixo é o estado atual; não releia o GitHub. Siga o team.md; sem trabalho, avise o Kevin e arme o Monitor (fsd-wait). Fila: ${q}`;
}

// Única porta de teclas no painel de um agente (nudge e redirect). Olha o painel antes de digitar: shell → reinicia (nunca digita no
// shell); diálogo na tela → não digita; linha de entrada com texto → C-u antes; senão cola e dá Enter. `ok` é o que o ato devolve.
const SHELLS = ['bash', 'zsh', 'sh'];
const DIALOG = /❯ 1\.|Do you want|Press Enter to continue|\btrust\b/i;
const INPUT_TEXT = /^[│|]?\s*[>❯]\s+[^\s│|]/;   // "> texto" ou "│ > texto │" (as opções de diálogo "❯ 1." já saíram antes)
function safeSend(agent, msg, ok) {
  const s = `fsd-${agent}`;
  const cmd = (sh('tmux', ['display-message', '-p', '-t', s, '#{pane_current_command}']).stdout || '').trim();
  if (SHELLS.includes(cmd)) {
    const c = sh('tmux', ['respawn-pane', '-k', '-t', s, '-c', REPO, LAUNCH, agent, 'claude', kick(agent, `painel caiu no shell (${cmd})`)]);
    return c.status === 0 ? 'painel no shell: reiniciou, sem digitar' : `falhou: ${c.stderr.trim()}`;
  }
  const tail = (sh('tmux', ['capture-pane', '-p', '-t', s]).stdout || '').split('\n').filter((l) => l.trim()).slice(-14);
  if (tail.some((l) => DIALOG.test(l))) { log(`${agent}: dialog on screen, not typing`); return 'dialog on screen, not typing'; }
  const box = tail.slice(-4).find((l) => INPUT_TEXT.test(l.trim()));
  if (box) { sh('tmux', ['send-keys', '-t', s, 'C-u']); log(`${agent}: input line not empty, cleared with C-u before typing`); }
  sh('tmux', ['load-buffer', '-b', `w-${agent}`, '-'], { input: msg }); sh('tmux', ['paste-buffer', '-p', '-d', '-b', `w-${agent}`, '-t', s]);
  sh('sleep', ['0.4']); sh('tmux', ['send-keys', '-t', s, 'Enter']); return ok;
}

function act(agent, r) {
  const paused = existsSync(join((process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents')), 'PAUSE'));
  if (r.act === 'alert') { sh('notify-send', ['-u', 'critical', `fsd: ${agent}`, `${r.state}: precisa de você no tmux fsd-${agent}`]); return `avisou o autor (${r.state})`; }
  if (paused) return 'PAUSE: nada';
  const s = `fsd-${agent}`;
  if (r.act === 'start' || r.act === 'restart') { try { rmSync(liveDir(agent), { recursive: true, force: true }); } catch {} }   // registros da sessão morta
  if (r.act === 'start') { const c = sh('tmux', ['new-session', '-d', '-s', s, '-c', REPO, LAUNCH, agent, 'claude', kick(agent, 'sessão não existia')]); return c.status === 0 ? 'subiu' : `falhou: ${c.stderr.trim()}`; }
  if (r.act === 'restart') { const c = sh('tmux', ['respawn-pane', '-k', '-t', s, '-c', REPO, LAUNCH, agent, 'claude', kick(agent, `${r.state}, ${k(r.ctx)}`)]); return c.status === 0 ? 'reiniciou' : `falhou: ${c.stderr.trim()}`; }
  if (r.act === 'redirect') {
    sh(join(BIN, 'fsd-notify'), ['kevin', `${agent} pediu ao autor: ${r.ask}`]);
    const msg = '[fsd-aviso do vigia] Do not wait for the author. Take the team command for it (team.md, "Ação negada → comando do time") or move on and tell Kevin with fsd-notify.';
    return safeSend(agent, msg, 'avisou o Kevin e empurrou');
  }
  if (r.act === 'nudge') {
    const msg = `[fsd-aviso do vigia] Você está parado sem Monitor há ${min(r.idle)} min. Terminou uma entrega? fsd-restart. Sem trabalho: avise o Kevin e arme o Monitor (fsd-wait any).`;
    return safeSend(agent, msg, 'empurrou');
  }
  return '';
}

function round() {
  let st = {}; try { st = JSON.parse(readFileSync(STATE, 'utf8')); } catch {}
  const rows = [];
  for (const ag of AGENTS) {
    const r = classify(ag, st); let done = '-';
    if (r.act) {
      const key = `${ag}:${r.act}`, last = st[key] || 0;
      if (!FIX) done = `faria: ${r.act}`;
      else if (Date.now() - last < T.cooldownMin * MIN) done = `espera (${r.act} há ${min(Date.now() - last)} min)`;
      else { done = act(ag, r); st[key] = Date.now(); if (r.act === 'redirect' && !done.startsWith('PAUSE')) st[`ask:${ag}`] = r.ask; log(`${ag}: ${r.state}${r.ask ? ` (${r.ask})` : ''} → ${done}`); }
    }
    rows.push([ag[0].toUpperCase() + ag.slice(1), r.state, r.idle != null ? `${min(r.idle)} min` : '-', r.ctx ? k(r.ctx) : '-', done]);
  }
  try { writeFileSync(STATE, JSON.stringify(st)); } catch {}
  return rows;
}

// fsd-cleanup --loop tem de estar sempre de pé: $FSD_STATE/cleanup.pid ausente ou com pid morto (e sem PAUSE) → sobe de novo (--fix).
// Sem token: só confere o pid. O próprio fsd-cleanup recusa um segundo laço, então subir duas vezes não duplica.
function cleanupCheck() {
  const dir = process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents'); let pid = 0;
  try { pid = Number(readFileSync(join(dir, 'cleanup.pid'), 'utf8').trim()); } catch {}
  let up = false; if (Number.isInteger(pid) && pid > 0) { try { process.kill(pid, 0); up = true; } catch (e) { up = e.code === 'EPERM'; } }
  if (up) return `fsd-cleanup: no ar (pid ${pid})`;
  if (existsSync(join(dir, 'PAUSE'))) return 'fsd-cleanup: parado, PAUSE: nada';
  if (!FIX) return 'fsd-cleanup: parado, faria: subir o laço';
  const c = spawn(process.execPath, [join(BIN, 'fsd-cleanup'), '--loop'], { detached: true, stdio: 'ignore', env: process.env });
  c.on('error', () => {}); c.unref();
  log('fsd-cleanup: parado → subiu o laço (fsd-cleanup --loop)');
  return 'fsd-cleanup: parado → subiu o laço';
}

function table(rows) {
  const head = ['Agente', 'Estado', 'Sem sinal há', 'Contexto', 'Ação'];
  const w = head.map((h, i) => Math.max(h.length, ...rows.map((r) => r[i].length)));
  const line = (l, m, r) => l + w.map((n) => '─'.repeat(n + 2)).join(m) + r;
  const center = (s, n) => { const p = n - s.length; return ' '.repeat(Math.floor(p / 2)) + s + ' '.repeat(Math.ceil(p / 2)); };
  const out = [line('┌', '┬', '┐'), '│' + head.map((h, i) => ` ${center(h, w[i])} `).join('│') + '│'];
  rows.forEach((r) => { out.push(line('├', '┼', '┤')); out.push('│' + r.map((c, i) => ` ${c.padEnd(w[i])} `).join('│') + '│'); });
  out.push(line('└', '┴', '┘')); return out.join('\n');
}

if (!LOOP) { console.log(table(round())); console.log(cleanupCheck()); }
else { log(`vigia ligado (a cada ${LOOP}s${FIX ? ', com --fix' : ''})`); for (;;) { round(); cleanupCheck(); sh('sleep', [String(LOOP)]); } }
