#!/usr/bin/env node
// fsd-denied-hook — PermissionDenied (grava, só ele) e PreToolUse / PostToolUse (entrega o comando do time).
// Falha comum de comando (rede, exit 1) não é negação: PostToolUseFailure não grava. Negação sem linha na tabela grava o id genérico.
// Nunca bloqueia nem pergunta: qualquer erro sai 0 calado. O texto vem do redirects.json, não do comando negado.
import { readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
const git = (cwd, ...a) => { const r = spawnSync('git', ['-C', cwd, ...a], { encoding: 'utf8', timeout: 2000 }); return r.status === 0 ? r.stdout.trim() : ''; };
// Pasta principal = git-dir igual ao git-common-dir (mesma regra do fsd-redirect-hook); sem isso 'git checkout' na principal nunca casa.
const isMain = (cwd) => { const d = git(cwd, 'rev-parse', '--path-format=absolute', '--git-dir'); return !!d && d === git(cwd, 'rev-parse', '--path-format=absolute', '--git-common-dir'); };
try {
  const i = JSON.parse(readFileSync(0, 'utf8') || '{}');
  const ev = i.hook_event_name; const { record, consume, UNMATCHED } = await import('./fsd-denied.mjs');
  if (ev === 'PermissionDenied') {
    if (i.tool_name === 'Bash' && typeof i.tool_input?.command === 'string') {
      const { redirect } = await import('./fsd-redirects.mjs');
      const r = redirect(i.tool_input.command, { agent: process.env.FSD_AGENT || '', cwd: i.cwd, isMain });
      record({ session: i.session_id, toolUseId: i.tool_use_id, id: r ? r.id : UNMATCHED });
      // Sessão nova (FSD_RUNNER=session): o Kevin fica sabendo e a negação vai para denials.jsonl (T3.4.4). O time no tmux não muda.
      if (process.env.FSD_RUNNER === 'session') { const { route, apply } = await import('./fsd-route.mjs'); await apply(route({ type: 'denial', agent: process.env.FSD_AGENT || '', command: i.tool_input.command, reason: i.reason || (r ? r.id : null) }), { agent: process.env.FSD_AGENT || '' }); }
    }
  } else if (ev === 'PreToolUse' || ev === 'PostToolUse') {
    const id = consume({ session: i.session_id });
    if (id) {
      const { reasonOf } = await import('./fsd-redirects.mjs');
      const text = reasonOf(id, process.env.FSD_AGENT || '');
      if (text) process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: ev, additionalContext: text } }) + '\n');
    }
  }
} catch {}
process.exit(0);
