#!/usr/bin/env node
// Para o Monitor: fica quieto até algo NOVO acontecer, imprime uma linha e sai 0 (--now: dispara também com o que já existe).
// Falha de rede: tenta de novo (agents.json → timing.wait.retries vezes seguidas).
// fsd-wait any [--now]              o que importa para o seu papel (kevin: PR pronto parado; mel: PR para revisar ou card em
//                                   Ready for Architecture; stuart: revisão nos seus PRs ou card em Ready for Development; bob: PR para verificar)
// fsd-wait pr <n> merged|closed|approved|changes|new-head
// fsd-wait todo | mine | ready | column "<coluna>"  [--now]
// Esperando um colega: acrescente --waiting-for <agente> "<o quê>" [--pr <n> | --issue <n>] (registro em $FSD_STATE/waits/, apagado ao sair).
// Intervalo de cada caso (ready, todo, mine, column, pr): agents.json → timing.wait (FSD_WAIT_SECONDS passa por cima de todos).
// No "any", cada caso do papel confere no seu próprio ritmo.
process.env.FSD_THROW = '1';
const L = await import('./fsd-lib.mjs');
import { spawnSync } from 'node:child_process';
import { writeFileSync, renameSync, unlinkSync, readFileSync, mkdirSync } from 'node:fs';
import { join } from 'node:path';
// Flags: --now, --waiting-for <agente> "<o quê>" [--pr <n> | --issue <n>] (registra a espera em $FSD_STATE/waits/<eu>.json).
const usage = (m) => { console.log(`fsd-wait: ${m}`); process.exit(2); };
const args = []; const WF = {}; const raw = process.argv.slice(2); const NOW = raw.includes('--now');
for (let i = 0; i < raw.length; i++) {
  const a = raw[i];
  if (a === '--now') continue;
  if (a === '--waiting-for') { const ag = raw[i + 1]; const what = raw[i + 2]; if (!ag || what === undefined || ag.startsWith('--') || what.startsWith('--')) usage('--waiting-for needs <agent> "<what>"'); WF.for = ag; WF.what = what; i += 2; }
  else if (a === '--pr' || a === '--issue') { const v = raw[++i]; if (!/^\d+$/.test(v || '')) usage('--pr/--issue needs a number'); if (WF.ref) usage('use --pr or --issue, not both'); WF.ref = '#' + v; }
  else args.push(a);
}
if (WF.ref && !WF.for) usage('--pr/--issue only with --waiting-for');
if (WF.for) { if (!L.AGENTS.includes(WF.for)) usage(`unknown agent: ${WF.for}`); if (WF.for === L.ME) usage('cannot wait for yourself'); }
const { timing, waitSeconds } = await import('./fsd-timing.mjs');
const [kind, x, y] = args; const RETRIES = Number(timing().wait.retries);
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
// Registro da espera: grava por rename (ninguém lê meio arquivo) e apaga em qualquer saída (só se o pid for o nosso).
if (WF.for) {
  if (!L.AGENTS.includes(L.ME)) usage('--waiting-for: run inside an agent session (FSD_AGENT)');
  const dir = L.waitsDir(); const file = join(dir, `${L.ME}.json`);
  mkdirSync(dir, { recursive: true });
  const tmp = `${file}.${process.pid}.tmp`;
  writeFileSync(tmp, JSON.stringify({ for: WF.for, what: WF.what, ref: WF.ref ?? null, since: new Date().toISOString(), pid: process.pid }));
  renameSync(tmp, file);
  process.on('exit', () => { try { if (JSON.parse(readFileSync(file, 'utf8')).pid === process.pid) unlinkSync(file); } catch {} });
  for (const [sig, n] of [['SIGTERM', 15], ['SIGINT', 2], ['SIGHUP', 1]]) process.on(sig, () => process.exit(128 + n));
}
const me = L.meLogin(); const base = new Map();
// Detector de novidade: na primeira leitura guarda a linha de base (a não ser --now) e só dispara com itens novos.
function fresh(key, items, fmt) {
  if (!base.has(key)) { base.set(key, new Set(NOW ? [] : items)); if (!NOW) return ''; }
  const seen = base.get(key); const nw = items.filter((i) => !seen.has(i));
  return nw.length ? fmt(nw) : '';
}
const colItems = (c) => { const r = spawnSync(L.BIN + '/fsd-board', ['list', c], { encoding: 'utf8' }); if (r.status === 2 && /não configurado/.test(r.stderr)) return []; if (r.status !== 0) throw Object.assign(new Error(String(r.stderr || r.stdout).trim().split('\n')[0]), { code: r.status === 2 ? 2 : 4 }); const m = r.stdout.match(/\((\d+)\):\s*(.*)/); return m ? m[2].trim().split(/\s+/).filter(Boolean) : []; };
const W = {
  todo: () => fresh('todo', L.todo(me).map((p) => `#${p.number}@${p.headRefOid.slice(0, 7)}`), (n) => `revisar ${n.join(' ')}`),
  mine: () => { const items = L.openPrs().filter((p) => L.norm(p.author?.login) === me).map((p) => `#${p.number}:${(p.reviews || []).length}`); const nums = (l) => l.map((i) => i.split(':')[0]); const prev = base.has('mine') ? nums([...base.get('mine')]) : null; const f = fresh('mine', items, () => 'revisão nova: fsd-pr --mine'); if (f) return f; const gone = prev ? prev.filter((n) => !nums(items).includes(n)) : []; if (gone.length) { base.set('mine', new Set(items)); return `PR ${gone.join(' ')} mesclado/fechado: fsd-queue`; } return ''; },
  ready: () => fresh('ready', L.openPrs().filter((p) => L.readyIdle(p, false)).map((p) => '#' + p.number), (n) => `pronto parado: ${n.join(' ')} (fsd-merge --ready)`),
  column: (c) => (c = L.stageName(c), fresh('col:' + c, colItems(c), (n) => `${c}: ${n.join(' ')}`)),
};
// Casos de cada papel: [nome do caso em timing.wait, verificação].
const ANY = { kevin: [['ready', () => W.ready()], ['todo', () => W.todo()]], mel: [['todo', () => W.todo()], ['column', () => W.column(L.STAGE.archReady)]], stuart: [['mine', () => W.mine()], ['column', () => W.column(L.STAGE.devReady)]], bob: [['todo', () => W.todo()]] };
let first;
// Lista de [caso, verificação] do pedido: no "any", os casos do papel; senão, um só.
function checks() {
  if (kind === 'any') { const fs = ANY[L.ME]; if (!fs) L.die('fsd-wait any: rode dentro da sessão de um agente', 2); return fs; }
  if (kind === 'pr') return [['pr', prCheck]];
  if (kind === 'column') { if (!x) L.die('uso: fsd-wait column "<coluna>"', 2); return [['column', () => W.column(x)]]; }
  if (W[kind]) return [[kind, () => W[kind]()]];
  L.die('uso: fsd-wait any | pr <n> <condição> | todo | mine | ready | column "<coluna>"  [--now]', 2);
}
function prCheck() {
  if (!['merged', 'closed', 'approved', 'changes', 'new-head'].includes(y)) L.die('uso: fsd-wait pr <n> merged|closed|approved|changes|new-head', 2);
  const p = L.pr(x); const s = L.reviewState(p); if (first === undefined) first = p.headRefOid;
  if (y === 'merged' && p.state === 'MERGED') return `#${x} mesclado`;
  if (y === 'closed' && p.state !== 'OPEN') return `#${x} ${p.state}`;
  if (y === 'approved' && s.approvers.length >= 2 && !s.changes.length) return `#${x} com 2 aprovações: fsd-merge ${x}`;
  if (y === 'changes' && s.changes.length) return `#${x} mudanças pedidas por ${s.changes.join(',')}: fsd-review read ${x}`;
  if (y === 'new-head' && p.headRefOid !== first) return `#${x} commit novo ${p.headRefOid.slice(0, 7)}`;
  return '';
}
// Falhas contadas por caso: uma passada de outro caso não zera a contagem de quem falha sempre (nem o de intervalo mais lento).
const list = checks(); const due = list.map(() => 0); const bad = list.map(() => 0);
for (;;) {
  const now = Date.now();
  for (let i = 0; i < list.length; i++) {
    if (due[i] > now) continue;
    const [kase, f] = list[i]; due[i] = now + waitSeconds(kase) * 1000;
    try { const r = f(); bad[i] = 0; if (r) { console.log(r); process.exit(0); } }
    catch (e) { if (e.code === 2 || ++bad[i] >= RETRIES) { console.log(String(e.message)); process.exit(Number.isInteger(e.code) ? e.code : 4); } }
  }
  await sleep(Math.max(1000, Math.min(...due) - Date.now()));
}
