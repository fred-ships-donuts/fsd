#!/usr/bin/env bash
# fsd-restart — fim de tarefa: reinicia a sessão do agente com o contexto limpo.
# Roda como ÚLTIMA ação do turno, depois do registro no GitHub, das mensagens e do handoff.
# O tmux mata a sessão atual e abre uma nova (fsd-agent <nome> claude) com o prompt de retomada.
#   fsd-restart [--dry-run]
set -euo pipefail
name="${FSD_AGENT:?fsd-restart: rode dentro de uma sessão aberta pelo fsd-agent}"
pane="${TMUX_PANE:?fsd-restart: esta sessão não está num tmux}"
repo="${FSD_REPO:-$HOME/fred-ships-donuts}"
bin="${FSD_AGENT_BIN:-$HOME/.local/bin/fsd-agent}"
q=$(FSD_AGENT=$name "$(dirname "$0")/fsd-queue" "$name" 2>/dev/null | tr '\n' ';' | cut -c1-600)
kick="Sessão nova de $name (contexto limpo). A fila abaixo é o estado atual; não releia o GitHub. Siga o team.md e o handoff; rearme o Monitor (fsd-wait). Fila: $q"
cmd="$bin $name claude $(printf %q "$kick")"
# Termina na raiz: o handoff automático do ai-memory fica guardado pelo diretório em que a sessão acaba, e a sessão
# nova abre na raiz. Num worktree ele ficaria preso lá até expirar (aconteceu com o Stuart em 2026-11-09).
[ "$(pwd -P)" = "$(cd "$repo" && pwd -P)" ] || { echo "fsd-restart: rode da raiz do repositório: cd $repo && fsd-restart (num worktree o handoff do ai-memory não chega à sessão nova)"; exit 1; }
tmux display -p -t "$pane" >/dev/null 2>&1 || { echo "fsd-restart: painel $pane não existe"; exit 1; }
if [ "${1:-}" = --dry-run ] || [ -n "${FSD_DRY:-}" ]; then [ -e "$(dirname "$0")/../PAUSE" ] && echo "PAUSE ativo: encerraria $name sem reabrir" || echo "reiniciaria $name em $repo"; exit 0; fi
# Pausa do time: com o arquivo PAUSE, o fim de tarefa encerra a sessão em vez de reabrir.
if [ -e "$(dirname "$0")/../PAUSE" ]; then
  setsid -f bash -c "sleep 2; tmux kill-pane -t $(printf %q "$pane")" >/dev/null 2>&1 < /dev/null
  echo "fsd-restart: time em pausa (PAUSE). A sessão de $name encerra em 2s e não reabre."; exit 0
fi
# Só reinicia quando vale a pena: com contexto até restartAbove (60k) a sessão segue (reiniciar a cada entrega pequena
# custava uma orientação nova a cada 1–2 min). O contexto vem do transcript mais recente do perfil (o desta sessão).
above=$(node "$(dirname "$0")/fsd-context.mjs" "$name" restartAbove) || exit 2
ctx=$(node -e 'const fs=require("fs"),p=require("path");const b=p.join(process.env.CLAUDE_CONFIG_DIR||"","projects");let f=null,m=0;
  try{for(const d of fs.readdirSync(b))for(const x of fs.readdirSync(p.join(b,d)))if(x.endsWith(".jsonl")){const q=p.join(b,d,x),t=fs.statSync(q).mtimeMs;if(t>m){m=t;f=q}}}catch{}
  let c=0;if(f)for(const l of fs.readFileSync(f,"utf8").split("\n")){if(!l.includes("\"assistant\""))continue;let e;try{e=JSON.parse(l)}catch{continue}
  const u=e.message&&e.message.usage;if(e.type!=="assistant"||e.isSidechain||!u||e.message.model==="<synthetic>")continue;
  c=(u.input_tokens||0)+(u.cache_read_input_tokens||0)+(u.cache_creation_input_tokens||0)+(u.output_tokens||0)}console.log(c)' 2>/dev/null || echo 0)
if [ "${ctx:-0}" -gt 0 ] && [ "$ctx" -le "$above" ]; then
  echo "fsd-restart: contexto $((ctx/1000))k ≤ $((above/1000))k, não reinicio. Siga nesta sessão: fsd-queue; sem trabalho, avise o Kevin (fsd-notify kevin \"parado: …\") e arme o Monitor (fsd-wait any)."; exit 0
fi
setsid -f bash -c "sleep 2; tmux respawn-pane -k -t $(printf %q "$pane") -c $(printf %q "$repo") $(printf %q "$cmd")" >/dev/null 2>&1 < /dev/null
echo "fsd-restart: a sessão de $name reinicia em 2s, com o contexto limpo."
