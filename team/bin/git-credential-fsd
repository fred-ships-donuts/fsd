#!/usr/bin/env bash
# git credential helper: answers "get" for github.com with the $FSD_AGENT App token.
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
host=""; while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = host ] && host="$v"; done
[ "$host" = "github.com" ] && [ -n "${FSD_AGENT:-}" ] || exit 0
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
echo "username=x-access-token"
echo "password=$("$HERE/fsd-token" "$FSD_AGENT")"
