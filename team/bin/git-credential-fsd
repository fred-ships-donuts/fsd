#!/usr/bin/env bash
# git credential helper: answers "get" for github.com with the $FSD_AGENT App token.
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
host=""; while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = host ] && host="$v"; done
[ "$host" = "github.com" ] || exit 0
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# Sessão nova (F2.3, C1): o token do arquivo do papel, pelo usuário Unix; no time antigo, o do $FSD_AGENT.
if [ "${FSD_RUNNER:-}" = session ]; then tok=$("$HERE/fsd-token-file") || exit 0
else [ -n "${FSD_AGENT:-}" ] || exit 0; tok=$("$HERE/fsd-token" "$FSD_AGENT"); fi
echo "username=x-access-token"
echo "password=$tok"
