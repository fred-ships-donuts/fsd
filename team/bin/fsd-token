#!/usr/bin/env node
// fsd-token [agent] [org] — prints a valid GitHub App installation token for the agent
// ("org": the installation on the organization that owns the board, for fsd-board).
// (arg or $FSD_AGENT). Tokens last 1h; a cached one is reused until 10 min before expiry, and only if it was minted with
// the same body.
// Body (F1.6): repositories = [the repo of agents.json "repo"] and permissions = agents.json "tokens" (repo: per agent; org: shared).
// Sem linha na tabela → recusa (nunca um token com todas as permissões da instalação).
// Rede: FSD_GITHUB_API troca a URL (testes); a chamada desiste em FSD_TOKEN_TIMEOUT_MS (10 s). O cache vai por um .tmp de nome único.
import { randomBytes } from 'node:crypto';
import { readFileSync, writeFileSync, mkdirSync, renameSync, rmSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
const name = process.argv[2] || process.env.FSD_AGENT;
const cfg = JSON.parse(readFileSync(join(ROOT, 'agents.json'), 'utf8'));
const { agents } = cfg;
const agent = agents[name];
const scope = process.argv[3] === 'org' ? 'org' : 'repo';
if (!agent) { console.error(`fsd-token: agente desconhecido "${name ?? ''}" (use: ${Object.keys(agents).join(', ')})`); process.exit(2); }

const { requestBody, mint } = await import('./fsd-mint.mjs');
let reqBody; try { reqBody = requestBody(cfg, name, scope); } catch (e) { console.error(`fsd-token: ${e.message}`); process.exit(e.code); }

const STATE = process.env.FSD_STATE || join(process.env.HOME, '.config', 'fsd-agents');
const cacheDir = join(STATE, 'cache');
const instId = scope === 'org' ? agent.org_installation_id : agent.installation_id;
if (!instId) { console.error(`fsd-token: ${name} sem ${scope === 'org' ? 'org_installation_id' : 'installation_id'} no agents.json`); process.exit(2); }
const cacheFile = join(cacheDir, scope === 'org' ? `${name}-org.json` : `${name}.json`);
try {
  const c = JSON.parse(readFileSync(cacheFile, 'utf8'));
  if (c.body === reqBody && Date.parse(c.expires_at) - Date.now() > 10 * 60 * 1000) { process.stdout.write(c.token + '\n'); process.exit(0); }
} catch {}
let data;
try { data = await mint({ cfg, name, scope, keyFile: join(STATE, 'keys', `${agent.slug}.pem`) }); }
catch (e) { console.error(`fsd-token: ${e.message}`); process.exit(Number.isInteger(e.code) ? e.code : 1); }
mkdirSync(cacheDir, { recursive: true, mode: 0o700 });
const tmp = `${cacheFile}.${process.pid}.${randomBytes(4).toString('hex')}.tmp`;   // dois fsd-token juntos não se atropelam
try {
  writeFileSync(tmp, JSON.stringify({ token: data.token, expires_at: data.expires_at, body: reqBody }), { mode: 0o600 });
  renameSync(tmp, cacheFile);
} catch { rmSync(tmp, { force: true }); }   // sem cache, o token ainda serve
process.stdout.write(data.token + '\n');
