#!/usr/bin/env bash
# fsd-secrets pack|unpack|list — leva os segredos do ambiente fsd entre as máquinas, cifrados com age (senha).
#   pack    (na matriz)  empacota os segredos em ~/.config/fsd-agents/secrets.tar.age  (pede a senha 2x)
#   unpack  (na remota)  decifra e grava cada arquivo no mesmo caminho, modo 600       (pede a senha)
#   list                 mostra os caminhos que entram no pacote (sem conteúdo)
# O .tar.age vai para o git do fsd-agents; o conteúdo nunca sai da máquina em claro.
# Fora do pacote, refeitos com login em cada máquina: o gh (gh auth login) e o Claude (/login).
set -euo pipefail
ROOT="${FSD_STATE:-$HOME/.config/fsd-agents}"; OUT="$ROOT/secrets.tar.age"   # o cofre (estado), fora do repo público
AGE="$(command -v age || echo "$HOME/.local/bin/age")"
[ -x "$AGE" ] || { echo "age não encontrado (instale em ~/.local/bin)"; exit 2; }
# Caminhos relativos ao HOME. Não entra: config.toml.bak-* (cópia antiga), hook-spool/, db/, .credentials.json.
paths() {
  cd "$HOME"
  ls -1 .config/fsd-agents/keys/*.pem .config/fsd-agents/ai-memory-tokens/* 2>/dev/null
  for f in .config/fsd-agents/claude-oauth-token .config/fsd-agents/backup-age.key \
           .local/share/ai-memory/auth-token .local/share/ai-memory/auth-header \
           .local/share/ai-memory/auth-tokens/default .local/share/ai-memory/config.toml; do
    [ -e "$f" ] && echo "$f"
  done
}
case "${1:-}" in
  list) paths ;;
  pack)
    mapfile -t L < <(paths); [ ${#L[@]} -gt 0 ] || { echo "nada a empacotar"; exit 1; }
    echo "empacotando ${#L[@]} arquivos em $OUT"
    tar -C "$HOME" -czf - "${L[@]}" | "$AGE" -p -o "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    echo "ok. Commit: git -C $ROOT add secrets.tar.age && git -C $ROOT commit -m 'chore: segredos (age)'" ;;
  unpack)
    [ -f "$OUT" ] || { echo "falta $OUT (git pull no fsd-agents)"; exit 1; }
    [ -e "$HOME/.local/share/ai-memory/.serve.lock" ] && [ -s "$HOME/.local/share/ai-memory/.serve.lock.holder" ] \
      && echo "aviso: esta máquina parece rodar o servidor ai-memory; a remota NÃO deve rodar 'ai-memory serve'"
    umask 077
    "$AGE" -d "$OUT" | tar -C "$HOME" -xzf - --no-same-owner
    while read -r f; do chmod 600 "$HOME/$f"; done < <(paths)
    chmod 700 "$HOME/.config/fsd-agents/keys" "$HOME/.config/fsd-agents/ai-memory-tokens" "$HOME/.local/share/ai-memory/auth-tokens" 2>/dev/null || true
    echo "ok: segredos gravados no HOME (modo 600). Confira: $0 list" ;;
  *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
