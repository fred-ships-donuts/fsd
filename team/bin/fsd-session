#!/usr/bin/env node
// fsd-session status [--json] | start <papel> "<texto>" | turn <papel> "<texto>" | stop <papel> | retire <papel> | boot — a sessão --bg de cada
// papel (F3.2, T3.2.1). FSD_CLAUDE troca o claude (o stub-claude nos testes). As sessões sobem com FSD_RUNNER=session e
// FSD_AGENT=<papel>, na raiz do repositório. Saída: 0 ok · 1 recusado · 2 uso · 4 o claude falhou.
import { spawnSync } from 'node:child_process';
import { mkdtempSync, writeFileSync, chmodSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
const S = await import('./fsd-session.mjs'); const libRef = await import('./fsd-lib.mjs');
const { sessionState } = await import('./fsd-messenger.mjs');
const BIN = dirname(fileURLToPath(import.meta.url)), REPO = process.env.FSD_REPO || join(BIN, '..', '..');
const CLAUDE = process.env.FSD_CLAUDE || 'claude';
// No container (E2, FSD_SESSION_VIA=sudo): o supervisor fala com a sessão de cada papel só pelo wrapper (fsd-session.mjs → sx). As
// flags da sessão ficam no wrapper.
const VIA = S.via(), SX = S.sx;
function viaWrapper(argv, role) {
  if (argv[0] === 'stop') return SX(role, 'stop', argv[1]);
  const i = argv.indexOf('--resume');
  // Validação R39: no time nativo o arquivo do prompt fica na pasta de estado do papel (só ele e o supervisor leem, ACL); fora dele,
  // numa pasta temporária.
  const L = libRef; const base = L.stateRoot() ? L.roleStateDir(role) : tmpdir();
  const dir = mkdtempSync(join(base, '.prompt-')); chmodSync(dir, L.stateRoot() ? 0o770 : 0o711); const f = join(dir, 'prompt'); writeFileSync(f, argv[argv.length - 1], { mode: L.stateRoot() ? 0o660 : 0o644 });
  try { return i >= 0 ? SX(role, 'resume', argv[i + 1], f) : SX(role, 'start', f); } finally { rmSync(dir, { recursive: true, force: true }); }
}
const call = (argv, role) => (VIA ? viaWrapper(argv, role) : spawnSync(CLAUDE, argv, { cwd: REPO, encoding: 'utf8', env: { ...process.env, ...(role ? { FSD_AGENT: role, FSD_RUNNER: 'session', FSD_TEAM: join(BIN, '..') } : {}) } }));
const agents = () => S.liveAgents({ claude: CLAUDE, cwd: REPO });
const die = (m, c) => { console.log(m); process.exit(c); };
const [cmd, role, text] = process.argv.slice(2);
// D6: bypass só no ambiente isolado. No container o supervisor usa o wrapper (FSD_SESSION_VIA=sudo); chamar o claude direto, como o
// usuário atual, só nos testes (FSD_SESSION_ALLOW_UNISOLATED=1, com o stub-claude).
if (!VIA && ['start', 'turn', 'boot'].includes(cmd) && !process.env.FSD_SESSION_ALLOW_UNISOLATED)
  die('fsd-session: sem isolamento (FSD_SESSION_VIA=sudo no container): a sessão do papel roda em bypass e só sobe isolada (D6)', 1);
const stored = S.loadStored();
const st = () => S.status({ agents: agents(), stored, hookState: sessionState });
// O --bg imprime o id curto; o sessionId inteiro vem do `claude agents --json`. A conversa anterior fica em lastSessionId.
// Validação R24: a conversa gravada sumiu (o claude diz "No conversation found with session ID"): devolve 'missing' para o chamador
// abrir uma sessão nova, em vez de falhar para sempre a cada --resume.
const MISSING = /No conversation found/i;
function run(steps, r) {
  for (const s of steps) {
    const out = call(s.argv, r);
    if (out.status !== 0 && s.argv.includes('--resume') && MISSING.test(`${out.stderr}\n${out.stdout}`)) return 'missing';
    if (out.status !== 0) die(`fsd-session: claude ${s.argv[0]} falhou (${(out.stderr || out.stdout || '').trim().split('\n')[0].slice(0, 160)})`, 4);
    if (s.sessionId !== '$OUT') continue;
    // Validação R25: o --bg volta antes do `agents` listar a sessão; lê de novo por até ~5 s. Sem ela, para a cópia que subiu (senão
    // fica ligada sem ninguém saber) e falha.
    const id = S.bgId(`${out.stdout}\n${out.stderr}`); let live = null;
    for (let i = 0; id && i < 10; i++) { live = agents().find((a) => a.id === id); if (live?.sessionId) break; Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Number(process.env.FSD_SESSION_POLL_MS || 500)); }
    if (id && !live?.sessionId) S.stopSession(r, id, { claude: CLAUDE });
    if (!live?.sessionId) die(`fsd-session: o claude não disse o id da sessão de ${r} (${(out.stdout || out.stderr || '').trim().split('\n')[0].slice(0, 120)})`, 4);
    stored[r] = { ...(stored[r] || {}), sessionId: live.sessionId, ...(s.from ? { lastSessionId: s.from } : {}) };
  }
  stored[r] = { ...(stored[r] || {}), active: true }; S.saveStored(stored);
}
if (cmd === 'status') { const s = st(); console.log(process.argv.includes('--json') ? JSON.stringify(s) : Object.entries(s).map(([r, x]) => `${r}: ${x.state}${x.sessionId ? ` (${x.sessionId.slice(0, 8)})` : ''}`).join('\n')); }
else if ((cmd === 'start' || cmd === 'turn') && S.ROLES.includes(role) && text) {
  const { NEW_DAY_NOTE } = await import('./fsd-eod.mjs');
  const fresh = !stored[role]?.sessionId && stored[role]?.retiredAt;   // dia novo depois de um fim do dia: ler a passagem primeiro
  const p = S.planTurn(role, fresh ? `${NEW_DAY_NOTE}\n\n${text}` : text, { st: st()[role], stored }); if (p.refused) die(`fsd-session: ${p.refused}`, 1);
  if (run(p.steps, role) === 'missing') {
    console.log(`fsd-session: a conversa ${String(stored[role]?.sessionId).slice(0, 8)} de ${role} sumiu; abrindo uma sessão nova`);
    stored[role] = { ...(stored[role] || {}), lastSessionId: stored[role]?.sessionId || null }; delete stored[role].sessionId;
    run(S.planStart(role, `${NEW_DAY_NOTE}\n\n${text}`, { stored }), role);
  } console.log(`fsd-session: ${role} com turno novo na conversa ${stored[role].sessionId.slice(0, 8)}`);
} else if (cmd === 'stop' && S.ROLES.includes(role)) { for (const s of S.planStop(role, { st: st()[role] })) call(s.argv, role); stored[role] = { ...(stored[role] || {}), active: false }; S.saveStored(stored); console.log(`fsd-session: ${role} parado`); }
else if (cmd === 'retire' && S.ROLES.includes(role)) {   // fim do dia (T3.4.2): para e esquece a conversa; a próxima tarefa abre outra
  for (const s of S.planStop(role, { st: st()[role] })) call(s.argv, role);
  stored[role] = { active: false, retiredAt: new Date().toISOString(), lastSessionId: stored[role]?.sessionId || null }; S.saveStored(stored);
  console.log(`fsd-session: ${role} aposentado (fim do dia); a próxima tarefa abre uma sessão nova`);
}
else if (cmd === 'boot') { const b = S.planBoot({ stored, st: st() }); for (const x of b) if (run(x.steps, x.role) === 'missing') { stored[x.role] = { active: false, lastSessionId: stored[x.role]?.sessionId || null }; S.saveStored(stored); } console.log(`fsd-session: boot religou ${b.map((x) => x.role).join(', ') || 'ninguém'}`); }
else die('uso: fsd-session status [--json] | start|turn <papel> "<texto>" | stop|retire <papel> | boot', 2);
