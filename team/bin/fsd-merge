#!/usr/bin/env node
// fsd-merge <n> [--check]   mescla o PR #n na develop seguindo as regras do time (2 aprovações atuais de outras pessoas,
//                           sem mudança pedida, não draft, base develop, sem conflito, CI da regressão verde). Merge commit
//                           (--merge), sem apagar a branch, travado no commit conferido. Depois move os issues para Done e avisa o autor do PR.
// fsd-merge --ready [--check] [--now]  mescla os PRs de agentes prontos e parados há 10 min (o que fsd-pr --ready mostra); PR do autor só por número
// Saída: 0 ok · 1 regra · 3 ainda calculando · 4 GitHub recusou/rede.
// Testes: FSD_MERGE_FIXTURE=<arquivo JSON do PR> (só com FSD_DRY=1) usa o PR do arquivo no lugar do gh.
import { readFileSync } from 'node:fs';
import * as L from './fsd-lib.mjs';
import { followDevelop } from './fsd-follow.mjs';
const [n, mode] = process.argv.slice(2);
const FIXTURE = process.env.FSD_MERGE_FIXTURE;
if (FIXTURE && !L.DRY) L.die('fsd-merge: FSD_MERGE_FIXTURE só vale com FSD_DRY=1', 2);
const getPr = (num) => (FIXTURE ? JSON.parse(readFileSync(FIXTURE, 'utf8')) : L.pr(num));
function one(num, check) {
  let p;
  for (let t = 0; t < 6; t++) { p = getPr(num); if (FIXTURE || p.state !== 'OPEN' || p.mergeable !== 'UNKNOWN') break; L.run('sleep', ['2']); }
  const g = L.mergeGate(p);
  if (g.fail.length) return [1, `#${num} não pode entrar: ${g.fail.join('; ')}`];
  if (g.calculating) return [3, `#${num} merge ainda calculando; tente de novo`];
  if (check) return [0, `#${num} pronto para merge (${g.approvers.join(',')})`];
  if (FIXTURE) return [0, `[dry] #${num} seria mesclado na develop (${g.approvers.join(',')})`];
  const r = L.write(L.BIN + '/gh', ['pr', 'merge', String(num), '--merge', '--match-head-commit', p.headRefOid], { allowFail: true });
  if (!r.ok) { if (L.pr(num).state === 'MERGED') return [0, `#${num} já mesclado`]; return [4, `#${num} merge recusado: ${r.err.slice(0, 200)}`]; }
  const cl = L.closes(p.body);
  // O checkout principal acompanha a develop logo após o merge (#173); sem fetch/ff possível, o fsd-cleanup repete na próxima rodada.
  let fol = ''; if (!process.env.FSD_DRY) { L.run('git', ['-C', L.REPO_DIR, 'fetch', '-q', 'origin', 'develop'], { allowFail: true }); const f = followDevelop(L.REPO_DIR); fol = f.moved ? f.msg : ''; }
  return [0, [`#${num} mesclado na develop`, L.boardPr(p, { state: 'MERGED' }), fol, L.noticeSummary(L.notify([L.agentOf(p.author?.login)], `PR #${num} mesclado na develop.`))].filter(Boolean).join(' | ')];
}
if (n === '--ready') { const chk = process.argv.includes('--check'); const all = L.openPrs(); const ps = all.filter((p) => L.readyIdle(p)); const human = all.filter((p) => L.ready(p) && !L.AGENTS.includes(L.agentOf(p.author?.login))).length; if (!ps.length) L.die(`nada pronto parado${human ? ` (+${human} do autor: fsd-merge <n>)` : ''}`, 0); let worst = 0; for (const p of ps) { const [c, m] = one(p.number, chk); console.log(m); worst = Math.max(worst, c); if (c === 4) { console.log('parei: merge recusado'); break; } } if (human) console.log(`(+${human} do autor: só por número)`); process.exit(worst); }
if (mode && !['--check', '--now'].includes(mode)) L.die('uso: fsd-merge <n> [--check] | fsd-merge --ready [--check]', 2);
if (!/^\d+$/.test(n || '')) L.die('uso: fsd-merge <n> [--check] | fsd-merge --ready', 2);
const [code, msg] = one(n, mode === '--check'); L.die(msg, code);
