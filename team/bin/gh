#!/usr/bin/env bash
# gh wrapper for agent sessions: injects a fresh token for $FSD_AGENT on every call.
# "gh project …" uses the App's installation on the organization that owns the board;
# everything else uses the installation on the repository.
set -euo pipefail
# Sessão nova (F2.3, C1): o token vem do arquivo do papel, escolhido pelo usuário Unix; o FSD_AGENT não muda a identidade.
if [ "${FSD_RUNNER:-}" = session ]; then SESSION=1; else SESSION=; fi
[ -n "$SESSION" ] || [ -n "${FSD_AGENT:-}" ] || { echo "gh (fsd): FSD_AGENT não definido — abra a sessão com fsd-agent <nome>" >&2; exit 2; }
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REAL_GH="${FSD_REAL_GH:-/usr/bin/gh}"
export GH_REPO="${GH_REPO:-${FSD_REPO_SLUG:-fred-ships-donuts/fsd}}" GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1 GH_SPINNER_DISABLED=1 NO_COLOR=1 GH_PAGER=cat
scope=()
[ "${1:-}" = project ] && scope=(org)
if [ -n "$SESSION" ]; then tok="$("$HERE/fsd-token-file" "${scope[@]}")" || exit $?; else tok="$("$HERE/fsd-token" "$FSD_AGENT" "${scope[@]}")" || exit $?; fi
GH_TOKEN="$tok" exec "$REAL_GH" "$@"
