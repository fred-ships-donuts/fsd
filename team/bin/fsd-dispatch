#!/usr/bin/env node
// fsd-dispatch round [--dry] | loop | pin | status — o supervisor de sessões e mensageiro do time nativo (F3.2, T3.2.2). 0 token.
//   round   uma rodada: junta o estado (sessões, quadro, PRs, caixas, leases, PAUSE, cota), decide() e executa
//           (--dry: só imprime as ações). FSD_DISPATCH_FIXTURE=<json do estado> troca a coleta (testes).
//   loop    rodadas a cada dispatch.loopSeconds, com pid file (um só). Só roda da cópia fixada (fsd-dispatch pin), nunca do
//           checkout vivo: um PR mesclado não muda o supervisor sem fixar a cópia nova. FSD_DISPATCH_LIVE=1 libera (testes).
//   pin     copia o código do commit atual para $FSD_STATE/dispatch/code/<sha>/team e marca como a cópia em uso
// Ações: turn → cartão salvo + fsd-session turn; inbox/hold → caixa do destino; merge → fsd-merge (como Kevin, até o broker da E2);
// judge → fsd-judge (como Kevin). Saída: 0 ok · 1 recusado · 2 uso.
import { readFileSync, existsSync } from 'node:fs';
import { spawnSync, spawn } from 'node:child_process';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';
const BIN = dirname(fileURLToPath(import.meta.url)), TEAM = join(BIN, '..');
const D = await import('./fsd-dispatch-loop.mjs');
const L = await import('./fsd-lib.mjs');
const Msg = await import('./fsd-messenger.mjs'); const { CONTRACT_OF } = await import('./fsd-task.mjs');
// Validação R44: a tarefa com entrega válida (gravada na pasta do papel depois do início) não vence nem volta.
const cfg = { ...(L.CFG.dispatch || {}), delivered: (role, t) => Msg.hasDelivery({ contract: CONTRACT_OF[t.kind] || t.kind, n: t.n, at: t.at }, role) };
// Aviso do supervisor ao Kevin: direto na caixa dele (o outbox é dos papéis; um arquivo do fsd-dispatch lá seria recusado, A4).
const tellKevin = (text) => { if (!DRY) L.inboxAppend('kevin', 'supervisor', text); };
const now = () => L.clock();
const [cmd, ...rest] = process.argv.slice(2); const DRY = rest.includes('--dry') || L.DRY;

async function gather() {
  if (process.env.FSD_DISPATCH_FIXTURE) return JSON.parse(readFileSync(process.env.FSD_DISPATCH_FIXTURE, 'utf8'));
  const S = await import('./fsd-session.mjs'); const M = await import('./fsd-messenger.mjs'); const Le = await import('./fsd-lease.mjs');
  const U = await import('./fsd-usage.mjs'); const { stageName, STAGE } = await import('./fsd-stages.mjs');
  // Validação R1/R2: as sessões vêm pelo wrapper de cada papel (como o fsd-session) e o estado do hook, da pasta do papel.
  const live = S.liveAgents(), stored = S.loadStored();
  // Validação R25: cópia ligada de um papel que não é a conversa gravada (o --bg subiu e o fsd-session não gravou) é parada.
  for (const a of live) {
    if (a.kind !== 'background' || !S.ROLES.includes(a.name) || !stored[a.name]?.sessionId || a.sessionId === stored[a.name].sessionId) continue;
    if (!DRY) S.stopSession(a.name, a.id); console.log(`fsd-dispatch: cópia órfã de ${a.name} (${a.id}) ${DRY ? 'seria parada' : 'parada'}`);
  }
  const sessions = S.status({ agents: live.filter((a) => !(S.ROLES.includes(a.name) && stored[a.name]?.sessionId && a.sessionId !== stored[a.name].sessionId)), stored, hookState: M.sessionState });
  // Validação R12: o StopFailure (rate limit) de uma sessão de papel pede a pausa na pasta dele; o supervisor a aplica no PAUSE do time.
  for (const r of S.ROLES) {
    const req = join(L.roleStateDir(r), 'PAUSE.request'); if (!existsSync(req) || DRY) continue;
    try { U.stopFailure(); } catch (e) { console.log(`fsd-dispatch: pausa pedida por ${r} falhou: ${e.message}`); continue; }
    (await import('node:fs')).rmSync(req, { force: true }); console.log(`fsd-dispatch: ${r} bateu no limite da conta: PAUSE do time`);
  }
  const key = Object.fromEntries(Object.entries(STAGE).map(([k, v]) => [v, k]));
  let board = []; try { board = JSON.parse(spawnSync(join(BIN, 'fsd-board'), ['list', '--json'], { encoding: 'utf8' }).stdout || '[]'); } catch {}
  const blocked = new Set((L.ghJson(['issue', 'list', '--label', 'blocked', '--state', 'open', '--json', 'number']) || []).map((i) => i.number));
  const prs = L.openPrs(); const roleOf = (login) => L.agentOf(login);
  const cards = board.filter((b) => b.type !== 'PullRequest').map((b) => {
    const column = key[stageName(b.column)] || null; const pr = prs.find((p) => L.closes(p.body).includes(b.number));
    const st = pr ? L.reviewState(pr) : null;
    const reviewedBy = pr ? [...st.last].filter(([, r]) => r.commit?.oid === pr.headRefOid && r.state !== 'DISMISSED').map(([w]) => roleOf(w)) : [];
    return { n: b.number, column, blocked: blocked.has(b.number), ...(pr ? { pr: pr.number, head: pr.headRefOid, reviewedBy } : {}) };
  }).filter((c) => c.column);
  const { messages, rejected } = M.collect();
  for (const r of rejected) console.log(`mensagem recusada (${r.from || '?'}): ${r.errors.join('; ')}`);
  // Validação R28: o resultado do juiz. Respondeu (exit 0): o ref fica julgado e o Kevin recebe o que fazer (o comentário do caminho do
  // autor, que ele posta); falhou ou passou do prazo: o Kevin é avisado e o ref volta ao juiz depois de 30 min.
  { const fs = await import('node:fs'); const { timing } = await import('./fsd-timing.mjs'); const jd = join(D.dispatchDir(), 'judge');
    const judging = D.loadJudging(); let changed = false; const limit = 2 * Number(timing().judge.timeoutMin || 30) * 60000;
    for (const [ref, j] of Object.entries(judging)) {
      const n = ref.replace(/^#/, ''), done = join(jd, `${n}.done`), outF = join(jd, `${n}.out`);
      if (j.state === 'failed') { if (now() - j.at > 30 * 60000) { delete judging[ref]; changed = true; } continue; }
      if (!fs.existsSync(done)) { if (now() - j.at > limit) { judging[ref] = { at: now(), state: 'failed' }; changed = true; tellKevin(`[urgente] ${ref}: o juiz não terminou no prazo.`); } continue; }
      const code = Number(fs.readFileSync(done, 'utf8').trim()); let out = ''; try { out = fs.readFileSync(outF, 'utf8').trim(); } catch {}
      if (code === 0) {
        if (!DRY) D.saveJudged([...new Set([...D.loadJudged(), ref])]); delete judging[ref];
        if (/^fsd-judge: author decision needed/m.test(out)) tellKevin(`[urgente] ${ref}: o juiz pede a decisão do autor. Poste em ${ref} o comentário abaixo.\n${out.slice(out.indexOf('**Deadlock')) || out}`.slice(0, 4000));
        else tellKevin(`${ref}: o juiz decidiu e comentou no ${ref}; as partes foram avisadas.`);
      } else { judging[ref] = { at: now(), state: 'failed' }; tellKevin(`[urgente] ${ref}: o juiz falhou (exit ${code}): ${out.split('\n')[0].slice(0, 200)}`); }
      if (!DRY) { fs.rmSync(done, { force: true }); fs.rmSync(outF, { force: true }); } changed = true;
    }
    if (changed && !DRY) D.saveJudging(judging); }
  const { deadlocks, stalled } = Le.impasses(Le.list(now()), { now: now(), activityOf: L.activityOf });
  // Validação R43: PR parado sem ciclo vai ao Kevin uma vez por chave; a chave que sumiu sai da lista (se voltar, avisa de novo).
  const seen = D.loadStalled(), keep = {};
  for (const x of stalled) { keep[x.key] = seen[x.key] || now(); if (!seen[x.key]) tellKevin(`${x.line} (parado; ninguém em ciclo)`); }
  if (!DRY) D.saveStalled(keep);
  // No nativo, o uso vem da statusline dos papéis (o mais recente entre as pastas deles); no tmux, do cache do fsd-usage.
  let budgetOk = true; try { budgetOk = !U.over(U.teamCache(), U.usageConfig().stopPct); } catch {}
  // Fim do dia: contexto de cada sessão ligada (transcript <sessionId>.jsonl) e a marca de fechamento já pedido (eod.json).
  const E = await import('./fsd-eod.mjs'); const eod = D.loadEod(); const projects = join(process.env.CLAUDE_CONFIG_DIR || join(process.env.HOME, '.claude'), 'projects');
  const { readdirSync } = await import('node:fs');
  for (const [r, s] of Object.entries(sessions)) {
    // Validação R27: o fechamento é do papel, não de uma conversa (cada turno é uma cópia com id novo).
    if (eod[r]) { if (eod[r].gaveUp) s.eodHold = true; else s.eod = true; }
    if (s.state === 'off' || !s.sessionId) continue;
    // Validação R11: o hook do papel grava o contexto no fim do turno, na pasta dele; o transcript na home do papel o supervisor não lê.
    const hs = M.sessionState(r); if (hs?.session_id === s.sessionId && Number(hs.ctx) > 0) { s.ctx = Number(hs.ctx); continue; }
    try { for (const d of readdirSync(projects)) { const f = join(projects, d, `${s.sessionId}.jsonl`); if (existsSync(f)) { s.ctx = E.ctxOf(f); break; } } } catch {}
  }
  return { sessions, cards, messages, deadlocks, paused: existsSync(L.pausePath()), budgetOk, endOfDayAt: Number(cfg.endOfDayAt) || Number(L.CFG.claude_common?.context?.restartAbove) || 0 };
}

async function exec(a, g) {
  if (DRY) { console.log(`[dry] ${JSON.stringify(a)}`); return 'dry'; }
  const M = await import('./fsd-messenger.mjs');
  const msgs = (ids) => (g.messages || []).filter((m) => (ids || []).includes(m.id));
  if (a.type === 'inbox') { for (const m of msgs(a.ids)) M.deliver(m); return `${a.ids.length} na caixa de ${a.to}`; }
  // Validação R5: o hold não entrega. A mensagem fica no outbox, e o decide() a leva no próximo turno do destino; entregue aqui, ela saía
  // do outbox e nunca mais acordava ninguém.
  if (a.type === 'hold') return `${a.ids.length} esperando ${a.to} (${a.why})`;
  if (a.type === 'turn') {
    // Validação R23: as mensagens vão no texto do turno e só saem do outbox depois que o turno abriu; o cartão de antes volta se a
    // chamada falhar (preflight, claude fora), e a tarefa volta no laço (round).
    const T = await import('./fsd-task.mjs'); const mine = msgs(a.ids);
    let issue = null, snap = null;
    if (a.task) {
      issue = L.issue(a.task.n); const n = T.acceptanceOf(issue.body).length; snap = T.snapshot(a.to);
      T.saveCard(a.to, T.taskCard({ task: a.task, issue }), { kind: a.task.kind, n: a.task.n, acceptance: n || null });
    }
    const prompt = T.turnPrompt({ action: a, issue, messages: mine });
    const r = spawnSync(join(BIN, 'fsd-session'), ['turn', a.to, prompt], { encoding: 'utf8', env: process.env });
    if (r.status !== 0) { if (snap) T.restore(a.to, snap); throw new Error((r.stdout || r.stderr).trim().split('\n')[0]); }
    for (const m of mine) M.consume(m);
    return r.stdout.trim();
  }
  if (a.type === 'endofday') {
    const E = await import('./fsd-eod.mjs'); const S = await import('./fsd-session.mjs');
    // Validação R26: o turno do fechamento não cobra a entrega da tarefa (a marca sai no retire).
    const ef = Msg.eodFile(a.to); (await import('node:fs')).mkdirSync(dirname(ef), { recursive: true }); (await import('node:fs')).writeFileSync(ef, `${new Date(now()).toISOString()}\n`);
    const r = spawnSync(join(BIN, 'fsd-session'), ['turn', a.to, E.EOD_PROMPT], { encoding: 'utf8', env: process.env });
    if (r.status !== 0) { (await import('node:fs')).rmSync(ef, { force: true }); throw new Error((r.stdout || r.stderr).trim().split('\n')[0]); }
    D.saveEod({ ...D.loadEod(), [a.to]: { sessionId: S.loadStored()[a.to]?.sessionId || null, at: now(), asks: (D.loadEod()[a.to]?.asks || 0) + 1 } });
    return 'fim do dia pedido';
  }
  if (a.type === 'retire') {
    const E = await import('./fsd-eod.mjs'); const S = await import('./fsd-session.mjs');
    // Validação R11: os worktrees ficam na home do papel; só ele confere o que está só no disco (verbo unsaved do wrapper).
    let left; if (S.via()) { try { left = JSON.parse(S.sx(a.to, 'unsaved').stdout); } catch { left = [{ branch: '?', unreadable: true }]; } }
    else left = E.unsaved(a.to, { repo: process.env.FSD_REPO || join(TEAM, '..') });
    if (left.length) {   // algo só no disco: não aposenta; pede de novo (até 3 vezes) e avisa o Kevin
      const e = D.loadEod()[a.to] || {}; const list = left.map((x) => `${x.branch} (${x.unreadable ? 'sem acesso para conferir' : `${x.dirty ? `${x.dirty} mudança(s) sem commit` : ''}${x.dirty && x.ahead ? ', ' : ''}${x.ahead ? `${x.ahead} commit(s) sem push` : ''}`})`).join('; ');
      if ((e.asks || 0) < 3) { const r = spawnSync(join(BIN, 'fsd-session'), ['turn', a.to, `${E.EOD_PROMPT}\n\nAinda só no disco: ${list}.`], { encoding: 'utf8', env: process.env }); D.saveEod({ ...D.loadEod(), [a.to]: { ...e, asks: (e.asks || 0) + 1 } }); return `não aposentado: ${list}${r.status ? ' (pedido falhou)' : ''}`; }
      // Validação R27: avisa o Kevin uma vez e solta o papel (eodHold): ele segue com o trabalho em vez de ficar preso no fechamento.
      if (!e.gaveUp) { tellKevin(`${a.to} não consegue fechar o dia: ${list}`); D.saveEod({ ...D.loadEod(), [a.to]: { ...e, gaveUp: true } }); }
      return `não aposentado: ${list}`;
    }
    const r = spawnSync(join(BIN, 'fsd-session'), ['retire', a.to], { encoding: 'utf8', env: process.env });
    if (r.status !== 0) throw new Error(r.stdout.trim());
    const e = D.loadEod(); delete e[a.to]; D.saveEod(e); const t = D.loadTasks(); delete t[a.to]; D.saveTasks(t);   // a tarefa volta para a sessão nova
    (await import('node:fs')).rmSync(Msg.eodFile(a.to), { force: true });
    return 'aposentado';
  }
  if (a.type === 'merge') { const r = spawnSync(join(BIN, 'fsd-merge'), [String(a.n)], { encoding: 'utf8', env: { ...process.env, FSD_AGENT: 'kevin' } }); if (![0, 1, 3].includes(r.status)) throw new Error(r.stdout.trim()); return r.stdout.trim(); }
  if (a.type === 'judge') {
    // Validação R28: o juiz roda como o Kevin (no container, pelo verbo judge do wrapper), com os leases do ref num arquivo que ele lê;
    // a saída e o exit vão para dispatch/judge/<n>.out|.done, que o gather das próximas rodadas lê (a saída não some mais no /dev/null).
    const fs = await import('node:fs'); const { tmpdir } = await import('node:os'); const S = await import('./fsd-session.mjs'); const Le = await import('./fsd-lease.mjs');
    const n = String(a.ref).replace(/^#/, ''); const jd = join(D.dispatchDir(), 'judge'); fs.mkdirSync(jd, { recursive: true });
    const out = join(jd, `${n}.out`), done = join(jd, `${n}.done`); fs.rmSync(out, { force: true }); fs.rmSync(done, { force: true });
    const tmp = fs.mkdtempSync(join(tmpdir(), 'fsd-judge-')); fs.chmodSync(tmp, 0o711); const wf = join(tmp, 'waits.json');
    fs.writeFileSync(wf, JSON.stringify(Le.list(now()).filter((l) => l.ref === a.ref))); fs.chmodSync(wf, 0o644);
    const cmd = S.via() ? ['sudo', '-n', '-u', 'fsd-kevin', '/usr/local/sbin/fsd-session-exec', 'judge', n, wf] : [join(BIN, 'fsd-judge'), n];
    spawn('sh', ['-c', '"$@" > "$JOUT" 2>&1; echo $? > "$JDONE"; rm -rf "$JTMP"', 'sh', ...cmd], { detached: true, stdio: 'ignore',
      env: { ...process.env, FSD_AGENT: 'kevin', FSD_JUDGE_WAITS_FILE: wf, JOUT: out, JDONE: done, JTMP: tmp } }).unref();
    return 'juiz chamado';
  }
  throw new Error(`ação desconhecida: ${a.type}`);
}

const fsMod = await import('node:fs');
// Validação R30: a decisão do autor nos issues com aguardando-autor (fsd-admit, 0 token) a cada dispatch.admitEveryMin (padrão 5).
function admit() {
  if (DRY || process.env.FSD_DISPATCH_FIXTURE) return;
  const f = join(D.dispatchDir(), 'admit.at'); let last = 0; try { last = Number(readFileSync(f, 'utf8')) || 0; } catch {}
  if (now() - last < Number(cfg.admitEveryMin ?? 5) * 60000) return;
  const r = spawnSync(join(BIN, 'fsd-admit'), [], { encoding: 'utf8', env: process.env, timeout: 120000 });
  try { fsMod.writeFileSync(f, String(now())); } catch {}
  const out = `${r.stdout || ''}${r.stderr || ''}`.trim(); if (out && !/nada a fazer/.test(out)) console.log(`fsd-dispatch: fsd-admit: ${out.split('\n').join(' | ').slice(0, 300)}`);
}
if (cmd === 'round') {
  const r = await D.round({ gather, exec, now: now(), cfg }); admit();
  console.log(`fsd-dispatch: ${r.actions.length} ação(ões), ${r.done.length} feita(s)${r.skipped.length ? `, ${r.skipped.length} falharam` : ''}`);
} else if (cmd === 'pin') {
  const repo = process.env.FSD_REPO || join(TEAM, '..');
  const sha = process.env.FSD_PIN_SHA || spawnSync('git', ['-C', repo, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).stdout.trim();   // FSD_PIN_SHA: o sha da cópia do root (fsd-native-setup)
  const dst = D.pinCode(sha, TEAM); console.log(`fsd-dispatch: cópia fixada ${sha.slice(0, 7)} em ${dst}\nrode: ${join(dst, 'bin', 'fsd-dispatch')} loop`);
} else if (cmd === 'loop') {
  if (!D.runningPinned(process.argv[1]) && !process.env.FSD_DISPATCH_LIVE) L.die(`fsd-dispatch: o laço só roda da cópia fixada (fsd-dispatch pin; em uso: ${D.currentPin()?.path || 'nenhuma'}), não do checkout vivo`, 1);
  const { takePidFile, freePidFile } = await import('./fsd-pid.mjs');
  const pid = join(D.dispatchDir(), 'dispatch.pid'); (await import('node:fs')).mkdirSync(D.dispatchDir(), { recursive: true });
  const t = takePidFile(pid); if (!t.ok) L.die(t.pid ? `fsd-dispatch: já rodando (pid ${t.pid})` : 'fsd-dispatch: não consegui o pid file', 0);
  process.on('exit', () => freePidFile(pid)); for (const [s, n] of [['SIGTERM', 15], ['SIGINT', 2], ['SIGHUP', 1]]) process.on(s, () => process.exit(128 + n));
  const lost = D.reconcile(now()); if (lost.length) console.log(`fsd-dispatch: ${lost.length} ação(ões) do laço anterior ficaram sem fim (abandoned)`);
  // Validação R32: depois de um reinício do container, os papéis ativos voltam pela conversa gravada antes da primeira rodada.
  if (!DRY && !process.env.FSD_DISPATCH_FIXTURE) { const b = spawnSync(join(BIN, 'fsd-session'), ['boot'], { encoding: 'utf8', env: process.env }); console.log((b.stdout || b.stderr || '').trim().split('\n')[0] || 'fsd-session boot: sem saída'); }
  const rounds = Number(process.env.FSD_DISPATCH_ROUNDS) || Infinity;   // testes: um número fixo de rodadas
  for (let i = 0; i < rounds; i++) { try { await D.round({ gather, exec, now: now(), cfg }); admit(); } catch (e) { console.log(`fsd-dispatch: rodada falhou: ${String(e.message).split('\n')[0]}`); } if (i + 1 < rounds) await new Promise((r) => setTimeout(r, Number(cfg.loopSeconds || 60) * 1000)); }
} else if (cmd === 'status') {
  const tasks = D.loadTasks(); console.log(JSON.stringify({ pin: D.currentPin(), tasks, judged: D.loadJudged(), judging: D.loadJudging() }, null, 1));
} else L.die('uso: fsd-dispatch round [--dry] | loop | pin | status', 2);
